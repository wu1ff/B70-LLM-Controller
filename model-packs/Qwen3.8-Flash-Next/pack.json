          "TRANSFORMERS_OFFLINE": "1",
          "TRITON_CACHE_DIR": "/work/triton-cache",
          "VLLM_XPU_DFLASH_FIXED_SPLITS": "32",
          "PYTHONPATH": "/opt/phase4-tests:/tests:/opt/phase3-tests:/opt/phase2-tests",
          "B70_PLE_DISK_BF16": "1",
          "CCL_SYCL_ALLREDUCE_TMP_BUF": "1",
          "VLLM_CACHE_ROOT": "/work/vllm-cache",
          "VLLM_TARGET_DEVICE": "xpu",
          "XDG_CACHE_HOME": "/work/xdg-cache",
          "HF_DATASETS_OFFLINE": "1",
          "VLLM_USE_V2_MODEL_RUNNER": "1",
          "ZE_AFFINITY_MASK": "0,1,2,3",
          "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
          "TMPDIR": "/work/tmp",
          "LD_PRELOAD": "/opt/b70-residency-shim/libl0_peer_residency_shim.so",
          "PLE_TABLE_PATH": "/models/model-00016-of-00017.safetensors",
          "ZE_FLAT_DEVICE_HIERARCHY": "FLAT",
          "HF_HUB_OFFLINE": "1"
        },
        "command": [
          "vllm",
          "serve",
          "--host",
          "0.0.0.0",
          "--port",
          "8000",
          "--dtype",
          "bfloat16",
          "--enable-expert-parallel",
          "--max-num-seqs",
          "4",
          "--max-num-batched-tokens",
          "1024",
          "--gpu-memory-utilization",
          "0.91",
          "--limit-mm-per-prompt",
          "{\"image\":2,\"video\":0}",
          "--trust-remote-code",
          "--enable-prefix-caching",
          "--enable-auto-tool-choice",
          "--tool-call-parser",
          "qwen3_xml",
          "--reasoning-parser",
          "qwen3",
          "--exclude-tools-when-tool-choice-none",
          "--enforce-eager",
          "--num-gpu-blocks-override",
          "7785"
        ]
      }
    }

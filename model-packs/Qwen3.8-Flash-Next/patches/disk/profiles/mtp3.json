{
  "image": "qwen38-flashnext:disk",
  "docker_options": [
    "--pull",
    "never",
    "--device=/dev/dri:/dev/dri",
    "--ipc=host",
    "--shm-size=32g",
    "--security-opt",
    "seccomp=unconfined",
    "--security-opt",
    "label=disable"
  ],
  "mounts": [
    "type=bind,source=/dev/dri/by-path,target=/dev/dri/by-path,readonly",
    "type=bind,source={model_dir},target=/models/devan-carlin__Qwen3.8-Flash-Next-W4A16,readonly"
  ],
  "env": {
    "CCL_SYCL_ALLGATHERV_TMP_BUF": "1",
    "CCL_SYCL_ALLREDUCE_TMP_BUF": "1",
    "HF_DATASETS_OFFLINE": "1",
    "HF_HOME": "/work/hf-cache",
    "HF_HUB_OFFLINE": "1",
    "LD_PRELOAD": "/opt/b70-residency-shim/libl0_peer_residency_shim.so",
    "PLE_TABLE_PATH": "/models/devan-carlin__Qwen3.8-Flash-Next-W4A16/ple_table_qwen4exp.pt",
    "TMPDIR": "/work/tmp",
    "TRANSFORMERS_OFFLINE": "1",
    "TRITON_CACHE_DIR": "/work/triton-cache",
    "VLLM_CACHE_ROOT": "/work/vllm-cache",
    "VLLM_TARGET_DEVICE": "xpu",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "VLLM_XPU_ENABLE_XPU_GRAPH": "1",
    "XDG_CACHE_HOME": "/work/xdg-cache",
    "ZE_AFFINITY_MASK": "0,1,2,3",
    "ZE_FLAT_DEVICE_HIERARCHY": "FLAT",
    "B70_PLE_DISK_BF16": "1",
    "B70_MTP_SKIP_PREFILL_TAIL": "1",
    "B70_PLE_MTP_PREFILL_1024": "1",
    "B70_MTP_DRAFT_PREFILL_EAGER": "1",
    "B70_MTP_PREFILL_KV_ONLY": "1",
    "B70_XPU_POST_CAPTURE_WARMUP": "1",
    "B70_XPU_SPEC_SPLIT_PLAN": "1",
    "B70_XPU_SPEC_META_FUSED": "1",
    "B70_XPU_TILED_REDUCER": "1",
    "CCL_SYCL_ALLREDUCE_LL_THRESHOLD": "65536"
  },
  "command": [
    "vllm",
    "serve",
    "/models/devan-carlin__Qwen3.8-Flash-Next-W4A16",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--dtype",
    "bfloat16",
    "--enable-expert-parallel",
    "--trust-remote-code",
    "--max-num-batched-tokens",
    "1024",
    "--max-num-seqs",
    "4",
    "--limit-mm-per-prompt",
    "{\"image\":2,\"video\":0}",
    "--compilation-config",
    "{\"cudagraph_mode\": \"FULL_AND_PIECEWISE\", \"cudagraph_capture_sizes\": [1, 2, 4, 8, 64, 128, 256, 512, 832, 1024]}",
    "--cudagraph-metrics",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_xml",
    "--reasoning-parser",
    "qwen3",
    "--served-model-name",
    "devan-carlin/Qwen3.8-Flash-Next-W4A16",
    "--gpu-memory-utilization",
    "0.91",
    "--tensor-parallel-size",
    "4",
    "--max-model-len",
    "262144",
    "--exclude-tools-when-tool-choice-none",
    "--speculative-config",
    "{\"method\": \"mtp\", \"num_speculative_tokens\": 3, \"use_local_argmax_reduction\": true}"
  ],
  "authority": "runtime/rr-mtp3-gpu-tuning-20261010T235751Z/launches/tiled-active/command.json",
  "packaging_changes": [
    "omit diagnostic VLLM_SERVER_DEV_MODE",
    "omit research mount /astra",
    "omit research mount /study",
    "omit research mount /gpu-study",
    "parameterize host model path, container name and publication endpoint"
  ]
}

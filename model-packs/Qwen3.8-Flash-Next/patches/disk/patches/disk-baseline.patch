+                except BaseException:
+                    self._failed = True
+                    _disk_bf16_quarantine.append(self)
+                    raise
+            self._closed = True
+        finally:
+            self._lock.release()
+
+    def __del__(self):
+        try:
+            self.close()
+        except BaseException:
+            _disk_bf16_quarantine.append(self)

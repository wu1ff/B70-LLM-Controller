+    def prefill_prompt_kv(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+    ) -> None:
+        """Populate one-layer draft KV without producing unused prompt logits.
+
+        The caller supplies the same shifted ids, target HC states, positions
+        and forward-context slot mappings as ordinary draft prefill. Attention
+        output, output projection, MoE and final mixing have no persistent state
+        needed by a later chunk. Only wholly non-final prefill may use this.
+        """
+        model = self.model
+        layer = model.layers[0]
+        attention = layer.self_attn
+        num_tokens = hidden_states.shape[0]
+        embeddings = model.embed_input_ids(input_ids)
+        embeddings = model.pre_fc_norm_embedding(embeddings)
+        embeddings = model.fc_embedding(embeddings)
+        hidden_states = hidden_states.view(
+            num_tokens, model.hc_count, model.hidden_size
+        )
+        hidden_states = model.pre_fc_norm_hidden(
+            hidden_states.flatten(-2)
+        ).view(num_tokens, model.hc_count, model.hidden_size)
+        hidden_states = model.fc_hidden(hidden_states).flatten(-2)
+        _, block_input, _ = layer.attn_hyper_connection.combine_and_mix(
+            hidden_states, embeddings, None
+        )
+        qkv, _ = attention.qkv_proj(block_input)
+        _, key, value, _ = attention._project_qkv_gate(qkv, positions)
+        cache_layer = attention.attn
+        key = key.view(-1, cache_layer.num_kv_heads, cache_layer.head_size)
+        value = value.view(-1, cache_layer.num_kv_heads, cache_layer.head_size_v)
+        unified_kv_cache_update(key, value, cache_layer.layer_name)

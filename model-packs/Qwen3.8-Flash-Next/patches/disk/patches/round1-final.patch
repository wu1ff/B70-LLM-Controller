+    def supports_prompt_kv_only(self) -> bool:
+        """Whether intermediate draft prefill has only attention KV state."""
+        model = self.model
+        if len(model.layers) != 1:
+            return False
+        layer = model.layers[0]
+        if layer.ple is not None or layer.layer_type != "full_attention":
+            return False
+        attention = layer.self_attn

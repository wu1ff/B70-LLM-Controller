+                b.spec_state_indices_tensor.data_ptr(),
+                b.spec_sequence_masks.data_ptr(),
+                b.spec_token_indx.data_ptr(),
+                b.spec_query_start_loc.data_ptr(),
+                b.num_accepted_tokens.data_ptr(),
+            ]
+            for b, bt in zip(builders, tables)

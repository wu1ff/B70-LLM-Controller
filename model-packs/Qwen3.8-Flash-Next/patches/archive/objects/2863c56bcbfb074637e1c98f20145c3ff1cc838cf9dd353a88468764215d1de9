+"""Exact fused metadata expansion for XPU uniform speculative attention."""
+import torch
+import triton
+import triton.language as tl
+
+@triton.jit
+def _expand(Cu, Used, BT, CuOut, Dummy, UsedOut, BTOut, Splits, Work,
+            TOTAL:tl.constexpr, QLEN:tl.constexpr, COLS:tl.constexpr,
+            STRIDE0:tl.constexpr, STRIDE1:tl.constexpr, USED_STRIDE:tl.constexpr,
+            BLOCK:tl.constexpr, ADAPTIVE:tl.constexpr):
+    x=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK)
+    row=x//COLS;col=x%COLS
+    b=tl.load(BT+(row//QLEN)*STRIDE0+col*STRIDE1,x<TOTAL*COLS,other=0)
+    tl.store(BTOut+x,b,x<TOTAL*COLS)
+    tl.store(CuOut+x,x,x<TOTAL+1)
+    tl.store(Dummy+x,0,x<TOTAL+1)
+    n=tl.load(Used+(x//QLEN)*USED_STRIDE,x<TOTAL,other=1)
+    causal_length = tl.maximum(1,n-(QLEN-1-x%QLEN))
+    tl.store(UsedOut+x,causal_length,x<TOTAL)
+    if ADAPTIVE:
+        # The native reducer trusts explicit plans to include the FMHA
+        # single-split rule. 832-token pages dispatch 64-token tiles;
+        # ceil(length/64) < 32 means length <= 1984. Apply per query,
+        # including a causal window straddling this boundary.
+        splits = tl.where(causal_length<=1984,1,
+                          tl.where(causal_length<=16384,32,64))
+        tl.store(Splits+x,splits,x<TOTAL)
+        # Native compact-grid mode applies single-split normalization before
+        # the BF16 store. Fixed-size zero-work entries keep graphs dynamic
+        # without a host length readback; the kernel skips count==0 entries.
+        item=x//4
+        seq=item//64
+        split=item%64
+        raw=tl.load(Used+(seq//QLEN)*USED_STRIDE,item<TOTAL*64,other=1)
+        length=tl.maximum(1,raw-(QLEN-1-seq%QLEN))
+        count_splits=tl.where(length<=1984,1,tl.where(length<=16384,32,64))
+        tiles=tl.cdiv(length,64)
+        per=tl.cdiv(tiles,count_splits)
+        start=split*per
+        count=tl.where(split<count_splits,tl.maximum(0,tl.minimum(per,tiles-start)),0)
+        value=tl.where(x%4==0,seq,tl.where(x%4==1,start,tl.where(x%4==2,count,split)))
+        tl.store(Work+x,value,x<TOTAL*64*4)
+
+def expand(cu,used,bt,total,qlen,adaptive=False):
+    cols=bt.shape[1]
+    a=torch.empty((total+1,),dtype=torch.int32,device=bt.device)
+    b=torch.empty_like(a)
+    c=torch.empty((total,),dtype=torch.int32,device=bt.device)
+    d=torch.empty((total,cols),dtype=bt.dtype,device=bt.device)
+    splits=torch.empty_like(c) if adaptive else None
+    work=torch.empty((total*64,4),dtype=torch.int32,device=bt.device) if adaptive else None
+    _expand[(triton.cdiv(max(total*cols,total+1,total*64*4 if adaptive else 0),256),)](
+        cu,used,bt,a,b,c,d,splits,work,total,qlen,cols,bt.stride(0),bt.stride(1),used.stride(0),256,adaptive)
+    return (a,b,c,d,splits,work) if adaptive else (a,b,c,d)

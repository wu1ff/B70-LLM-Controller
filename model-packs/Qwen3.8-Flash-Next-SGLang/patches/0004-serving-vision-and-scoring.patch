diff --git a/python/sglang/srt/speculative/parallel_spawn.py b/python/sglang/srt/speculative/parallel_spawn.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a09c6c7c078d9e8d3456e4d645995c93b36e951
--- /dev/null
+++ b/python/sglang/srt/speculative/parallel_spawn.py
@@ -0,0 +1,80 @@
+"""A0040: start spawned scheduler processes without serializing their imports.
+
+CPython's spawn Popen writes the pickled process object into the child's pipe
+inside Process.start(). When the payload exceeds the pipe capacity the parent
+blocks until the child has consumed it, which happens only after the child has
+imported the target module (about 11 s for the SGLang scheduler). With four TP
+ranks the launches therefore ran one after another. This launcher performs the
+identical spawn and hands the already pickled payload to a writer thread. The
+payload, executable, file descriptors and child command line are unchanged.
+"""
+import contextlib
+import io
+import logging
+import os
+import threading
+from multiprocessing import popen_spawn_posix, reduction, spawn, util
+from multiprocessing.context import set_spawning_popen
+
+logger = logging.getLogger(__name__)
+_writers = []
+
+
+def _launch(self, process_obj):
+    from multiprocessing import resource_tracker
+    tracker_fd = resource_tracker.getfd()
+    self._fds.append(tracker_fd)
+    prep_data = spawn.get_preparation_data(process_obj._name)
+    fp = io.BytesIO()
+    set_spawning_popen(self)
+    try:
+        reduction.dump(prep_data, fp)
+        reduction.dump(process_obj, fp)
+    finally:
+        set_spawning_popen(None)
+
+    parent_r = child_w = child_r = parent_w = None
+    try:
+        parent_r, child_w = os.pipe()
+        child_r, parent_w = os.pipe()
+        cmd = spawn.get_command_line(tracker_fd=tracker_fd, pipe_handle=child_r)
+        self._fds.extend([child_r, child_w])
+        self.pid = util.spawnv_passfds(spawn.get_executable(), cmd, self._fds)
+        self.sentinel = parent_r
+        payload = bytes(fp.getbuffer())
+        writer_fd, parent_w = parent_w, None
+
+        def write():
+            # The thread owns and closes the write end once the child has
+            # read the complete payload (or exited).
+            with open(writer_fd, "wb", closefd=True) as f:
+                f.write(payload)
+
+        thread = threading.Thread(target=write, name=f"spawn-writer-{self.pid}", daemon=True)
+        thread.start()
+        _writers.append(thread)
+        logger.info("A0040 spawned pid %d with %d-byte payload on a writer thread", self.pid, len(payload))
+    finally:
+        fds_to_close = [fd for fd in (parent_r, parent_w) if fd is not None]
+        self.finalizer = util.Finalize(self, util.close_fds, fds_to_close)
+        for fd in (child_r, child_w):
+            if fd is not None:
+                os.close(fd)
+
+
+@contextlib.contextmanager
+def parallel_spawn(enabled):
+    if not enabled:

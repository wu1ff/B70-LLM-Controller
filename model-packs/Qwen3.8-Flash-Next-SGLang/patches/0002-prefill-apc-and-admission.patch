+++ b/python/sglang/srt/speculative/bucket_hc.py
@@ -0,0 +1,87 @@
+"""Replay the parent's short HC equations on shared row-bucket rails with the layer's own weights."""
+from weakref import WeakKeyDictionary
+import torch
+
+from sglang.srt.speculative.short_regions import norm_ops
+
+_banks = {}
+
+
+def supported(module,x):
+    return (x.is_xpu and x.dtype == torch.bfloat16 and x.shape[1:] == (10240,)
+            and 16 <= len(x) <= 256 and hasattr(module,"_v6_down")
+            and module.hc_count == 4 and module.hidden_size == 2560 and module.hc_norm.group_size == 2560
+            and module.input_mix_weight_up.weight.shape == (10240,320) and not torch.xpu.is_current_stream_capturing())
+
+
+class Bank:
+    def __init__(self,width,device):
+        self.stream = torch.xpu.current_stream(device)
+        self.pool = torch.xpu.graph_pool_handle()
+        self.entries = WeakKeyDictionary()
+        with torch.inference_mode(False):
+            self.x = torch.zeros((width,10240),device=device,dtype=torch.bfloat16)
+            self.n = torch.empty_like(self.x)
+            self.mixed = self.x.new_zeros((width,2560))
+            self.block = torch.empty_like(self.mixed)
+            self.updated = torch.empty_like(self.x)
+        self.owner = None
+
+    def capture(self,module):
+        def mix():
+            n, = norm_ops(self.x,module.hc_norm.weight,module.hc_norm.variance_epsilon)
+            self.n.copy_(n)
+            self.mixed.copy_(module._mix_compute(self.n,module.input_mix_weight_down.weight,
+                                                 module.input_mix_weight_up.weight,4,2560))
+        def inject():
+            self.updated.copy_(module._combine_compute(self.block,self.x,self.n,
+                                                       module.block_inject_weight.weight,4,2560))
+        mix(); self.block.zero_(); inject()
+        read,write = torch.xpu.XPUGraph(),torch.xpu.XPUGraph()
+        with torch.xpu.graph(read,pool=self.pool):
+            mix()
+        with torch.xpu.graph(write,pool=self.pool):
+            inject()
+        return read,write
+
+    def mix(self,module,x):
+        from sglang.srt.speculative.budget import can_admit
+        n=len(x)
+        if module not in self.entries:
+            self.entries[module] = self.capture(module) if can_admit(x.device,("short-hc-mix",len(self.x),len(self.entries))) else None
+        entry = self.entries[module]
+        if entry is None:
+            return None
+        self.x[:n].copy_(x)
+        entry[0].replay()
+        norm = self.n[:n].clone()
+        self.owner = (module,x,norm)
+        return self.mixed[:n].clone(),(x,norm,None)
+
+    def combine(self,module,block,prior):
+        if self.owner is None or not all(a is b for a,b in zip(self.owner,(module,prior[0],prior[1]))):
+            return None
+        self.block[:len(block)].copy_(block)
+        self.entries[module][1].replay()
+        self.owner = None
+        return self.updated[:len(block)].clone()
+
+
+def width(rows):
+    return 64 if rows<=64 else 128 if rows<=128 else 256
+
+
+@torch.inference_mode()
+def mix(module,x):
+    key=(x.device,width(len(x)))
+    if key not in _banks:
+        from sglang.srt.speculative.budget import can_admit
+        _banks[key] = Bank(key[1],x.device) if can_admit(x.device,("short-hc-rails",key[1])) else None
+    bank = _banks[key]
+    return bank.mix(module,x) if bank and bank.stream==torch.xpu.current_stream(x.device) else None
+
+
+@torch.inference_mode()
+def combine(module,block,prior):
+    bank = _banks.get((block.device,width(len(block))))
+    return bank.combine(module,block,prior) if bank and bank.stream==torch.xpu.current_stream(block.device) else None

index 0000000000000000000000000000000000000000..6b08de111b2aa10a130bb6d560a3279085f6d254
--- /dev/null
+++ b/python/sglang/srt/speculative/b70_prefill.py
@@ -0,0 +1,367 @@
+"""Bridge the accepted v6 Xe2 operators to Flash Next's SGLang state pools."""
+from collections import defaultdict
+from dataclasses import dataclass
+from functools import cache, lru_cache
+from itertools import accumulate, zip_longest
+import logging
+import hashlib
+import os
+from pathlib import Path
+
+import torch
+
+from sglang.srt.utils.device import async_h2d
+
+LIBDIR = Path("/opt/venv/lib/python3.12/site-packages/vllm_xpu_kernels")
+ISOLATED_PHASE_VIEWS = os.getenv("SGLANG_FLASHNEXT_PREFILL_GDN_VIEWS") == "1"
+NATIVE_CHECKPOINTS = os.getenv("SGLANG_FLASHNEXT_PREFILL_GDN_EXPORT") == "1"
+HASHES = {
+    "gdn_index64": "101e6a2555449dc92d94b9acc4b79c9581e458f95c4866ce7446bb03518ffa87",
+    "long_prefill_v3": "fe7ba008bd1251ffc1cd6bac7bc08b93fb76b61ec78bed1b66a737300f20c55f",
+    "long_hc": "959439265e485be1434b038b2050aab775c7d421646bc77806415552749499c5",
+}
+
+
+@cache
+def load(name):
+    path = LIBDIR / f"lib{name}.so"
+    if hashlib.sha256(path.read_bytes()).hexdigest() != HASHES[name]:
+        raise RuntimeError(f"Unexpected B70 library {path}")
+    torch.ops.load_library(str(path))
+    logging.getLogger(__name__).info("B70 admitted native library %s on XPU %d", name, torch.xpu.current_device())
+
+
+@lru_cache(maxsize=64)
+def segment_inputs(device, length, seeded):
+    return (torch.tensor([0, length], dtype=torch.int32, device=device),
+            torch.full((1,), seeded, dtype=torch.bool, device=device),
+            torch.zeros(1, dtype=torch.int32, device=device))
+
+
+def prefill(backend, layer, batch, qkv, a, b, conv, state, owners):
+    """Stage each request's channel-major convolution history in donor order.
+
+    Real offsets delimit each call, including a selected interior APC checkpoint.
+    Model projections supply the live Z independently. The unused Z lane only
+    fills the packed convolution ABI. Time and request slots never alias.
+    """
+    load("gdn_index64")
+    count = qkv.shape[0]
+    out = qkv.new_zeros((count, 12, 128))
+    if not count:
+        return out.unsqueeze(0)
+    if qkv.shape[1] != 2560 or qkv.dtype != torch.bfloat16 or state.dtype != torch.float32:
+        raise ValueError("Unexpected B70 prefill shape or precision")
+    from sglang.srt.speculative import b70_checkpoints
+    interior = defaultdict(dict)
+    for item in b70_checkpoints.active():
+        interior[item.row][item.offset] = item
+    lengths = batch.extend_seq_lens_cpu
+    prefixes = batch.extend_prefix_lens_cpu
+    if sum(lengths) != count:
+        raise ValueError("GDN request lengths do not cover the activation rows")
+    meta = backend.forward_metadata
+    track = meta.has_mamba_track_mask and meta.track_ssm_h_src.numel() > 0
+    boundaries = meta.track_chunk_idx.tolist() if track else [0] * len(lengths)
+    tracked = state.new_empty((len(lengths), *state.shape[1:])) if track else None
+    qkvz = torch.cat((qkv, qkv.new_zeros(count, 1536)), dim=-1)
+    ba = torch.cat((b.reshape(count, 12), a.reshape(count, 12)), dim=-1).contiguous()
+    base = 0
+    for row, (length, prefix, chunk) in enumerate(zip(lengths, prefixes, boundaries, strict=True)):
+        if not length:
+            continue
+        owner = owners[row:row+1].long()
+        history = conv.index_select(0, owner).transpose(1, 2).contiguous()
+        if not prefix:
+            history.zero_()
+        checkpoint = chunk * backend.mamba_chunk_size
+        checkpoints = interior.get(row, {})
+        ends = {length}
+        if 0 < checkpoint < length:
+            ends.add(checkpoint)
+        ends.update(checkpoints)
+        start = 0
+        for end in sorted(ends):
+            span = slice(base+start, base+end)
+            n = end-start
+            offsets, seeded, zero = segment_inputs(qkv.device, n, bool(prefix or start))
+            z = torch.empty_like(out[span])
+            parts = torch.ops._gdn_index64.causal_conv1d_non_spec(
+                z, qkvz[span], ba[span], 16, 48, 128, 128, history,
+                layer.conv_weights.contiguous(), layer.bias, layer.activation,
+                1, 0, 0, seeded, offsets, None, zero, n, 4, True)
+            torch.ops._gdn_index64.gated_delta_rule_non_spec(
+                out[span], *parts, 48, 128, layer.A_log.float().reshape(-1).contiguous(),
+                layer.dt_bias.reshape(-1).contiguous(), state, 1, 0, 0, seeded,
+                offsets, None, owner.int(), n, 4)
+            item = checkpoints.get(end)
+            if item is not None:
+                item.save_recurrence(("gdn",layer.layer_id), state, owner)
+                item.save(("conv",layer.layer_id), conv, history.transpose(1,2))
+            if track and end == checkpoint:
+                tracked[row:row+1].copy_(state.index_select(0, owner))
+            start = end
+        conv.index_copy_(0, owner, history.transpose(1, 2))
+        base += length
+    if meta.has_mamba_track_mask:
+        backend._track_mamba_state_extend(batch, None, state, meta, h_track_buf=tracked)
+    return out.unsqueeze(0)
+
+
+@dataclass(frozen=True)
+class PrefillPhase:
+    rows: tuple
+    offsets: torch.Tensor
+    seeded: torch.Tensor
+    tokens: torch.Tensor | None
+    owner_rows: torch.Tensor
+    history_rows: torch.Tensor
+
+
+@dataclass(frozen=True)
+class NativeCheckpointPlan:
+    covered_phases: int
+    rows: int
+    offsets: torch.Tensor
+    destinations: torch.Tensor
+    scratch_rows: int
+    checkpoints: tuple
+
+
+@cache
+def _load_native_checkpoints():
+    path = Path("/opt/flashnext/a0035/liba0035_prefill_gdn.so")
+    digest, filename = path.with_name("prefill-gdn-native.sha256").read_text().split()
+    if filename != path.name or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
+        raise RuntimeError("Unexpected native GDN checkpoint export library")
+    torch.ops.load_library(str(path))
+    logging.getLogger(__name__).info("B70 admitted native GDN checkpoint export on XPU %d", torch.xpu.current_device())
+
+
+def _native_checkpoint_plan(phases, device):
+    if not (ISOLATED_PHASE_VIEWS and NATIVE_CHECKPOINTS) or len(phases) < 2:
+        return None
+    if any(phase.tokens is not None or len(phase.rows) != 1 for phase in phases):
+        return None
+
+    # On the short isolated route the donor can fold the final residue at
+    # an aligned cut and still export the previous exact checkpoint. Keep
+    # wide work on the qualified phase geometry.
+    _, tail_start, tail_size, *_ = phases[-1].rows[0]
+    covered = len(phases) - int(tail_size < 8 and tail_start + tail_size > 1024)
+    if covered < 2:
+        return None
+    segments = [phase.rows[0] for phase in phases[:covered]]
+    _, last_start, last_size, *_ = segments[-1]
+    rows = last_start + last_size
+    if any(row != 0 or start % 64 or (size < 8 and start + size != rows)
+           for row, start, size, *_ in segments):
+        return None
+
+    destinations = [0] * ((rows + 63) // 64)
+    checkpoints = []
+    leased = []
+    scratch_rows = 0
+    for _, start, size, _, item, track in segments:
+        if item is None and not track:
+            continue
+        end = start + size
+        chunk = (end - 1) // 64
+        slot = None if item is None else item.reserved
+        scratch_idx = None
+        if slot is None:
+            scratch_idx = scratch_rows
+            scratch_rows += 1
+            destinations[chunk] = -scratch_rows
+        else:
+            leased.append((chunk, slot))
+        checkpoints.append((end, item, track, scratch_idx))
+    if not checkpoints:
+        return None
+
+    rail = async_h2d(destinations, dtype=torch.int32, device=device)
+    for index, slot in leased:
+        rail[index:index + 1].copy_(slot)
+    offsets = async_h2d([0, rows], dtype=torch.int32, device=device)
+    return NativeCheckpointPlan(covered, rows, offsets, rail, scratch_rows, tuple(checkpoints))
+
+
+def _run_native_checkpoints(plan, first, layer, qkvz, ba, out, z, conv, history, state, owners, tracked):
+    _load_native_checkpoints()
+    rows = plan.rows
+    parts = torch.ops._gdn_index64.causal_conv1d_non_spec(
+        z[:rows], qkvz[:rows], ba[:rows], 16, 48, 128, 128, history,
+        layer.conv_weights.contiguous(), layer.bias, layer.activation,
+        1, 0, 0, first.seeded, plan.offsets, None, first.history_rows, rows, 4, True,
+    )
+    scratch = state.new_empty((plan.scratch_rows, *state.shape[1:]))
+    torch.ops.a0035_prefill_gdn.forward(
+        out[:rows], *parts, layer.A_log.float().reshape(-1).contiguous(),
+        layer.dt_bias.reshape(-1).contiguous(), state, plan.offsets, owners.int(),
+        first.seeded, plan.destinations, scratch,
+    )
+    for end, item, track, scratch_idx in plan.checkpoints:
+        saved = None if scratch_idx is None else scratch[scratch_idx:scratch_idx + 1]
+        if item is not None:
+            item.save_exported_recurrence(("gdn", layer.layer_id), state, saved)
+            # Donor reordering uses the original leading Q/K/V channels.
+            # At these aligned cuts its convolution window is the last
+            # three original BF16 projection rows.
+            checkpoint_conv = qkvz[end - 3:end, :2560].transpose(0, 1).unsqueeze(0)
+            item.save(("conv", layer.layer_id), conv, checkpoint_conv)
+        if track:
+            if saved is None:
+                torch.index_select(state, 0, item.reserved, out=tracked)
+            else:
+                tracked.copy_(saved)
+
+
+def _phase_plan(batch, backend, count, device, interior):
+    meta = backend.forward_metadata
+    lengths = batch.extend_seq_lens_cpu
+    prefixes = batch.extend_prefix_lens_cpu
+    track = meta.has_mamba_track_mask and meta.track_ssm_h_src.numel() > 0
+    if track and backend._has_cpu_prefill_track_metadata(batch):
+        from sglang.srt.layers.attention.mamba.prefill_track_metadata import build_prefill_track_plan
+
+        boundaries = build_prefill_track_plan(
+            batch.mamba_prefill_track_mask_cpu, batch.mamba_track_seqlens_cpu,
+            lengths, prefixes, backend.mamba_chunk_size, mamba2=False,
+        ).chunk_indices
+    else:
+        boundaries = meta.track_chunk_idx.tolist() if track else [-1] * len(lengths)
+
+    per_request = []
+    skip = () if batch.flashnext_mixed is None else batch.flashnext_mixed.verify_rows
+    base = 0
+    for row, (length, prefix, chunk) in enumerate(zip(lengths, prefixes, boundaries, strict=True)):
+        if row in skip:
+            base += length
+            continue
+        checkpoint = chunk * backend.mamba_chunk_size
+        checkpoints = interior.get(row, {})
+        ends = {length}
+        if 0 < checkpoint < length:
+            ends.add(checkpoint)
+        ends.update(checkpoints)
+        segments = []
+        cuts = sorted(ends)
+        for start, end in zip([0, *cuts[:-1]], cuts, strict=True):
+            segments.append((
+                row, base + start, end - start, bool(prefix or start),
+                checkpoints.get(end),
+                track and end == checkpoint,
+            ))
+        per_request.append(segments)
+        base += length
+
+    phases = []
+    use_phase_views = ISOLATED_PHASE_VIEWS and len(lengths) == 1 and not skip
+    for column in zip_longest(*per_request):
+        rows = tuple(segment for segment in column if segment is not None)
+        offsets = [0, *accumulate(segment[2] for segment in rows)]
+        tokens = None
+        if not use_phase_views and offsets[-1] != count:
+            selected = [index for _, start, size, *_ in rows for index in range(start, start + size)]
+            tokens = async_h2d(selected, dtype=torch.int32, device=device)
+        phases.append(PrefillPhase(
+            rows,
+            async_h2d(offsets, dtype=torch.int32, device=device),
+            async_h2d([segment[3] for segment in rows], dtype=torch.bool, device=device),
+            tokens,
+            async_h2d([segment[0] for segment in rows], dtype=torch.int64, device=device),
+            async_h2d([segment[0] for segment in rows], dtype=torch.int32, device=device),
+        ))
+    return tuple(phases), track
+
+
+def grouped_prefill(backend, layer, batch, qkv, a, b, conv, state, owners, *, projected=None):
+    """Dispatch one Xe2 pair per APC cut across requests on the mixed extend."""
+    lengths = batch.extend_seq_lens_cpu
+    if lengths is None or not 1 <= len(lengths) <= 4 or not all(lengths) or sum(lengths) != qkv.shape[0]:
+        return prefill(backend, layer, batch, qkv, a, b, conv, state, owners)
+
+    from sglang.srt.speculative import b70_checkpoints
+
+    load("gdn_index64")
+    count = qkv.shape[0]
+    meta = backend.forward_metadata
+    if meta.flashnext_prefill_plan is None:
+        interior = defaultdict(dict)
+        for item in b70_checkpoints.active():
+            interior[item.row][item.offset] = item
+        meta.flashnext_prefill_plan = _phase_plan(batch, backend, count, qkv.device, interior)
+        if projected is not None and len(lengths) == 1 and batch.flashnext_mixed is None:
+            meta.flashnext_prefill_export_plan = _native_checkpoint_plan(
+                meta.flashnext_prefill_plan[0], qkv.device,
+            )
+        elif (projected is not None and batch.flashnext_mixed is None
+              and os.getenv("SGLANG_FLASHNEXT_COHORT_GDN_EXPORT") == "1"):
+            from sglang.srt.speculative.cohort_checkpoints import build_plan
+
+            meta.flashnext_prefill_export_plan = build_plan(meta.flashnext_prefill_plan[0], lengths, qkv.device)
+    phases, track = meta.flashnext_prefill_plan
+
+    owners = owners.long()
+    history = conv.index_select(0, owners).transpose(1, 2).contiguous()
+    if projected is None:
+        qkvz = torch.cat((qkv, qkv.new_zeros(count, 1536)), dim=-1)
+        ba = torch.cat((b.reshape(count, 12), a.reshape(count, 12)), dim=-1)
+    else:
+        qkvz, ba = projected
+    z = qkv.new_empty((count, 12, 128))
+    out = torch.empty_like(z)
+    tracked = state.new_empty((len(lengths), *state.shape[1:])) if track else None
+    ops = torch.ops._gdn_index64
+    export = meta.flashnext_prefill_export_plan if projected is not None else None
+    if export is not None and len(lengths) > 1:
+        from sglang.srt.speculative.cohort_checkpoints import run
+
+        run(export, layer, qkvz, ba, out, z, conv, history, state, owners, tracked)
+        phases = ()
+    elif export is not None:
+        _run_native_checkpoints(export, phases[0], layer, qkvz, ba, out, z, conv, history, state, owners, tracked)
+        phases = phases[export.covered_phases:]
+    for phase in phases:
+        if phase.tokens is None and len(phase.rows) == 1:
+            _, start, length, *_ = phase.rows[0]
+        else:
+            start, length = 0, count
+        span = slice(start, start + length)
+        # The Xe2 delta rule sizes and clears A/W/U from its output extent,
+        # even if its indexed phase only writes a subset. Serve contiguous
+        # single-request donors directly through their sized view.
+        phase_owners = owners.index_select(0, phase.owner_rows)
+        parts = ops.causal_conv1d_non_spec(
+            z[span], qkvz[span], ba[span], 16, 48, 128, 128, history,
+            layer.conv_weights.contiguous(), layer.bias, layer.activation,
+            len(phase.rows), 0, 0, phase.seeded, phase.offsets, phase.tokens,
+            phase.history_rows, length, 4, True,
+        )
+        ops.gated_delta_rule_non_spec(
+            out[span], *parts, 48, 128, layer.A_log.float().reshape(-1).contiguous(),
+            layer.dt_bias.reshape(-1).contiguous(), state, len(phase.rows), 0, 0,
+            phase.seeded, phase.offsets, phase.tokens, phase_owners.int(), length, 4,
+        )
+        for row, _, _, _, item, save_track in phase.rows:
+            owner = owners[row:row + 1]
+            if item is not None:
+                item.save_recurrence(("gdn", layer.layer_id), state, owner)
+                item.save(("conv", layer.layer_id), conv, history[row:row + 1].transpose(1, 2))
+            if save_track:
+                torch.index_select(state, 0, owner, out=tracked[row:row + 1])
+
+    conv.index_copy_(0, owners, history.transpose(1, 2))
+    if meta.has_mamba_track_mask:
+        backend._track_mamba_state_extend(batch, None, state, meta, h_track_buf=tracked)
+    if batch.flashnext_mixed is not None:
+        mixed = batch.flashnext_mixed
+        selected = mixed.verify_tokens.flatten()
+        verifier = mixed.gdn
+        cache = backend.state_layer_cache(layer.layer_id)
+        mixed_out, mixed_z = verifier._verify(
+            layer, qkvz.index_select(0, selected), ba.index_select(0, selected), cache,
+        )
+        out.index_copy_(0, selected, mixed_out)
+        z.index_copy_(0, selected, mixed_z)
+    return (out, z) if projected is not None else out.unsqueeze(0)

@@ -0,0 +1,46 @@
+"""Per-rank installed-profile checks before target load, pools, and graph admission."""
+import logging
+
+import torch
+
+# Maximum physical growth from each boundary to the RC11 high-water mark
+# across all four cards, rounded up to 64 MiB. This includes the complete
+# input rescore and all graph widths. Each entry already includes subsequent
+# model/pool loads, driver allocations and transient work at that boundary.
+GROWTH_MIB = {
+    "target-load": 30208,
+    "draft-load": 11328,
+    "target-pools": 10368,
+    "draft-pools": 5824,
+    "post-pools": 5824,
+}
+SAFETY = 1 << 30
+UNSAMPLED_ALLOWANCE = 128 << 20
+
+
+def check(device, phase):
+    required = (GROWTH_MIB[phase] << 20) + UNSAMPLED_ALLOWANCE + SAFETY
+    free, total = torch.xpu.mem_get_info(device)
+    logging.getLogger(__name__).info("B70 physical budget phase=%s device=%s total=%d free=%d required=%d",
+                                      phase, device, total, free, required)
+    if free < required:
+        raise RuntimeError(f"B70 {phase} requires {required} free physical bytes, available {free}")
+
+
+def can_admit(device, key):
+    """Agree across all TP ranks before allocating a new graph and its shadow."""
+    from sglang.srt.hardware_backend.xpu.graph_runner.flashnext_target import TargetGraphs
+    free, _ = torch.xpu.mem_get_info(device)
+    # A0025's observed rank-0 peak was 431,706,112 bytes above its C4
+    # sampled boundary. Allow 768 MiB of transient demand above the reserve.
+    required = SAFETY + (768 << 20)
+    admitted = TargetGraphs._all_ranks(free >= required)
+    if not admitted:
+        # Torch can still own unused eager segments after a different workload.
+        # Recover those segments on every rank before testing the same reserve.
+        torch.xpu.empty_cache()
+        free, _ = torch.xpu.mem_get_info(device)
+        admitted = TargetGraphs._all_ranks(free >= required)
+    logging.getLogger(__name__).info("B70 physical graph admission key=%s free=%d required=%d admitted=%s",
+                                      key, free, required, admitted)
+    return admitted
diff --git a/python/sglang/srt/speculative/class_ffn.py b/python/sglang/srt/speculative/class_ffn.py
new file mode 100644
index 0000000000000000000000000000000000000000..254f60148111181eaffb141bf032006278834ebe
--- /dev/null
+++ b/python/sglang/srt/speculative/class_ffn.py
@@ -0,0 +1,103 @@
+"""Replay the complete rank-local short FFN at its oneDNN row class."""
+import logging
+from dataclasses import replace
+from unittest.mock import patch
+from weakref import WeakKeyDictionary
+
+import torch
+
+from sglang.srt.layers.moe.topk import StandardTopKOutput
+from sglang.srt.model_executor.forward_context import forward_context, get_forward_context
+from sglang.srt.speculative.budget import can_admit
+from sglang.srt.speculative.proposal_bindings import Bindings
+from sglang.srt.speculative.staged_short_ffn import eligible
+
+log = logging.getLogger(__name__)
+_banks = {}
+
+
+class Entry:
+    def __init__(self, module, graph):
+        weights = (*module.parameters(), *module.buffers())
+        self.guard = Bindings(tuple(module.modules()), weights, ())
+        self.storage = tuple(x.detach() for x in weights)
+        self.graph = graph
+        self.checks = 0
+        self.disabled = False
+
+
+class Bank:
+    def __init__(self, tensor):
+        self.stream = torch.xpu.current_stream(tensor.device)
+        self.pool = torch.xpu.graph_pool_handle()
+        self.entries = WeakKeyDictionary()
+        with torch.inference_mode(False), torch.no_grad():
+            self.x = tensor.new_zeros((256,2560))
+            self.out = torch.empty_like(self.x)
+            self.rows = self.x.new_zeros((),dtype=torch.int32)
+            self.bound = torch.zeros_like(self.rows)
+            self.positions = torch.arange(256, device=tensor.device)
+
+    def capture(self,module,batch,width):
+        x = self.x[:width]
+        out = self.out[:width]
+        rows = self.positions[:width]
+        ctx = replace(get_forward_context(),moe_num_token_non_padded=lambda:self.bound)
+
+        def routed(hidden_states, *, defer_finalize=False):
+            if defer_finalize:
+                raise ValueError("Short FFN needs the local routed result")
+            logits, _ = module.gate(hidden_states)
+            route = module.topk(hidden_states, logits)
+            if not isinstance(route,StandardTopKOutput):
+                raise ValueError("Short FFN requires explicit expert indices")
+            ids = route.topk_ids.masked_fill(rows[:,None] >= self.rows,-1)
+            return module.experts(hidden_states,StandardTopKOutput(route.topk_weights,ids,logits))
+
+        with forward_context(ctx), patch.object(module,"_forward_router_experts",routed):
+            module(x,batch,defer_finalize=False)
+            graph = torch.xpu.XPUGraph()
+            with torch.xpu.graph(graph,pool=self.pool):
+                out.copy_(module(x,batch,defer_finalize=False))
+        return Entry(module,graph)
+
+    def run(self,module,hidden,batch):
+        n=len(hidden)
+        width=next(w for w in (16,32,64,128,192,256) if w>=n)
+        entries=self.entries.setdefault(module,{})
+        entry=entries.get(width)
+        if entry is False or (entry is not None and (entry.disabled or not entry.guard.valid(()))):
+            return module(hidden,batch,defer_finalize=False)
+        self.x[:n].copy_(hidden)
+        self.rows.fill_(n)
+        bound=batch.moe_num_token_non_padded()
+        self.bound.copy_(self.rows if bound is None else bound.reshape(()))
+        if entry is None:
+            if not can_admit(hidden.device,("short-ffn-class",module.layer_id,width)):
+                entries[width]=False
+                return module(hidden,batch,defer_finalize=False)
+            entry=entries[width]=self.capture(module,batch,width)
+        entry.graph.replay()
+        result=self.out[:n]
+        if entry.checks<2:
+            ordinary=module(hidden,batch,defer_finalize=False)
+            ok=torch.equal(ordinary.view(torch.int16),result.view(torch.int16))
+            entry.checks+=1
+            entry.disabled=not ok
+            log.info("A0042 local FFN layer=%d width=%d rows=%d check=%d exact=%s",
+                     module.layer_id,width,n,entry.checks,ok)
+            return ordinary
+        return result.clone()
+
+
+@torch.inference_mode()
+def run(module,hidden,batch):
+    if not eligible(module,hidden):
+        return module(hidden,batch,defer_finalize=False)
+    key=hidden.device
+    if key not in _banks:
+        _banks[key]=Bank(hidden) if can_admit(key,("short-ffn-class-storage",256)) else None
+    bank=_banks[key]
+    if bank is None or bank.stream!=torch.xpu.current_stream(key):
+        return module(hidden,batch,defer_finalize=False)
+    return bank.run(module,hidden,batch)
diff --git a/python/sglang/srt/speculative/class_hc.py b/python/sglang/srt/speculative/class_hc.py
new file mode 100644
index 0000000000000000000000000000000000000000..30432acd449f180c9716c1d2500eb97dae3e7dc5
--- /dev/null
+++ b/python/sglang/srt/speculative/class_hc.py
@@ -0,0 +1,73 @@
+"""Share one set of HC rails across the B70 oneDNN row-size regimes."""
+from weakref import WeakKeyDictionary
+import torch
+from sglang.srt.speculative.bucket_hc import Bank, supported
+from sglang.srt.speculative.proposal_bindings import Bindings
+
+WIDTHS=(16,32,64,128,192,256)
+_workspace=None
+
+
+class View(Bank):
+    def __init__(self,storage,width):
+        self.stream,self.pool=storage.stream,storage.pool
+        self.entries=WeakKeyDictionary()
+        self.guards=WeakKeyDictionary()
+        self.owner=None
+        self.x,self.n,self.mixed,self.block,self.updated=(v[:width] for v in
+            (storage.x,storage.n,storage.mixed,storage.block,storage.updated))
+
+    def capture(self,module):
+        weights=(module.hc_norm.weight,module.input_mix_weight_down.weight,
+                 module.input_mix_weight_up.weight,module.block_inject_weight.weight)
+        modules=tuple(module.modules())
+        if any(type(registry) is not dict for m in modules for registry in (m._modules,m._parameters,m._buffers)):
+            return None
+        guard=Bindings(modules,weights,())
+        # Retain independent tensor views of captured storage across replacement
+        # of a parameter object or its backing storage.
+        self.guards[module]=(guard,tuple(w.detach() for w in weights),
+                             module._mix_compute,module._combine_compute)
+        return super().capture(module)
+
+    def valid(self,module):
+        g=self.guards.get(module)
+        return g is None or (g[2] is module._mix_compute and g[3] is module._combine_compute and g[0].valid(()))
+
+
+class Shared:
+    def __init__(self,x):
+        storage=Bank(256,x.device)
+        self.stream=storage.stream
+        self.views={w:View(storage,w) for w in WIDTHS}
+        self.active=None
+
+    def mix(self,module,x):
+        w=next(w for w in WIDTHS if len(x)<=w)
+        v=self.views[w]
+        if self.active is not None:
+            self.active.owner=None
+        self.active=v
+        return v.mix(module,x) if v.valid(module) else None
+
+    def combine(self,module,block,prior):
+        v=self.active
+        return v.combine(module,block,prior) if v is not None and v.valid(module) else None
+
+
+@torch.inference_mode()
+def mix(module,x):
+    global _workspace
+    if _workspace is None:
+        from sglang.srt.speculative.budget import can_admit
+        _workspace=Shared(x) if can_admit(x.device,("class-hc-workspace",256)) else False
+    if _workspace and _workspace.stream==torch.xpu.current_stream(x.device):
+        return _workspace.mix(module,x)
+    return None
+
+
+@torch.inference_mode()
+def combine(module,block,prior):
+    if _workspace and _workspace.stream==torch.xpu.current_stream(block.device):
+        return _workspace.combine(module,block,prior)
+    return None
diff --git a/python/sglang/srt/speculative/cohort_checkpoints.py b/python/sglang/srt/speculative/cohort_checkpoints.py
new file mode 100644
index 0000000000000000000000000000000000000000..d1d0a34354cd873f50130a110221ade980dccee4
--- /dev/null
+++ b/python/sglang/srt/speculative/cohort_checkpoints.py
@@ -0,0 +1,93 @@
+"""Export working and intermediate GDN states for several packed prefill requests."""
+from dataclasses import dataclass
+from functools import cache
+import hashlib
+from itertools import accumulate
+from pathlib import Path
+
+import torch
+
+from sglang.srt.utils.device import async_h2d
+
+
+@cache
+def load():
+    lib = Path("/opt/flashnext/a0039/liba0039_cohort_gdn.so")
+    digest, filename = lib.with_suffix(".sha256").read_text().split()
+    if filename != lib.name or hashlib.sha256(lib.read_bytes()).hexdigest() != digest:
+        raise RuntimeError("Unexpected multi-request GDN checkpoint export library")
+    torch.ops.load_library(str(lib))
+
+
+@dataclass
+class CohortPlan:
+    rows: int
+    covered_phases: int
+    offsets: torch.Tensor
+    history_rows: torch.Tensor
+    seeded: torch.Tensor
+    destinations: torch.Tensor
+    checkpoints: list
+
+
+def build_plan(phases, lengths, device):
+    if len(phases) < 2 or not 2 <= len(lengths) <= 4 or sum(lengths) > 4097:
+        return None
+    if any(sum(segment[2] for segment in phase.rows) < 8 for phase in phases):
+        # The original phase selected the donor's untiled short convolution.
+        return None
+    offsets = list(accumulate(lengths, initial=0))
+    first = phases[0]
+    if [s[0] for s in first.rows] != list(range(len(lengths))):
+        return None
+    chunks = list(accumulate(((n + 63) // 64 for n in lengths), initial=0))
+    destinations = [0] * ((offsets[-1] + len(lengths) * 63) // 64)
+    checkpoints = []
+    for phase in phases:
+        for row, start, size, _, item, track in phase.rows:
+            relative = start - offsets[row]
+            end = relative + size
+            if relative % 64 or end != lengths[row] and end % 64:
+                return None
+            if item is None and not track:
+                continue
+            if item is not None and (item.reserved is not None or end < 3):
+                return None
+            chunk = chunks[row] + (end - 1) // 64
+            if destinations[chunk]:
+                raise RuntimeError("Two checkpoint writes target the same recurrence chunk")
+            checkpoints.append((row, offsets[row] + end, item, track))
+            destinations[chunk] = -len(checkpoints)
+    if not checkpoints:
+        return None
+    return CohortPlan(
+        offsets[-1], len(phases), async_h2d(offsets, dtype=torch.int32, device=device),
+        first.history_rows, first.seeded, async_h2d(destinations, dtype=torch.int32, device=device),
+        checkpoints,
+    )
+
+
+def run(plan, layer, qkvz, ba, out, z, conv, history, state, owners, tracked):
+    load()
+    rows = len(out)
+    count = len(owners)
+    parts = torch.ops._gdn_index64.causal_conv1d_non_spec(
+        z, qkvz, ba, 16, 48, 128, 128, history, layer.conv_weights.contiguous(),
+        layer.bias, layer.activation, count, 0, 0, plan.seeded, plan.offsets, None,
+        plan.history_rows, rows, 4, True,
+    )
+    scratch = state.new_empty((len(plan.checkpoints), *state.shape[1:]))
+    torch.ops.a0039_cohort_gdn.forward(
+        out, *parts, layer.A_log.float().reshape(-1).contiguous(), layer.dt_bias.reshape(-1).contiguous(),
+        state, plan.offsets, owners.int(), plan.seeded, plan.destinations, scratch,
+    )
+    for index, (row, end, item, track) in enumerate(plan.checkpoints):
+        current = scratch[index:index + 1]
+        if item is not None:
+            # Only persist this checkpoint's words. Keeping a view of the slab
+            # would retain every other request's transient tracker for 36 layers.
+            item.save_exported_recurrence(("gdn", layer.layer_id), state, current.clone())
+            item.save(("conv", layer.layer_id), conv,
+                      qkvz[end - 3:end, :2560].transpose(0, 1).unsqueeze(0))
+        if track:
+            tracked[row:row + 1].copy_(current)
diff --git a/python/sglang/srt/speculative/flashnext_prefill.py b/python/sglang/srt/speculative/flashnext_prefill.py
new file mode 100644
index 0000000000000000000000000000000000000000..afecdc6962ff7aaf3da2a27c6b6cdfb4293c6dbd
--- /dev/null
+++ b/python/sglang/srt/speculative/flashnext_prefill.py
@@ -0,0 +1,147 @@
+"""Fixed-width prefill expert replay on B70, after same-input qualification."""
+import logging
+import os
+import weakref
+from dataclasses import replace
+from sglang.srt.model_executor.forward_context import forward_context, get_forward_context
+
+import torch
+from sglang.srt.hardware_backend.xpu.graph_runner.flashnext_target import TargetGraphs
+
+log = logging.getLogger(__name__)
+
+
+class PrefillExperts:
+    def __init__(self,x):
+        self.input=torch.empty_like(x)
+        self.output=torch.empty_like(x)
+        self.pool=torch.xpu.graph_pool_handle()
+        self.real_rows=torch.full((),x.shape[0],dtype=torch.int32,device=x.device)
+        self.entries=weakref.WeakKeyDictionary()
+        self.padded_counts=weakref.WeakKeyDictionary()
+        self.retired_graphs=[]
+
+    def run(self,module,hidden,batch):
+        entry=self.entries.get(module)
+        if entry is False:
+            return module(hidden,batch,defer_finalize=False)
+        self.input.copy_(hidden)
+        # TopK resolves a scheduler-owned device scalar via ForwardContext.
+        # Retain and stage our own scalar for the lifetime of the captured graph.
+        bound=batch.moe_num_token_non_padded()
+        if bound is None:
+            self.real_rows.fill_(hidden.shape[0])
+        else:
+            self.real_rows.copy_(bound.reshape(()))
+        if entry is None:
+            from sglang.srt.speculative.budget import can_admit
+            if not can_admit(hidden.device, ("prefill-expert", module.layer_id, hidden.shape[0])):
+                self.entries[module] = False
+                return module(hidden,batch,defer_finalize=False)
+            expected=module(hidden,batch,defer_finalize=False)
+            graph=torch.xpu.XPUGraph()
+            ctx=replace(get_forward_context(),moe_num_token_non_padded=lambda:self.real_rows)
+            with forward_context(ctx), torch.inference_mode(), torch.xpu.graph(graph,pool=self.pool):
+                self.output.copy_(module(self.input,batch,defer_finalize=False))
+            checks=0
+        else:
+            graph,checks=entry
+            expected=module(hidden,batch,defer_finalize=False) if checks<2 else None
+        with torch.inference_mode():
+            graph.replay()
+        if expected is not None:
+            passed=TargetGraphs._all_ranks(torch.equal(expected,self.output))
+            if not passed:
+                self.retired_graphs.append(graph)
+            self.entries[module]=(graph,checks+1) if passed else False
+            log.info('Flash Next prefill expert graph check layer=%d rows=%d replay=%d exact=%s',
+                     module.layer_id,hidden.shape[0],checks+1,passed)
+            return expected
+        return self.output.clone()
+
+
+_bucket_regions = {}
+
+
+def _bucket(module, hidden, batch):
+    # Only the local FFN is padded. The original row count reaches the
+    # layer boundary and its BF16 TP reduction, including on uneven widths.
+    global _regions
+    live = hidden.shape[0]
+    width = 128 if live <= 128 else 256
+    region = _regions if width == 256 else _bucket_regions.get(width)
+    if region is None:
+        region = PrefillExperts(hidden.new_empty((width, hidden.shape[1])))
+        if width == 256:
+            _regions = region
+        else:
+            _bucket_regions[width] = region
+    entry = region.entries.get(module)
+    padded_checks = region.padded_counts.get(module, 0)
+    if entry is False or padded_checks is False:
+        return module(hidden, batch, defer_finalize=False)
+    region.input[:live].copy_(hidden)
+    region.input[live:].zero_()
+    bound = batch.moe_num_token_non_padded()
+    if bound is None:
+        region.real_rows.fill_(live)
+    else:
+        region.real_rows.copy_(bound.reshape(()))
+    if entry is None:
+        from sglang.srt.speculative.budget import can_admit
+        if not can_admit(hidden.device, ("short-prefill-experts", module.layer_id, width)):
+            region.entries[module] = False
+            return module(hidden, batch, defer_finalize=False)
+        ctx = replace(get_forward_context(), moe_num_token_non_padded=lambda: region.real_rows)
+        with forward_context(ctx), torch.inference_mode():
+            module(region.input, batch, defer_finalize=False)
+            graph = torch.xpu.XPUGraph()
+            with torch.xpu.graph(graph, pool=region.pool):
+                region.output.copy_(module(region.input, batch, defer_finalize=False))
+        region.entries[module] = (graph, 0)
+    else:
+        graph, _ = entry
+    with torch.inference_mode():
+        graph.replay()
+        partial = region.output[:live]
+        if padded_checks < 2:
+            ordinary = module(hidden, batch, defer_finalize=False)
+            passed = TargetGraphs._all_ranks(torch.equal(ordinary, partial))
+            region.padded_counts[module] = padded_checks + 1 if passed else False
+            log.info("Short expert graph layer=%d bucket=%d real=%d check=%d exact=%s",
+                     module.layer_id, width, live, padded_checks + 1, passed)
+            return ordinary
+        return partial.clone()
+
+
+_regions=None
+
+
+def experts(module,hidden,batch,deferred):
+    global _regions
+    if (
+        os.getenv("SGLANG_FLASHNEXT_BUCKET_EXPERTS") == "1"
+        and (16 <= hidden.shape[0] < 256 or
+             hidden.shape[0] == 256 and os.getenv("SGLANG_FLASHNEXT_STAGED_SHORT_FFN") == "1")
+        and hidden.shape[1:] == (2560,)
+        and hidden.is_xpu and hidden.dtype == torch.bfloat16
+        and batch.forward_mode.is_extend_without_speculative()
+        and not deferred and not module.reduce_results and not module.experts.reduce_results
+        and hasattr(module.experts, "intel_cyclic_w4") and not torch.xpu.is_current_stream_capturing()
+        and not batch.return_logprob and not any(batch.lora_ids or ())
+        and not batch.contains_mm_inputs() and batch.tbo_split_seq_index is None
+        and batch.flashnext_mixed is None
+    ):
+        if os.getenv("SGLANG_FLASHNEXT_STAGED_SHORT_FFN") == "1":
+            from sglang.srt.speculative.class_ffn import run
+
+            return run(module,hidden,batch)
+        return _bucket(module, hidden, batch)
+    if (os.environ.get('SGLANG_FLASHNEXT_PREFILL_EXPERT_GRAPH')!='1'
+        or hidden.shape!=(256,2560) or hidden.dtype!=torch.bfloat16 or hidden.device.type!='xpu'
+        or not batch.forward_mode.is_extend_without_speculative() or deferred
+        or not hasattr(module.experts,'intel_cyclic_w4') or torch.xpu.is_current_stream_capturing()):
+        return module(hidden,batch,defer_finalize=deferred)
+    if _regions is None:
+        _regions=PrefillExperts(hidden)
+    return _regions.run(module,hidden,batch)
diff --git a/python/sglang/srt/speculative/gdn_admission.py b/python/sglang/srt/speculative/gdn_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..aa52fb07428195bcde59c56689b1f134bfda1c83
--- /dev/null
+++ b/python/sglang/srt/speculative/gdn_admission.py
@@ -0,0 +1,54 @@
+"""Compare all candidate GDN prefixes against the independent eager verifier."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _compare(live, records, owners, expected, flags,
+             WORK_LAYER: tl.constexpr, WORK_SLOT: tl.constexpr,
+             SRC_LAYER: tl.constexpr, SRC_REQUEST: tl.constexpr, SRC_STEP: tl.constexpr,
+             DST_LAYER: tl.constexpr, DST_REQUEST: tl.constexpr, DST_STEP: tl.constexpr,
+             ROWS: tl.constexpr, TILES: tl.constexpr):
+    layer = tl.program_id(0).to(tl.int64)
+    row = tl.program_id(1)
+    tile = tl.program_id(2)
+    head = tile // 16
+    v = (tile % 16) * 8 + tl.arange(0, 8)
+    k = tl.arange(0, 128)
+    coord = (head * 128 + v[:, None]) * 128 + k[None, :]
+    slot = tl.load(owners + row).to(tl.int64)
+    state = tl.load(live + layer * WORK_LAYER + slot * WORK_SLOT + coord)
+    src = records + layer * SRC_LAYER + row * SRC_REQUEST + head * 257
+    dst = expected + layer * DST_LAYER + row * DST_REQUEST + coord
+    ok = tl.full((8, 128), True, tl.int1)
+    for t in tl.static_range(8):
+        words = src + t * SRC_STEP
+        key = tl.load(words + k)
+        innovation = tl.load(words + 128 + v)
+        decay = tl.load(words + 256)
+        state = tl.fma(state, decay, key[None, :] * innovation[:, None])
+        reference = tl.load(dst + t * DST_STEP)
+        ok &= (state.to(tl.int32, bitcast=True) == reference.to(tl.int32, bitcast=True))
+        ok &= tl.abs(state) < float("inf")
+    flag = tl.min(tl.reshape(ok.to(tl.int32), (1024,)), axis=0)
+    tl.store(flags + (layer * ROWS + row) * TILES + tile, flag)
+
+
+def save_records(states, n):
+    # This runs after capture's changed-input replay and before eager reuses
+    # the intermediate pool. Each record is 12 * (128 + 128 + 1) FP32 words.
+    return states[:, :n, :8].flatten(3)[..., :12 * 257].contiguous()
+
+
+def compare_all(live, records, owners, expected):
+    layers, n, depth, words = records.shape
+    assert (depth, words) == (8, 12 * 257) and owners.numel() == n
+    assert live.dtype == records.dtype == expected.dtype == torch.float32
+    tiles = 12 * 16
+    flags = records.new_empty((layers, n, tiles), dtype=torch.int32)
+    _compare[(layers, n, tiles)](
+        live, records, owners, expected, flags, *live.stride()[:2],
+        *records.stride()[:3], *expected.stride()[:3], n, tiles,
+    )
+    return bool(flags.all().item())
diff --git a/python/sglang/srt/speculative/short_regions.py b/python/sglang/srt/speculative/short_regions.py
new file mode 100644
index 0000000000000000000000000000000000000000..0abc2be7cdeea9957b6f0f1634f2e3a130bff6fa
--- /dev/null
+++ b/python/sglang/srt/speculative/short_regions.py
@@ -0,0 +1,66 @@
+"""Share stateless row-local XPU graphs across layers. State writes stay at the true row count."""
+import torch
+import torch.nn.functional as F
+
+
+def gdn_ops(q, k, v, a, b, a_log, dt_bias):
+    q, k = q.float(), k.float()
+    q = q * (q.square().sum(-1, keepdim=True) + 1e-6).rsqrt()
+    k = k * (k.square().sum(-1, keepdim=True) + 1e-6).rsqrt()
+    gate = (-a_log.float().exp() * F.softplus(a.float() + dt_bias.float())).exp()
+    return ((q * (128 ** -0.5)).repeat_interleave(3, dim=1),
+            k.repeat_interleave(3, dim=1), v.float(), gate, b.float().sigmoid())
+
+
+def norm_ops(x, weight, eps):
+    grouped = x.float().reshape(-1, 4, 2560)
+    scaled = grouped * (grouped.square().mean(-1, keepdim=True) + eps).rsqrt()
+    return ((scaled.flatten(1) * (1.0 + weight.float())).to(x.dtype),)
+
+
+class Region:
+    def __init__(self, operation, width, values, row_inputs):
+        self.row_inputs = row_inputs
+        self.values = tuple(v.new_zeros((width, *v.shape[1:]) if i < row_inputs else v.shape)
+                            for i, v in enumerate(values))
+        operation(*self.values)
+        self.graph = torch.xpu.XPUGraph()
+        with torch.xpu.graph(self.graph):
+            self.outputs = operation(*self.values)
+
+    def replay(self, values):
+        rows = len(values[0])
+        destinations = [v[:rows] if i < self.row_inputs else v for i, v in enumerate(self.values)]
+        torch._foreach_copy_(destinations, values)
+        self.graph.replay()
+        return tuple(v[:rows] for v in self.outputs)
+
+
+_regions = {}
+
+
+@torch.inference_mode()
+def _run(name, fn, values, row_inputs, limit, extra=()):
+    width = 64 if len(values[0]) <= 64 else 128 if len(values[0]) <= 128 else 256
+    stream = torch.xpu.current_stream(values[0].device)
+    key = (name, width, values[0].device, stream.sycl_queue, tuple(v.dtype for v in values), extra)
+    if key not in _regions:
+        if sum(k[0] == name for k in _regions) >= limit:
+            return fn(*values)
+        from sglang.srt.speculative.budget import can_admit
+        _regions[key] = Region(fn, width, values, row_inputs) if can_admit(values[0].device, (name, width)) else None
+    entry = _regions[key]
+    return entry.replay(values) if entry is not None else fn(*values)
+
+
+def gdn(q, k, v, a, b, a_log, bias):
+    return _run("gdn-operands", gdn_ops, (q, k, v, a.reshape(-1, 12), b.reshape(-1, 12),
+                                          a_log.reshape(12), bias.reshape(12)), 5, 2)
+
+
+def norm(module, x):
+    eps = module.variance_epsilon
+    result, = _run("hc-norm", lambda data, weight: norm_ops(data, weight, eps),
+                   (x, module.weight), 1, 3, (eps,))
+    # HC can retain the normalized activation across the following block.
+    return result.clone()
diff --git a/python/sglang/srt/speculative/staged_short_ffn.py b/python/sglang/srt/speculative/staged_short_ffn.py
new file mode 100644
index 0000000000000000000000000000000000000000..4f9e61575b0c76f78586b1ecc8225ad73be55531
--- /dev/null
+++ b/python/sglang/srt/speculative/staged_short_ffn.py
@@ -0,0 +1,150 @@
+"""Replay the row-local short expert FFN after ordinary dense math and routing."""
+from dataclasses import dataclass
+import logging
+from unittest.mock import patch
+from weakref import WeakKeyDictionary
+
+from dataclasses import replace
+from sglang.srt.model_executor.forward_context import forward_context, get_forward_context
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.layers.moe.topk import StandardTopKOutput
+from sglang.srt.hardware_backend.xpu.graph_runner.flashnext_target import TargetGraphs
+from sglang.srt.speculative.budget import can_admit
+
+log = logging.getLogger(__name__)
+_regions = {}
+
+
+@triton.jit(do_not_specialize=["rows"])
+def _stage(hidden, logits, shared, static_hidden, static_logits, static_shared, rows):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    col = tile * 512 + tl.arange(0, 512)
+    active = row < rows
+    x = tl.load(hidden + row * 2560 + col, mask=active, other=0.0)
+    s = tl.load(shared + row * 2560 + col, mask=active, other=0.0)
+    tl.store(static_hidden + row * 2560 + col, x)
+    tl.store(static_shared + row * 2560 + col, s)
+    if tile == 0:
+        gate = tl.load(logits + row * 512 + col, mask=active, other=0.0)
+        tl.store(static_logits + row * 512 + col, gate)
+
+
+
+@dataclass
+class Entry:
+    graph: torch.xpu.XPUGraph
+    checks: int = 0
+    blocked: bool = False
+
+
+class Regions:
+    def __init__(self, value, width):
+        self.width = width
+        self.stream = torch.xpu.current_stream(value.device)
+        # Keep the persistent output usable on both scheduler entry modes.
+        with torch.inference_mode(False), torch.no_grad():
+            self.hidden = value.new_empty((width,2560))
+            self.logits = value.new_empty((width,512))
+            self.shared = torch.empty_like(self.hidden)
+            self.rows = torch.zeros((),device=value.device,dtype=torch.int32)
+            self.bound = torch.zeros_like(self.rows)
+            self.output = torch.empty_like(self.hidden)
+        self.pool = torch.xpu.graph_pool_handle()
+        self.entries = WeakKeyDictionary()
+
+    def capture(self,module,batch):
+        ctx = replace(get_forward_context(), moe_num_token_non_padded=lambda: self.bound)
+        # Run the installed FFN control flow. The shared result, true top-k
+        # and router logits were already produced by its original modules on
+        # true rows. Only cyclic expert arithmetic and the original fused
+        # scalar gate/mul/add remain on the padded side of the boundary.
+        def shared_result(hidden_states,apply_gate=True):
+            if apply_gate:
+                raise RuntimeError("Unexpected shared FFN gate dispatch during short capture")
+            return self.shared
+
+        def routed_result(hidden_states,*,defer_finalize=False):
+            if defer_finalize:
+                raise RuntimeError("Unexpected deferred FFN during short capture")
+            routes = module.topk(hidden_states, self.logits)
+            if not isinstance(routes, StandardTopKOutput):
+                raise RuntimeError("Unexpected short expert routing layout")
+            rows = torch.arange(self.width, device=self.hidden.device)
+            ids = routes.topk_ids.masked_fill(rows[:, None] >= self.rows, -1)
+            return module.experts(hidden_states, StandardTopKOutput(routes.topk_weights, ids, self.logits))
+
+        with (torch.inference_mode(), forward_context(ctx),
+              patch.object(module,"_forward_shared_experts",shared_result),
+              patch.object(module,"_forward_router_experts",routed_result)):
+            module(self.hidden,batch,defer_finalize=False)
+            graph = torch.xpu.XPUGraph()
+            with torch.xpu.graph(graph,pool=self.pool):
+                self.output.copy_(module(self.hidden,batch,defer_finalize=False))
+        return Entry(graph)
+
+    def run(self,module,hidden,batch):
+        entry = self.entries.get(module)
+        if (entry is False or (entry is not None and entry.blocked)
+                or self.stream != torch.xpu.current_stream(hidden.device)):
+            return module(hidden,batch,defer_finalize=False)
+        if entry is None and not can_admit(hidden.device, ("staged-short-ffn",module.layer_id,self.width)):
+            self.entries[module] = False
+            return module(hidden,batch,defer_finalize=False)
+        # Preserve all three real-row oneDNN geometries (router, shared gate/up
+        # and shared down), SiLU precision, tie handling and the true route bound.
+        shared = module._forward_shared_experts(hidden,apply_gate=False)
+        logits, _ = module.gate(hidden)
+        if not logits.is_contiguous() or not shared.is_contiguous():
+            return module(hidden,batch,defer_finalize=False)
+        bound = batch.moe_num_token_non_padded()
+        with torch.inference_mode():
+            self.rows.fill_(len(hidden))
+            self.bound.copy_(self.rows if bound is None else bound.reshape(()))
+            _stage[(self.width,5)](hidden,logits,shared,self.hidden,self.logits,self.shared,len(hidden))
+            if entry is None:
+                entry = self.capture(module,batch)
+                self.entries[module] = entry
+            entry.graph.replay()
+        partial = self.output[:len(hidden)]
+        if entry.checks < 2:
+            ordinary = module(hidden,batch,defer_finalize=False)
+            passed = TargetGraphs._all_ranks(torch.equal(ordinary,partial))
+            entry.checks += 1
+            entry.blocked = not passed
+            log.info("Staged short FFN graph check layer=%d bucket=%d rows=%d replay=%d exact=%s",
+                     module.layer_id,self.width,len(hidden),entry.checks,passed)
+            return ordinary
+        return partial.clone()
+
+
+def eligible(module,hidden):
+    shared = getattr(module,"shared_expert",None)
+    if (module.enable_shared_expert_fusion or module.alt_stream is not None
+            or module.shared_expert_gate is None or shared is None or not 0 <= module.layer_id < 48
+            or getattr(shared,"_enable_silu_fp4_quant_fusion",False) or not hidden.is_contiguous()):
+        return False
+    for proj,shape in ((module.gate,(512,2560)),(shared.gate_up_proj,(320,2560)),
+                       (shared.down_proj,(2560,160))):
+        if (proj.bias is not None or proj.weight.shape != shape
+                or proj.weight.dtype != hidden.dtype or proj.weight.device != hidden.device
+                or not proj.weight.is_contiguous()):
+            return False
+    return True
+
+
+def run(module,hidden,batch):
+    if not eligible(module,hidden):
+        return module(hidden,batch,defer_finalize=False)
+    width = 128 if len(hidden)<=128 else 256
+    key = (hidden.device,width)
+    region = _regions.get(key)
+    if region is None:
+        if not can_admit(hidden.device,("staged-short-ffn-rails",width)):
+            _regions[key] = False
+            return module(hidden,batch,defer_finalize=False)
+        region = _regions[key] = Regions(hidden,width)
+    return region.run(module,hidden,batch) if region else module(hidden,batch,defer_finalize=False)

+"""Own isolated XPU prefill residual rows on one TP rank through each HC stage."""
+
+import logging
+import os
+
+import torch.nn.functional as F
+
+from sglang.srt.layers import layernorm_sp
+from sglang.srt.layers.layer_boundary import get_attn_tp_context
+from sglang.srt.layers.moe.utils import get_moe_a2a_backend
+from sglang.srt.runtime_context import get_forward, get_parallel
+from sglang.srt.speculative import v6_target
+
+log = logging.getLogger(__name__)
+
+
+class WideHC:
+    def __init__(self, rows, group, reduction):
+        self.rows = rows
+        self.group = group
+        self.shard_rows = (rows + group.world_size - 1) // group.world_size
+        self.reduction = reduction
+
+    @classmethod
+    def create(cls, model, batch, hidden):
+        mode = os.getenv("SGLANG_FLASHNEXT_HC_ROW_SHARDS")
+        if mode not in ("reduce", "scatter") or not 512 <= hidden.shape[0] <= 4097:
+            return None
+        parallel = get_parallel()
+        if (
+            parallel.tp_size != 4 or parallel.moe_ep_size != 4
+            or parallel.attn_cp_size != 1 or parallel.attn_dp_size != 1
+            or get_forward().sp_active or get_attn_tp_context().input_scattered
+            or not get_moe_a2a_backend().is_none() or batch.flashnext_mixed is not None
+            or any(batch.lora_ids or ()) or batch.replace_embeds is not None
+            or batch.tbo_split_seq_index is not None
+            or os.getenv("SGLANG_FLASHNEXT_V6_PREFILL") != "1"
+            or (model.start_layer, model.end_layer) != (0, 48)
+            or model.hidden_size != 2560 or model.hc_count != 4
+        ):
+            if not getattr(model, "_flashnext_wide_row_guard_reported", False):
+                model._flashnext_wide_row_guard_reported = True
+                log.info(
+                    "Flash Next wide prefill HC ineligible rows=%d tp=%d ep=%d cp=%d dp=%d "
+                    "sp=%s input_scattered=%s a2a=%s mixed=%s lora=%s replaced=%s "
+                    "tbo=%s v6_prefill=%s layers=%s geometry=%s",
+                    hidden.shape[0], parallel.tp_size, parallel.moe_ep_size,
+                    parallel.attn_cp_size, parallel.attn_dp_size, get_forward().sp_active,
+                    get_attn_tp_context().input_scattered, get_moe_a2a_backend(),
+                    batch.flashnext_mixed is not None, any(batch.lora_ids or ()),
+                    batch.replace_embeds is not None, batch.tbo_split_seq_index,
+                    os.getenv("SGLANG_FLASHNEXT_V6_PREFILL"), (model.start_layer, model.end_layer),
+                    (model.hidden_size, model.hc_count),
+                )
+            return None
+        eligible = getattr(model, "_flashnext_wide_row_layout", None)
+        if eligible is None:
+            # These modules own partial tensor-parallel outputs. The row-stage
+            # reducer replaces the ordinary boundary immediately after each.
+            eligible = True
+            for layer in model.layers:
+                projection = layer.linear_attn.out_proj if hasattr(layer, "linear_attn") else layer.o_proj
+                if (projection.reduce_results or layer.mlp.reduce_results
+                        or layer.mlp.experts.reduce_results
+                        or not hasattr(layer.mlp.experts, "intel_cyclic_w4")
+                        or not hasattr(layer.attn_hyper_connection, "_v6_down")
+                        or not hasattr(layer.mlp_hyper_connection, "_v6_down")):
+                    eligible = False
+                    break
+            model._flashnext_wide_row_layout = eligible
+            log.info("Flash Next wide prefill HC rank=%d reduction=%s layout=%s",
+                     parallel.tp_group.rank_in_group, mode, eligible)
+        if eligible and not getattr(model, "_flashnext_short_hc_reported", False) and hidden.shape[0] < 2048:
+            model._flashnext_short_hc_reported = True
+            log.info("Flash Next row-sharded prefill short route lengths=%s mode=%s",
+                     batch.extend_seq_lens_cpu, batch.forward_mode)
+        if eligible and len(batch.extend_seq_lens_cpu) > 1 and not getattr(model, "_flashnext_hc_cohort_reported", False):
+            model._flashnext_hc_cohort_reported = True
+            log.info("Flash Next row-sharded prefill cohort lengths=%s mode=%s",
+                     batch.extend_seq_lens_cpu, batch.forward_mode)
+        return cls(hidden.shape[0], parallel.tp_group, mode) if eligible else None
+
+    def shard(self, value):
+        # Only the final owner can have fewer token rows. Padding before
+        # the split would copy the whole reduced activation on every rank.
+        start = self.group.rank_in_group * self.shard_rows
+        local = value[start : start + self.shard_rows]
+        missing = self.shard_rows - local.shape[0]
+        return F.pad(local, (0, 0, 0, missing)) if missing else local
+
+    def gather(self, value):
+        return layernorm_sp.all_gather_token_rows(value, total_rows=self.rows, group=self.group)
+
+    def reduce(self, partial):
+        if self.reduction == "scatter":
+            return layernorm_sp.reduce_scatter_token_rows(partial, group=self.group)
+        if self.rows * 2560 * 2 > 4 * 1024 * 1024:
+            from sglang.srt.speculative.checked_scatter import run
+            return run(self,partial)
+        return self.shard(self.group.all_reduce(partial))
+
+    def mix(self, module, residual, normalized):
+        # The full prefill used the native 32-row-tiled projection. Four rank
+        # shards retain that kernel even for local 128-256 row inputs.
+        return v6_target.hc_mix(module, residual, normalized, long_prefill=True)
+
+    def layer(self, layer, residual, normalized, next_norm, positions, batch, ple_batch):
+        if layer.ple is not None:
+            full = self.gather(residual)
+            embedding = layer.ple(full, batch, ple_batch)
+            del full
+            start = self.group.rank_in_group * self.shard_rows
+            live = min(self.shard_rows, self.rows - start)
+            # Sum only the rows this rank keeps. Recreate the original zero
+            # padding on the final rank, even if a padded input row is dirty.
+            residual = residual[:live] + embedding[start:start+live]
+            del embedding
+            if live < self.shard_rows:
+                residual = F.pad(residual, (0, 0, 0, self.shard_rows - live))
+            normalized = None
+        hidden, prior = self.mix(layer.attn_hyper_connection, residual, normalized)
+        hidden = self.gather(hidden)
+        if hasattr(layer, "linear_attn"):
+            partial = layer.linear_attn(hidden, batch)
+        else:
+            partial = layer.self_attention(positions, hidden, batch)
+        local = self.reduce(partial)
+        del hidden, partial
+        residual, normalized = v6_target.hc_combine_and_normalize(
+            local, prior, layer.mlp_hyper_connection.hc_norm,
+        )
+        del local, prior
+        hidden, prior = self.mix(layer.mlp_hyper_connection, residual, normalized)
+        partial = layer.mlp(self.gather(hidden), batch, defer_finalize=False)
+        return v6_target.hc_combine_and_normalize(self.reduce(partial), prior, next_norm)

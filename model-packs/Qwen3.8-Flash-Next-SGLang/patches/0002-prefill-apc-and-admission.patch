index 0000000000000000000000000000000000000000..2dc2a9382217272d3e7007c50d0979a8c33552a5
--- /dev/null
+++ b/python/sglang/srt/speculative/b70_checkpoints.py
@@ -0,0 +1,140 @@
+"""Preserve the 256-token APC donation inside a larger worker prefill."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+_active = ContextVar("b70_prefill_checkpoints", default=())
+POOL_STAGING = os.getenv("SGLANG_FLASHNEXT_PREFILL_WORKSPACE") == "1"
+
+
+@triton.jit
+def _copy_state_row(state, source, dest, STRIDE: tl.constexpr, SIZE: tl.constexpr):
+    offsets = tl.program_id(0) * 1024 + tl.arange(0, 1024)
+    src = tl.load(source).to(tl.int64)
+    dst = tl.load(dest).to(tl.int64)
+    values = tl.load(state + src * STRIDE + offsets, offsets < SIZE, other=0)
+    tl.store(state + dst * STRIDE + offsets, values, offsets < SIZE)
+
+
+@dataclass
+class Interior:
+    row: int
+    depth: int
+    offset: int
+    parts: dict = field(default_factory=dict)
+    reserved: torch.Tensor | None = None
+
+    def save(self, name, pool, data):
+        if self.reserved is None:
+            self._remember(name, pool, data.detach().clone())
+        else:
+            pool.index_copy_(0, self.reserved, data)
+            self._remember(name, pool, None)
+
+    def save_recurrence(self, name, state, owner):
+        if self.reserved is None:
+            # index_select returns fresh storage owned by this checkpoint.
+            self._remember(name, state, state.index_select(0, owner))
+        else:
+            size = state[0].numel()
+            _copy_state_row[(triton.cdiv(size, 1024),)](
+                state, owner, self.reserved, state.stride(0), size,
+            )
+            self._remember(name, state, None)
+
+    def save_exported_recurrence(self, name, state, scratch_row):
+        # The native producer already wrote the leased slot or the
+        # scratch allocation owned by this checkpoint.
+        self._remember(name, state, scratch_row)
+
+    def _remember(self, name, pool, data):
+        if name in self.parts:
+            raise RuntimeError(f"Duplicate B70 checkpoint component {name}")
+        self.parts[name] = (pool, data)
+
+    def snapshot(self, name):
+        pool, data = self.parts[name]
+        return pool.index_select(0, self.reserved) if data is None else data
+
+    def check_complete(self):
+        # Layer IDs can follow another dense-layer order; the state components
+        # must still cover all 36 distinct GDN layers and their convolutions.
+        gdn = {key[1] for key in self.parts if key[0]=="gdn"}
+        conv = {key[1] for key in self.parts if key[0]=="conv"}
+        if len(gdn)!=36 or conv!=gdn or len(self.parts)!=74:
+            raise RuntimeError(f"Incomplete B70 interior checkpoint: {sorted(self.parts)}")
+
+    def install(self, slot):
+        self.check_complete()
+        for pool,data in self.parts.values():
+            pool.index_copy_(0, slot.long(), data)
+
+    def take_reserved(self):
+        self.check_complete()
+        slot, self.reserved = self.reserved, None
+        return slot
+
+
+@contextmanager
+def collect(batch, *, stage_in_pool=False):
+    interior = []
+    if batch.tree_cache is not None and not batch.tree_cache.disable:
+        for row, (req, prefix, length) in enumerate(zip(batch.reqs,batch.prefix_lens,batch.extend_lens,strict=True)):
+            tracked = req.kv.mamba_last_track_seqlen
+            if tracked is None or req.skip_radix_cache_insert or req.session_id is not None:
+                continue
+            # Each former 1024-row pass donated its interior 256-token
+            # state and its aligned end. Keep the same donation points.
+            offsets = (
+                base + relative
+                for base in range(0, length, 1024)
+                for relative in ((0, 256) if base else (256,))
+            )
+            for offset in offsets:
+                depth = prefix + offset
+                if offset < length and depth < tracked and depth % 128 == 0:
+                    interior.append(Interior(row, depth, offset))
+    reserve, release = None, None
+    if (POOL_STAGING and stage_in_pool and len(interior) > 1
+            and len(batch.reqs) == 1 and batch.extend_lens[0] > 1024):
+        # Only borrow already-free slots. Tree insertion and eviction still
+        # happen at publish, after the prefill and draft consumers are ordered.
+        reserve_slots = getattr(batch.tree_cache, "reserve_b70_prefill_slots", None)
+        if reserve_slots is not None:
+            reserve, release = reserve_slots(len(interior))
+    if reserve is not None:
+        for item, slot in zip(interior, reserve.split(1), strict=True):
+            item.reserved = slot
+    token = _active.set(interior)
+    try:
+        yield interior
+    finally:
+        _active.reset(token)
+        if release is not None:
+            for item in interior:
+                if item.reserved is not None:
+                    release(item.reserved)
+                    item.reserved = None
+
+
+def active():
+    return _active.get()
+
+
+def publish(batch, checkpoints):
+    for item in checkpoints:
+        req = batch.reqs[item.row]
+        tree = batch.tree_cache
+        # Ordinary tree insertion takes ownership of the new checkpoint slot,
+        # deduplicates dense pages, and advances the request's real tree lock.
+        # Keep the later checkpoint that the scheduler has yet to publish.
+        old = req.kv.mamba_last_track_seqlen, req.kv.mamba_prev_track_seqlen
+        try:
+            tree.checkpoint(req, up_to=item.depth, b70_interior=item)
+        finally:
+            req.kv.mamba_last_track_seqlen, req.kv.mamba_prev_track_seqlen = old
diff --git a/python/sglang/srt/speculative/b70_prefill.py b/python/sglang/srt/speculative/b70_prefill.py

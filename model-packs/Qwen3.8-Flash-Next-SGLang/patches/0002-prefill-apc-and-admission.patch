diff --git a/python/sglang/srt/speculative/admission_copy.py b/python/sglang/srt/speculative/admission_copy.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b75927ca1baa5d5e3ee0cfa6b089c1f33fcf40f
--- /dev/null
+++ b/python/sglang/srt/speculative/admission_copy.py
@@ -0,0 +1,38 @@
+"""Copy exact packed-admission snapshots to host in bounded contiguous transfers."""
+
+import math
+
+import torch
+
+
+# A C4 GDN working-state layer is 3 MiB. Keep the temporary packing tensor
+# below 8 MiB independently of the number of model layers or active slots.
+PACK_BYTES = 8 * 1024 * 1024
+
+
+def copy_layers(source, owners=None):
+    shape = list(source.shape)
+    if owners is not None:
+        shape[1] = owners.numel()
+    dst = torch.empty(shape, device="cpu", dtype=source.dtype)
+    layer_bytes = source.element_size() * math.prod(shape[1:])
+    chunk = max(1, PACK_BYTES // max(1, layer_bytes))
+    if layer_bytes > PACK_BYTES:
+        # Full-matrix fallback rollback snapshots can exceed the bound per
+        # layer. Preserve the previous layer/owner transfer geometry there.
+        for offset, layer in enumerate(source.unbind()):
+            if owners is None:
+                dst[offset].copy_(layer)
+            else:
+                for row, slot in enumerate(owners.tolist()):
+                    dst[offset, row].copy_(layer[slot])
+        return dst
+    for first in range(0, shape[0], chunk):
+        last = min(first + chunk, shape[0])
+        group = source[first:last]
+        if owners is not None:
+            group = group.index_select(1, owners)
+        # Explicit compaction handles holes between source layers, as well
+        # as the transposed convolution cache; the host sees a single copy.
+        dst[first:last].copy_(group.contiguous())
+    return dst
diff --git a/python/sglang/srt/speculative/admission_pinned.py b/python/sglang/srt/speculative/admission_pinned.py
new file mode 100644
index 0000000000000000000000000000000000000000..f48251b74a42d15fd0b3103a18c3b86e5a51cecb
--- /dev/null
+++ b/python/sglang/srt/speculative/admission_pinned.py
@@ -0,0 +1,32 @@
+"""Stage exact strided layer/owner snapshots through one bounded pinned host rail."""
+
+import math
+import torch
+
+
+RAIL_BYTES = 8 * 1024 * 1024
+
+
+def copy_working(source, owners):
+    leaf_shape = tuple(source.shape[2:])
+    row_bytes = math.prod(leaf_shape) * source.element_size()
+    if row_bytes <= 0 or row_bytes > RAIL_BYTES or not source[0,0].is_contiguous():
+        return None
+    slots = len(owners)
+    count = source.shape[0] * slots
+    if count == 0:
+        return source.new_empty((source.shape[0], slots, *leaf_shape), device="cpu")
+    per_transfer = min(count, RAIL_BYTES // row_bytes)
+    output = torch.empty((count, *leaf_shape), device="cpu", dtype=source.dtype)
+    stage = torch.empty((per_transfer, *leaf_shape), device="cpu", dtype=source.dtype, pin_memory=True)
+    stream = torch.xpu.current_stream(source.device)
+    for first in range(0, count, per_transfer):
+        n = min(per_transfer, count-first)
+        for index in range(n):
+            layer, lane = divmod(first + index, slots)
+            stage[index].copy_(source[layer, owners[lane]], non_blocking=True)
+        # The worker is already on a synchronous admission path. Wait for
+        # these exact DMA writes before copying or recycling the host rail.
+        stream.synchronize()
+        output[first:first+n].copy_(stage[:n])
+    return output.view(source.shape[0], slots, *leaf_shape)
diff --git a/python/sglang/srt/speculative/b70_checkpoints.py b/python/sglang/srt/speculative/b70_checkpoints.py

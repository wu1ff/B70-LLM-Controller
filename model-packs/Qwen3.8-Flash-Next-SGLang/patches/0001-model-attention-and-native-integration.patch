diff --git a/python/sglang/srt/layers/quantization/a0042_packing.py b/python/sglang/srt/layers/quantization/a0042_packing.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b45ceb45dc50e8882737a033db09ce31ec1d229
--- /dev/null
+++ b/python/sglang/srt/layers/quantization/a0042_packing.py
@@ -0,0 +1,33 @@
+"""Bound CPU staging during the exclusive initial load of cyclic INT4 parameters."""
+import weakref
+import torch
+
+
+class Packing:
+    limit = 384 << 20
+    live = weakref.WeakSet()
+
+    def __init__(self, param):
+        self.param = param
+        self.host = torch.empty_like(param,device="cpu",pin_memory=False)
+        self.completed = 0
+        self.live.add(self)
+
+    @classmethod
+    def acquire(cls,param,source):
+        if (source.device.type != "cpu" or param.device.type != "xpu"
+                or not param.is_contiguous() or param.nbytes + sum(v.host.nbytes for v in cls.live) > cls.limit):
+            return None
+        return cls(param)
+
+    def finish_part(self, param, expected):
+        if self.param is not param:
+            raise RuntimeError("Cyclic packing parameter changed during initial load")
+        self.completed += 1
+        if self.completed < expected:
+            return False
+        if self.completed != expected:
+            raise RuntimeError("Cyclic packing received too many component tensors")
+        self.param.data.copy_(self.host)
+        self.live.discard(self)
+        return True

+
+
+class Program:
+    def __init__(self,graph,module):
+        self.graph=graph
+        tensors=(*module.parameters(),*module.buffers())
+        dynamic=(module.attn.conv_weights,module.attn.A_log,module.attn.dt_bias)
+        self.guard=Bindings(tuple(module.modules()),tensors,dynamic)
+        self.storage=tuple(v.detach() for v in tensors+dynamic)
+        self.checks=0
+        self.disabled=False
+
+
+class Bank:
+    def __init__(self,hidden):
+        self.stream=torch.xpu.current_stream(hidden.device)
+        self.pool=torch.xpu.graph_pool_handle()
+        self.programs=WeakKeyDictionary()
+        self.comparing=False
+        with torch.inference_mode(False),torch.no_grad():
+            self.x=hidden.new_zeros((128,2560))
+            self.y=torch.empty_like(self.x)
+            self.ba=hidden.new_zeros((128,24))
+            self.conv=hidden.new_zeros((1,2560,3))
+            self.state=self.conv.new_zeros((1,12,128,128),dtype=torch.float32)
+            self.zero=self.conv.new_zeros((1,),dtype=torch.int32)
+            self.offset=self.zero.new_tensor([0,128])
+            self.seed=self.zero.new_zeros((1,),dtype=torch.bool)
+
+    def capture(self,module,width):
+        layer=module.attn
+        self.offset[1].fill_(width)
+        self.seed.zero_()
+        def core():
+            raw,_=module.in_proj_qkvz(self.x[:width])
+            ba=self.ba[:width]
+            # The non-interleaved checkpoint order is Q,K,V,Z and B,A.
+            mixed=causal_conv1d_fn_xpu(raw[:,:2560].contiguous().T,layer.conv_weights.reshape(2560,4),
+                    None,conv_states=self.conv,cache_indices=self.zero,query_start_loc=self.offset,
+                    has_initial_state=self.seed,activation=layer.activation).T

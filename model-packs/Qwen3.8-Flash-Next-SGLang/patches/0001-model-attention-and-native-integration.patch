+        # output projection. Stage the original true-width result on every call.
+        ba,_=module.in_proj_ba(x)
+        torch._foreach_copy_([self.x[:n],self.ba[:n]],[x,ba])
+        self.offset.copy_(meta.query_start_loc)
+        if seeded:
+            self.state.copy_(state.index_select(0,owners))
+            self.conv.copy_(conv.index_select(0,owners))
+        entry.graph.replay()
+        value=self.y[:n]
+        if entry.checks<2:
+            self.comparing=True
+            try:
+                orig=module(x,batch)
+            finally:
+                self.comparing=False
+            outputs_ok=torch.equal(orig.view(torch.int16),value.view(torch.int16))
+            state_ok=torch.equal(state.index_select(0,owners).view(torch.int32),self.state.view(torch.int32))
+            conv_ok=torch.equal(conv.index_select(0,owners).view(torch.int16),self.conv.view(torch.int16))
+            same=outputs_ok and state_ok and conv_ok
+            entry.checks+=1
+            entry.disabled=not same
+            log.info("A0042 full GDN layer=%d width=%d rows=%d seed=%s check=%d output=%s state=%s conv=%s exact=%s",
+                     module.attn.layer_id,w,n,seeded,entry.checks,outputs_ok,state_ok,conv_ok,same)
+            return orig
+        state.index_copy_(0,owners,self.state)
+        conv.index_copy_(0,owners,self.conv)
+        return value.clone()
+
+
+@torch.inference_mode()
+def try_run(module,x,batch):
+    if (not isinstance(x,torch.Tensor) or x.ndim!=2 or x.shape[1]!=2560 or not 16<=len(x)<=128
+            or x.dtype!=torch.bfloat16 or not x.is_xpu or not x.is_contiguous()
+            or not batch.forward_mode.is_extend_without_speculative() or batch.extend_seq_lens_cpu!=[len(x)]
+            or not isinstance(batch.extend_prefix_lens_cpu,(tuple,list)) or len(batch.extend_prefix_lens_cpu)!=1
+            or batch.flashnext_mixed is not None or batch.return_logprob or batch.contains_mm_inputs()
+            or any(batch.lora_ids or ()) or batch.tbo_split_seq_index is not None
+            or batch.replace_embeds is not None or batch.input_embeds is not None or torch.xpu.is_current_stream_capturing()):
+        return None
+    from sglang.srt.model_executor.forward_context import get_attn_backend
+    from sglang.srt.layers.attention.linear.kernels.gdn_xpu import _ordered_prefill_enabled
+    backend=getattr(get_attn_backend(),"linear_attn_backend",None)
+    layer=module.attn
+    if (backend is None or backend.mis_metadata is not None or backend.prefill_graph_metadata is not None
+            or not _ordered_prefill_enabled() or backend.forward_metadata.has_mamba_track_mask
+            or backend.forward_metadata.conv_block_table is not None
+            or backend.forward_metadata.mamba_cache_indices.numel()!=1
+            or backend.forward_metadata.query_start_loc.numel()!=2 or module.out_proj.reduce_results
+            or layer.activation not in ("silu","swish") or layer.bias is not None
+            or layer.q_dim!=512 or layer.v_dim!=1536 or layer.conv_weights.numel()!=10240
+            or module._fused_in_proj_weight is not None or module.alt_stream is not None
+            or module._fused_input_proj_cpu_enabled.value
+            or module.in_proj_qkvz.weight.shape!=(4096,2560) or module.in_proj_ba.weight.shape!=(24,2560)):
+        return None
+    if x.device not in _banks:
+        _banks[x.device]=Bank(x) if can_admit(x.device,("short-whole-gdn-storage",128)) else None
+    bank=_banks[x.device]
+    if bank is None or bank.comparing or bank.stream!=torch.xpu.current_stream(x.device):
+        return None
+    return bank.run(module,x,batch,backend)

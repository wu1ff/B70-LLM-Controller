+        w=next(w for w in (16,32,64,96,128) if w>=n)
+        meta=backend.forward_metadata
+        cache=backend.state_layer_cache(module.attn.layer_id)
+        state,conv=cache.temporal,cache.conv[0]
+        if (state.shape[1:]!=(12,128,128) or state.dtype!=torch.float32
+                or conv.shape[1:]!=(2560,3) or conv.dtype!=torch.bfloat16):
+            return None

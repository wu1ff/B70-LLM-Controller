+"""Whole short GDN on a reusable private working slot. Only the selected row is published."""
+import logging
+from weakref import WeakKeyDictionary
+import torch
+from sgl_kernel.mamba import causal_conv1d_fn_xpu
+from sglang.srt.speculative.budget import can_admit
+from sglang.srt.speculative.short_regions import gdn_ops
+from sglang.srt.speculative.proposal_bindings import Bindings
+
+log=logging.getLogger(__name__)

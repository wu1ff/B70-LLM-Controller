+            b,a=ba.split(12,dim=1)
+            ops=gdn_ops(q.reshape(width,4,128),k.reshape(width,4,128),v.reshape(width,12,128),
+                        a,b,layer.A_log.reshape(12),layer.dt_bias.reshape(12))
+            out=torch.zeros_like(ops[2],memory_format=torch.contiguous_format)
+            torch.ops.flashnext_ordered.recurrent(*[t.contiguous() for t in ops],self.state,
+                            self.zero,self.offset,self.seed,None,None,0,out)
+            norm=module.norm(out.bfloat16().reshape(-1,128),raw[:,2560:].reshape(-1,128))
+            self.y[:width].copy_(module.out_proj(norm.reshape(width,1536))[0])

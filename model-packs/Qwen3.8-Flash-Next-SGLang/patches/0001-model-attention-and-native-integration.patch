+# SPDX-License-Identifier: Apache-2.0
+"""XPU launch adapter for vLLM's BF16 hc_silu and FP32 hc_gate_mix."""
+import torch
+import triton
+import triton.language as tl
+
+from vllm.models.qwen4_exp.nvidia.ops.hc import hc_gate_mix
+
+
+@triton.jit
+def _silu(x, out, stride: tl.constexpr, columns: tl.constexpr, streams: tl.constexpr, block: tl.constexpr):
+    row = tl.program_id(0)
+    index = tl.arange(0, block)
+    value = tl.load(x + row*stride + index, mask=index<columns, other=0).to(tl.float32) / streams
+    tl.store(out + row*columns + index, value * tl.sigmoid(value), mask=index<columns)
+
+
+def hc_silu(x, streams):
+    # Equivalent to vLLM's nvidia/ops/hc.py _hc_silu_kernel on Xe2 (no PDL).
+    # Resolve next_power_of_2 on the host. SGLang's installed Triton frontend
+    # rejects a Python function reference inside this constexpr expression.
+    rows,columns = x.shape
+    out = torch.empty_like(x, memory_format=torch.contiguous_format)
+    _silu[(rows,)](x,out,x.stride(0),columns,streams,triton.next_power_of_2(columns))
+    return out

index 0000000000000000000000000000000000000000..6814fc44600c6c68729811d979f49b51ee7613ca
--- /dev/null
+++ b/python/sglang/srt/speculative/gdn_factors.py
@@ -0,0 +1,71 @@
+"""Materialize accepted GDN states from exact FP32 per-step update operands."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _fold(
+    working, records, owners, steps, track_owners, track_steps, snapshots,
+    WORK_LAYER: tl.constexpr, WORK_SLOT: tl.constexpr,
+    RECORD_LAYER: tl.constexpr, RECORD_REQUEST: tl.constexpr, RECORD_STEP: tl.constexpr,
+    OUTPUT_REQUEST: tl.constexpr, OUTPUT_STEP: tl.constexpr,
+    TRACK: tl.constexpr, ALL: tl.constexpr, TILE_ROWS: tl.constexpr,
+):
+    layer = tl.program_id(0).to(tl.int64)
+    row = tl.program_id(1)
+    tile = tl.program_id(2)
+    head = tile // (128 // TILE_ROWS)
+    values = tile % (128 // TILE_ROWS) * TILE_ROWS + tl.arange(0, TILE_ROWS)
+    keys = tl.arange(0, 128)
+    offsets = head * 128 * 128 + values[:, None] * 128 + keys[None, :]
+    slot = tl.load(owners + row).to(tl.int64)
+    base = working + layer * WORK_LAYER
+    state = tl.load(base + slot * WORK_SLOT + offsets)
+    record = records + layer * RECORD_LAYER + row * RECORD_REQUEST + head * 257
+    if ALL:
+        end = 8
+    else:
+        end = tl.load(steps + row) + 1
+    if TRACK:
+        checkpoint = tl.load(track_steps + row)
+        tracking_slot = tl.load(track_owners + row).to(tl.int64)
+    for t in range(end):
+        operands = record + t * RECORD_STEP
+        k = tl.load(operands + keys)
+        delta = tl.load(operands + 128 + values)
+        decay = tl.load(operands + 256)
+        # The installed SYCL binary rounds the innovation product first and
+        # contracts decay * state + innovation. Check each step against that
+        # binary; the opposite contraction differs by individual FP32 words.
+        state = tl.fma(state, decay, k[None, :] * delta[:, None])
+        if ALL:
+            tl.store(snapshots + row * OUTPUT_REQUEST + t * OUTPUT_STEP + offsets, state)
+        if TRACK:
+            if t == checkpoint and tracking_slot >= 0:
+                tl.store(base + tracking_slot * WORK_SLOT + offsets, state)
+    if not ALL:
+        if end > 0:
+            tl.store(base + slot * WORK_SLOT + offsets, state)
+
+
+def commit(caches, owners, steps, track_owners, track_steps):
+    live, records = caches.temporal, caches.intermediate_ssm
+    assert live.dtype == records.dtype == torch.float32
+    assert live.shape[-3:] == records.shape[-3:] == (12, 128, 128)
+    assert records.shape[2] == 8
+    _fold[(live.shape[0], owners.numel(), 12 * 16)](
+        live, records, owners, steps, track_owners, track_steps, None,
+        *live.stride()[:2], *records.stride()[:3], 0, 0,
+        track_owners is not None, False, 8,
+    )
+
+
+def expand_layer(live, records, owners, out):
+    """Admission and diagnostics use all eight steps, without updating live slots."""
+    _fold[(1, owners.numel(), 12 * 16)](
+        live, records, owners, None, None, None, out,
+        0, live.stride(0), 0, *records.stride()[:2], *out.stride()[:2],
+        False, True, 8,
+    )
diff --git a/python/sglang/srt/speculative/v6_gdn.py b/python/sglang/srt/speculative/v6_gdn.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0cdd04fc8607580b5ca9adc832a92e0d37bf321
--- /dev/null
+++ b/python/sglang/srt/speculative/v6_gdn.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Adapt v6 native speculative GDN to SGLang's owned rollback snapshots."""
+from functools import cache
+import hashlib
+import os
+from pathlib import Path
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.speculative.b70_prefill import load
+
+
+@cache
+def direct_seed_enabled():
+    if os.getenv("SGLANG_FLASHNEXT_NATIVE_GDN_SEED") != "1":
+        return False
+    library = Path("/opt/flashnext/a0035/libflashnext_gdn_seed.so")
+    if hashlib.sha256(library.read_bytes()).hexdigest() != "55273afa3e43274bacfe3abfa643f8884277409d81cdf143afa01523a85dc31d":
+        raise RuntimeError(f"Unexpected packed GDN seed library at {library}")
+    torch.ops.load_library(str(library))
+    return True
+
+
+@cache
+def prepared_enabled():
+    if os.getenv("SGLANG_FLASHNEXT_PREPARED_GDN") != "1":
+        return False
+    torch.ops.load_library("/opt/flashnext/a0037/liba0037_gdn_prepare.so")
+    return True
+
+
+@triton.jit
+def _seed_verify(working, snapshots, working_conv, history, owners,
+                 STATE_STRIDE: tl.constexpr, STATE: tl.constexpr, STATE_TILES: tl.constexpr,
+                 CONV_OWNER: tl.constexpr, CONV_CHANNEL: tl.constexpr,
+                 CONV_TIME: tl.constexpr, CHANNELS: tl.constexpr):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    lane = tl.arange(0, 1024)
+    owner = tl.load(owners + row).to(tl.int64)
+    if STATE_TILES > 0 and tile < STATE_TILES:
+        offset = tile * 1024 + lane
+        values = tl.load(working + owner * STATE_STRIDE + offset, offset < STATE, 0)
+        tl.store(snapshots + row * 8 * STATE + offset, values, offset < STATE)
+    else:
+        offset = (tile - STATE_TILES) * 1024 + lane
+        channel = offset % CHANNELS
+        time = offset // CHANNELS
+        conv_values = tl.load(working_conv + owner * CONV_OWNER + channel * CONV_CHANNEL
+                         + time * CONV_TIME, time < 3, 0)
+        tl.store(history + row * 80 * CHANNELS + offset, conv_values, time < 3)
+
+
+@triton.jit
+def _stage_verify_conv(working, history, projection, rollback, owners,
+                       CONV_OWNER: tl.constexpr, CONV_CHANNEL: tl.constexpr,
+                       CONV_TIME: tl.constexpr, CHANNELS: tl.constexpr,
+                       PROJECTION: tl.constexpr, SAVE_ROW: tl.constexpr,
+                       SAVE_TOKEN: tl.constexpr, SAVE_CHANNEL: tl.constexpr,
+                       SAVE_TIME: tl.constexpr):
+    row = tl.program_id(0)
+    offset = tl.program_id(1) * 512 + tl.arange(0, 512)
+    channel = offset % CHANNELS
+    time = offset // CHANNELS
+    owner = tl.load(owners + row).to(tl.int64)
+    working_base = working + owner * CONV_OWNER + channel * CONV_CHANNEL
+    seed = tl.load(working_base + time * CONV_TIME, time < 3, 0)
+    tl.store(history + row * 80 * CHANNELS + offset, seed, time < 3)
+    # The donor convolution rolls its original BF16 inputs by one position
+    # per token. Stage all post-token rollback windows from those same words.
+    destination = rollback + row * SAVE_ROW + channel * SAVE_CHANNEL + time * SAVE_TIME
+    for token in tl.static_range(8):
+        position = token + time + 1
+        previous = tl.load(working_base + position * CONV_TIME,
+                           (position < 3) & (time < 3), 0)
+        current = tl.load(projection + (row * 8 + position - 3) * PROJECTION + channel,
+                          (position >= 3) & (time < 3), 0)
+        tl.store(destination + token * SAVE_TOKEN,
+                 tl.where(position < 3, previous, current), time < 3)
+
+
+class SpeculativeGDN:
+    direct_seed = False
+    factor_output = False
+
+    def __init__(self, requests, offsets, owners):
+        self.requests = requests
+        self.offsets = offsets
+        self.owners = owners
+        self.tokens = torch.arange(8 * requests, dtype=torch.int32, device=owners.device)
+        self.indices = self.tokens.view(requests, 8)
+        # The working seed is copied to column zero. The native verifier reads
+        # it before overwriting column zero and writing the remaining snapshots.
+        self.seed_column = torch.ones(requests, dtype=torch.int32, device=owners.device)
+        self.conv = torch.empty((8 * requests, 10, 2560), dtype=torch.bfloat16, device=owners.device)
+        load("gdn_index64")
+
+    def projected_forward(self, module, backend, hidden_states, forward_batch):
+        # The stored Q/K/V/Z and B/A bands already match the donor's
+        # non-interleaved projection ABI. The native convolution emits Z.
+        assert forward_batch.forward_mode.is_target_verify()
+        qkvz, ba = module._forward_input_proj(hidden_states)
+        layer = module.attn
+        cache = backend.state_layer_cache(layer.layer_id)
+        out, z = self._verify(layer, qkvz, ba, cache)
+        normalized = module.norm(out.flatten(0, 1), z.flatten(0, 1))
+        return module.out_proj(normalized.reshape(qkvz.shape[0], -1))[0]
+
+    def _verify(self, layer, qkvz, ba, cache):
+        n = self.requests
+        assert qkvz.shape == (8 * n, 4096) and qkvz.dtype == torch.bfloat16
+        assert ba.shape == (8 * n, 24) and ba.dtype == qkvz.dtype
+        working_conv = cache.conv[0]
+        working_ssm = cache.temporal
+        snapshots = cache.intermediate_ssm[:n]
+        assert snapshots.is_contiguous() and snapshots.shape[1:] == (8, 12, 128, 128)
+        assert snapshots.dtype == working_ssm.dtype == torch.float32
+        assert working_ssm[0].is_contiguous() and working_conv.dtype == torch.bfloat16
+        owners = self.owners[:n]
+        history = self.conv[::8]
+        # Seed native convolution history and FP32 recurrence directly from
+        # the working slots. The donor writes each of the eight rollback rows.
+        state_elements = snapshots[0, 0].numel()
+        channels = working_conv.shape[1]
+        rollback = cache.intermediate_conv_window[0][:n]
+        projected = qkvz.contiguous()
+        fused_conv = self.direct_seed and os.getenv("SGLANG_FLASHNEXT_ROUND_PIPELINE") == "1"
+        if (fused_conv and self.factor_output and layer.activation in ("silu", "swish")
+                and prepared_enabled()):
+            return torch.ops.a0037_gdn_prepare.verify(
+                projected, ba.contiguous(), layer.conv_weights.contiguous().view(2560, 4),
+                layer.bias, layer.A_log.float().reshape(-1).contiguous(),
+                layer.dt_bias.reshape(-1).contiguous(), working_conv, rollback,
+                working_ssm, snapshots.flatten(0, 1), owners, self.offsets,
+                self.tokens, self.indices,
+            )
+        if fused_conv:
+            _stage_verify_conv[(n, triton.cdiv(3 * channels, 512))](
+                working_conv, self.conv, projected, rollback, owners,
+                *working_conv.stride(), channels, projected.stride(0), *rollback.stride(),
+                num_warps=4,
+            )
+        else:
+            state_tiles = 0 if self.direct_seed else triton.cdiv(state_elements, 1024)
+            _seed_verify[(n, state_tiles + triton.cdiv(3 * channels, 1024))](
+                working_ssm, snapshots, working_conv, self.conv, owners,
+                working_ssm.stride(0), state_elements, state_tiles, *working_conv.stride(), channels,
+            )
+        z = qkvz.new_empty((8 * n, 12, 128))
+        ops = torch.ops._gdn_index64
+        parts = ops.causal_conv1d_spec(
+            z, projected, ba.contiguous(), 16, 48, 128, 128, self.conv,
+            layer.conv_weights.contiguous(), layer.bias, layer.activation,
+            0, 0, n, self.offsets, self.tokens, self.indices, self.seed_column, 8 * n, 4, True,
+        )
+        if not fused_conv:
+            # The donor rolls history into [old_1, old_2, x_0, ..., x_7].
+            rollback.copy_(history.unfold(1, 3, 1))
+        out = torch.empty_like(z)
+        a_log = layer.A_log.float().reshape(-1).contiguous()
+        bias = layer.dt_bias.reshape(-1).contiguous()
+        if self.direct_seed:
+            verify = (torch.ops.flashnext_gdn_factors.verify if self.factor_output
+                      else torch.ops.flashnext_gdn_seed.verify)
+            verify(
+                out, *parts, a_log, bias, snapshots.flatten(0, 1), working_ssm,
+                owners, self.offsets, self.tokens, self.indices,
+            )
+        else:
+            ops.gated_delta_rule_spec(
+                out, *parts, 48, 128, a_log, bias, snapshots.flatten(0, 1),
+                0, 0, n, self.offsets, self.tokens, self.indices, self.seed_column, 8 * n, 4,
+            )
+        return out, z
diff --git a/python/sglang/srt/speculative/v6_target.py b/python/sglang/srt/speculative/v6_target.py
new file mode 100644
index 0000000000000000000000000000000000000000..d2f0f1188c09d740cd8c130f79f9bb731237d3e6
--- /dev/null
+++ b/python/sglang/srt/speculative/v6_target.py
@@ -0,0 +1,267 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Adapters for the accepted B70 v6 short target arithmetic."""
+from functools import cache
+import hashlib
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+import triton
+import triton.language as tl
+
+from sglang.srt.speculative.b70_hc import hc_silu, hc_gate_mix
+
+
+@cache
+def load_native():
+    from sglang.srt.speculative.b70_prefill import LIBDIR
+
+    digests = {
+        "b70_exact_v1": "be4e6e756afd5852cefee188f5cce56a18d5caf5eccc3d26b0e6c099123ad1fa",
+        "b70_exact_moe_v3": "20691aa32d8b61d9e1f907be92f0115960199a6a296ad14762396b218654aaaa",
+        "b70_ordered_hc_v2": "4ddb9a938ce6f415b9b0ae2c0486e04e3f74a358d9c3448381c52672f6db1ce6",
+        "astra_hc": "2fdda680027db5d730ae9b9ed0098f0db4b97d83a6bc2fe27e55331e1756c44c",
+    }
+    for name, digest in digests.items():
+        library = Path(LIBDIR, f"lib{name}.so")
+        if hashlib.sha256(library.read_bytes()).hexdigest() != digest:
+            raise RuntimeError(f"Unexpected v6 target library {library}")
+        torch.ops.load_library(str(library))
+    import vllm_xpu_kernels._moe_C  # registers the donor softmax router
+
+
+@triton.jit
+def _hc_norm(x, weight, out, row_stride, EPS: tl.constexpr):
+    row = tl.program_id(0)
+    stream = tl.program_id(1)
+    offsets = stream * 2560 + tl.arange(0, 4096)
+    mask = tl.arange(0, 4096) < 2560
+    values = tl.load(x + row * row_stride + offsets, mask, 0).to(tl.float32)
+    w = tl.load(weight + offsets, mask, 0).to(tl.float32)
+    normalized = values * tl.rsqrt(tl.sum(values * values) / 2560 + EPS)
+    # Match the selected donor affine expression and BF16 store.
+    tl.store(out + row * 10240 + offsets, normalized + normalized * w, mask)
+
+
+@triton.jit
+def _hc_inject(block, residual, gate, output, block_stride, residual_stride, gate_stride,
+               QUARTER_ROWS: tl.constexpr):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    columns = tile * 512 + tl.arange(0, 512)
+    streams = tl.arange(0, 4)
+    offsets = streams[:, None] * 2560 + columns[None, :]
+    injection = tl.load(gate + row * gate_stride + streams).to(tl.float32)
+    injection = 2.0 * tl.sigmoid(injection / 4)
+    if QUARTER_ROWS:
+        block_offsets = (columns // 640 * QUARTER_ROWS + row) * 640 + columns % 640
+    else:
+        block_offsets = row * block_stride + columns
+    values = tl.load(block + block_offsets).to(tl.float32)
+    prior = tl.load(residual + row * residual_stride + offsets).to(tl.float32)
+    tl.store(output + row * 10240 + offsets, prior + values[None, :] * injection[:, None])
+
+
+@triton.jit
+def _hc_inject_norm(block, residual, gate, weight, output, normalized,
+                    block_stride, residual_stride, gate_stride, EPS: tl.constexpr,
+                    QUARTER_ROWS: tl.constexpr):
+    row = tl.program_id(0)
+    stream = tl.program_id(1)
+    columns = tl.arange(0, 4096)
+    active = columns < 2560
+    offsets = stream * 2560 + columns
+    injection = tl.load(gate + row * gate_stride + stream).to(tl.float32)
+    scale = 2.0 * tl.sigmoid(injection / 4)
+    if QUARTER_ROWS:
+        block_offsets = (columns // 640 * QUARTER_ROWS + row) * 640 + columns % 640
+    else:
+        block_offsets = row * block_stride + columns
+    values = tl.load(block + block_offsets, active, 0).to(tl.float32)
+    prior = tl.load(residual + row * residual_stride + offsets, active, 0).to(tl.float32)
+    combined = (prior + values * scale).to(tl.bfloat16)
+    tl.store(output + row * 10240 + offsets, combined, active)
+    values = combined.to(tl.float32)
+    norm = values * tl.rsqrt(tl.sum(values * values) / 2560 + EPS)
+    affine = tl.load(weight + offsets, active, 0).to(tl.float32)
+    tl.store(normalized + row * 10240 + offsets, norm + norm * affine, active)
+
+
+# This specializes the accepted fused HC norm to this checkpoint's HC4
+# geometry. Literal tile sizes keep host utility functions out of XPU JIT.
+@triton.jit
+def _hc_inject_norm_tree(block, residual, gate, weight, output, normalized,
+                         block_stride, residual_stride, gate_stride, EPS: tl.constexpr):
+    pid = tl.program_id(0)
+    row = pid // 4
+    stream = pid % 4
+    streams = tl.arange(0, 4)
+    columns = tl.arange(0, 8)[:, None] * 512 + tl.arange(0, 512)[None, :]
+    active = columns < 2560
+    offsets = stream * 2560 + columns
+
+    prior = tl.load(residual + row * residual_stride + offsets, active, 0.0)
+    gates = tl.load(gate + row * gate_stride + streams)
+    values = tl.load(block + row * block_stride + columns, active, 0.0)
+    gates = 2.0 * tl.sigmoid(gates.to(tl.float32) / 4)
+    injected = values.to(tl.float32) * tl.sum(tl.where(streams == stream, gates, 0.0))
+    combined = (prior.to(tl.float32) + injected).to(tl.bfloat16)
+    tl.store(output + row * 10240 + offsets, combined, active)
+
+    values = combined.to(tl.float32)
+    sum_sq = tl.sum(tl.sum(values * values, axis=1), axis=0)
+    rrms = tl.rsqrt(sum_sq / 2560 + EPS)
+    affine = tl.load(weight + offsets, active, 0.0)
+    value = values * rrms
+    value += value * affine.to(tl.float32)
+    tl.store(normalized + row * 10240 + offsets, value, active)
+
+
+@triton.jit
+def _pack_expert_sum(routed, shared, quarters, ROWS: tl.constexpr):
+    row = tl.program_id(0)
+    rank = tl.program_id(1)
+    columns = tl.arange(0, 1024)
+    active = columns < 640
+    offsets = row * 2560 + rank * 640 + columns
+    left = tl.load(routed + offsets, active, 0).to(tl.float32)
+    right = tl.load(shared + offsets, active, 0).to(tl.float32)
+    tl.store(quarters + (rank * ROWS + row) * 640 + columns,
+             left + right, active)
+
+
+def expert_sum_quarters(routed, shared):
+    rows = routed.shape[0]
+    assert shared.shape == routed.shape == (rows, 2560)
+    assert routed.is_contiguous() and shared.is_contiguous()
+    quarters = routed.new_empty((4, rows, 640))
+    _pack_expert_sum[(rows, 4)](routed, shared, quarters, rows)
+    return quarters
+
+
+def hc_norm(module, x):
+    assert module.group_size == 2560 and x.shape[1] == 10240 and x.stride(1) == 1
+    out = x.new_empty(x.shape)
+    _hc_norm[(x.shape[0], 4)](x, module.weight, out, x.stride(0), module.variance_epsilon)
+    return out
+
+
+def hc_mix(module, x, normalized_input=None, *, long_prefill=False):
+    normalized = hc_norm(module.hc_norm, x) if normalized_input is None else normalized_input
+    down = getattr(module, "_v6_down", module.input_mix_weight_down.weight)
+    valid = 324 if down.shape[0] == 336 else 320
+    if long_prefill or x.shape[0] > 256:
+        from sglang.srt.speculative.b70_prefill import load
+
+        load("long_hc")
+        if normalized.shape[0] <= 1024:
+            low = torch.ops.long_hc.forward(normalized, down, valid, 1)
+        else:
+            low = torch.cat([
+                torch.ops.long_hc.forward(tile, down, valid, 1)
+                for tile in normalized.split(1024)
+            ])
+    else:
+        low = torch.ops.b70_ordered_hc_v2.forward(
+            normalized, down, valid, 10 if x.shape[0] == 32 else 20
+        )
+    activation = hc_silu(low[:, :320], 4)
+    up = module.input_mix_weight_up.weight
+    if x.shape[0] <= 8:
+        mixed = x.new_empty((x.shape[0], 2560))
+        torch.ops.astra_hc_v3.up(activation, up, normalized, mixed)
+    else:
+        mixed = hc_gate_mix(normalized, F.linear(activation, up), 4)
+    injection = low[:, 320:324] if valid == 324 else None
+    return mixed, (x, normalized, injection)
+
+
+def hc_combine(block, residuals, *, quarter_rows=0):
+    residual, _, injection = residuals
+    assert block.stride(1) == residual.stride(1) == injection.stride(1) == 1
+    out = residual.new_empty(residual.shape)
+    _hc_inject[(block.shape[0], 5)](
+        block, residual, injection, out, block.stride(0), residual.stride(0),
+        injection.stride(0), quarter_rows,
+    )
+    return out
+
+
+def hc_combine_and_normalize(block, residuals, next_norm, *, quarter_rows=0):
+    if next_norm is None:
+        return hc_combine(block, residuals, quarter_rows=quarter_rows), None
+    residual, _, injection = residuals
+    assert block.stride(1) == residual.stride(1) == injection.stride(1) == 1
+    assert next_norm.group_size == 2560 and next_norm.weight.numel() == 10240
+    out = residual.new_empty(residual.shape)
+    normalized = torch.empty_like(out)
+    if not quarter_rows and block.shape[0] >= 128:
+        _hc_inject_norm_tree[(block.shape[0] * 4,)](
+            block, residual, injection, next_norm.weight, out, normalized,
+            block.stride(0), residual.stride(0), injection.stride(0), next_norm.variance_epsilon,
+        )
+        return out, normalized
+    _hc_inject_norm[(block.shape[0], 4)](
+        block, residual, injection, next_norm.weight, out, normalized,
+        block.stride(0), residual.stride(0), injection.stride(0),
+        next_norm.variance_epsilon, quarter_rows,
+    )
+    return out, normalized
+
+
+def route(logits, renormalize):
+    """Emit the compact route table used by the selected cyclic consumer."""
+    weights = logits.new_empty((logits.shape[0], 10), dtype=torch.float32)
+    ids = logits.new_empty(weights.shape, dtype=torch.int32)
+    token_expert_indices = torch.empty_like(ids)
+    torch.ops._moe_C.topk_softmax(weights, ids, token_expert_indices, logits, renormalize, None, None)
+    return weights, ids
+
+
+def packed_moe(block, hidden, forward_batch=None, defer_finalize=False, *,
+               fallback, defer_shared_add=None, native_shared_experts=None):
+    from sglang.srt.layers.moe.topk import StandardTopKOutput
+    from sglang.srt.models.qwen2_moe import reduce_moe_output
+
+    shared = block.shared_expert
+    wr = block.gate.weight
+    wgu = shared.gate_up_proj.weight
+    wd = shared.down_proj.weight
+    we = block.shared_expert_gate.weight
+    if (
+        defer_finalize or block.enable_shared_expert_fusion
+        or hidden.shape not in ((8, 2560), (16, 2560), (24, 2560), (32, 2560))
+        or hidden.data_ptr() % 64 != 0 or not hidden.is_contiguous()
+        or hidden.dtype != torch.bfloat16 or hidden.device.type != "xpu"
+        or (wr.shape, wgu.shape, wd.shape, we.shape) != ((512, 2560), (320, 2560), (2560, 160), (1, 2560))
+        or not all(w.is_contiguous() and w.dtype == hidden.dtype and w.device == hidden.device
+                   for w in (wr, wgu, wd, we))
+    ):
+        return fallback(hidden, forward_batch, defer_finalize)
+    router, activation, gate = torch.ops.b70_exact_moe_v3.front(hidden, wr, wgu, we)
+    weights, ids = route(router, block.topk.topk_config.renormalize)
+    topk = StandardTopKOutput(weights, ids, router)
+    if (
+        native_shared_experts is not None
+        and not block.reduce_results and not block.experts.reduce_results
+    ):
+        shared = torch.ops.b70_exact_moe_v3.back(activation, wd, gate, hidden, False)
+        return native_shared_experts(block.experts, hidden, topk, shared)
+    routed = block.experts(hidden, topk)
+    shared_output = torch.ops.b70_exact_moe_v3.back(activation, wd, gate, hidden, False)
+    if defer_shared_add is not None and not block.reduce_results:
+        return defer_shared_add(routed, shared_output)
+    routed.add_(shared_output)
+    return reduce_moe_output(routed) if block.reduce_results else routed
+
+
+def ba_projection(module, fallback, x, *args, **kwargs):
+    weight = module.weight
+    if (
+        args or kwargs or module.bias is not None or not 9 <= x.shape[0] <= 32
+        or x.shape[1] != 2560 or weight.shape != (24, 2560)
+        or x.device.type != "xpu" or x.dtype != weight.dtype or x.dtype != torch.bfloat16
+        or not x.is_contiguous() or not weight.is_contiguous()
+    ):
+        return fallback(x, *args, **kwargs)
+    return torch.ops.b70_exact_v1.gemm(x, weight, 1, 3), None

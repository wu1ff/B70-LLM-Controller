index 0000000000000000000000000000000000000000..e3e7ba62fcec1b42ac0bd0fe3799bdb9e6f6934f
--- /dev/null
+++ b/python/sglang/srt/speculative/proposal.py
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One conditional K7 proposal walk, adapted from the v6 CandidateSampler."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _walk(ids, scores, uniforms, temperatures, greedy, tokens, q_rows,
+          unary_logits, calibration, steps: tl.constexpr, support: tl.constexpr,
+          CALIBRATE: tl.constexpr):
+    row = tl.program_id(0)
+    choices = tl.arange(0, support)
+    temperature = tl.load(temperatures + row)
+    is_greedy = tl.load(greedy + row)
+    previous = 0
+    for step in range(steps):
+        flat = row * steps + step
+        scores_start = (flat * support + previous) * support
+        realized = tl.load(scores + scores_start + choices).to(tl.float32)
+        if CALIBRATE:
+            # Only the realized predecessor conditions this draw and its q.
+            # Match the four original FP32 ops with contraction disabled.
+            unary = tl.load(unary_logits + flat * support + choices)
+            unary_scale = tl.load(calibration + step * 2)
+            edge_scale = tl.load(calibration + step * 2 + 1)
+            realized = unary * unary_scale + (realized - unary) * edge_scale
+        if is_greedy:
+            selected = tl.argmax(realized, axis=0, tie_break_left=True)
+            probs = (choices == selected).to(tl.float32)
+        else:
+            scaled = tl.div_rn(realized, temperature)
+            mass = tl.exp(scaled - tl.max(scaled, axis=0))
+            probs = tl.div_rn(mass, tl.sum(mass, axis=0))
+            cumulative = tl.cumsum(probs, axis=0)
+            draw = tl.load(uniforms + flat)
+            selected = tl.min(tl.where(
+                (draw < cumulative) & (probs > 0), choices, support,
+            ), axis=0)
+            if selected == support:
+                # FP32 normalization and scan can leave a rounded CDF
+                # slightly below one. Its tail belongs to the last token
+                # of positive mass, even when later logits underflow.
+                selected = tl.max(tl.where(probs > 0, choices, 0), axis=0)
+        tl.store(q_rows + flat * support + choices, probs)
+        token = tl.load(ids + flat * support + selected)
+        tl.store(tokens + flat, token)
+        previous = selected
+
+
+def realized_proposals(candidate_ids, scores, uniforms, temperatures, greedy_mask,
+                       *, unary_logits=None, calibration=None):
+    """Use one FP32 realized probability row for both drawing and verification."""
+    batch, steps, support = candidate_ids.shape
+    if steps != 7 or support != 16:
+        raise ValueError("Flash Next proposal walk requires K7 and 16 candidates")
+    if (unary_logits is None) != (calibration is None):
+        raise ValueError("Selector calibration requires both unary logits and coefficients")
+    tokens = torch.empty((batch, steps), dtype=torch.int64, device=scores.device)
+    q_rows = torch.empty((batch, steps, support), dtype=torch.float32, device=scores.device)
+    _walk[(batch,)](
+        candidate_ids.contiguous(), scores.contiguous(), uniforms.contiguous(),
+        temperatures.contiguous(), greedy_mask.contiguous(), tokens, q_rows,
+        unary_logits.contiguous() if unary_logits is not None else None, calibration,
+        steps, support, calibration is not None,
+        num_warps=1, enable_fp_fusion=False,
+    )
+    return tokens, q_rows

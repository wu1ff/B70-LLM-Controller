+"""Consume a certified, already completed draft without rebuilding its attention batch."""
+import logging
+import torch
+
+
+def consume(worker,batch,grant,draft,prepared,ticket):
+    if (worker._draft_sampler is not None or worker._info_dumper.enabled
+            or prepared is None or prepared[0] is not ticket.grant
+            or prepared[1] is not draft or prepared[3] is None):
+        return None
+    # take() agreed on the immediately following iteration, ordered requests,
+    # slot generations, page extent, device length identity, weights and mapping.
+    # Only the target still needs an iteration plan at the new scheduler grant.
+    worker._flashnext_prepared_draft=None
+    worker._join_aux()
+    _,positions,addresses=prepared[2]
+    writes=addresses.reshape(-1)
+    plan=worker.target_worker.model_runner.runner_ids.plan(
+        req_pool_indices=batch.req_pool_indices,seq_lens=batch.seq_lens,
+        seq_lens_cpu=batch.seq_lens_cpu,write_virtual=writes,read_extent=8)
+    pages=worker.draft_model.b70_pages
+    pages.make_resident(ticket.coverage[2])
+    physical=[(plan,writes,ticket.writes,pages.mapping_generation)]
+    _,support,q=ticket.output
+    worker._selector_sample=None if batch.sampling_info is None or batch.sampling_info.is_all_greedy else (support,q)
+    worker._draft_feature=worker._draft_confidence=None
+    worker._a0041_current_ple=getattr(ticket,"ple",None)
+    if not hasattr(worker,"_a0041_direct_checks"):
+        worker._a0041_direct_checks = {}
+    n=len(batch.reqs)
+    checks=worker._a0041_direct_checks.get(n,0)
+    if checks<2:
+        from sglang.srt.hardware_backend.xpu.graph_runner.flashnext_target import TargetGraphs
+        expected_pos=batch.seq_lens[:,None]+torch.arange(8,device=writes.device)
+        expected_addr=worker.model_runner.req_to_token_pool.req_to_token[batch.req_pool_indices.long()[:,None],expected_pos.long()]
+        expected_physical=pages.physical_addresses(expected_addr.long().flatten())
+        same=(torch.equal(positions,expected_pos) and torch.equal(addresses,expected_addr)
+              and torch.equal(ticket.writes,expected_physical)
+              and torch.equal(ticket.chain,torch.cat((draft.bonus_tokens[:,None],ticket.output[0]),1)))
+        if not TargetGraphs._all_ranks(same):
+            raise RuntimeError("Direct draft grant disagrees with authorized cache rows or chain")
+        worker._a0041_direct_checks[n]=checks+1
+        logging.getLogger(__name__).info("A0041 direct draft width=%d admission=%d exact=True",n,checks+1)
+    lengths=[o[-1] for o in grant.owners]
+    return (len(lengths),8,ticket.chain,batch.seq_lens,lengths,positions.reshape(-1),positions,
+            writes,addresses,plan,plan,pages,physical,None)

+def extend_ple_ids(batch, embedding):
+    """Hash exactly the final position of each live three-token PLE window."""
+    context = batch.ngram_context
+    reqs, offsets = batch.req_indices, batch.token_offsets
+    rows = batch.processed_tokens
+    params = (embedding.layer_multipliers, embedding.ngram_heads_vocab_sizes,
+              embedding.ngram_heads_offsets)
+    if (embedding.ngram_size != 3 or embedding.ngram_heads != 16
+            or embedding.heads_per_ngram != 8 or context is None
+            or not context.is_xpu or context.dtype not in (torch.int32, torch.int64)
+            or context.ndim != 2 or context.shape[1] != batch.row_width + 2
+            or not context.is_contiguous() or not reqs.shape == offsets.shape == (rows,)
+            or not rows or any(t.device != context.device or t.dtype != torch.int64
+                               or not t.is_contiguous() for t in (reqs, offsets, *params))):
+        return None
+    result = torch.empty((rows, 16), dtype=torch.int64, device=context.device)
+    _extend_ple_hash[(triton.cdiv(rows, 16),)](
+        context, reqs, offsets, *params, result, rows, context.stride(0),
+        embedding.eos_token_id,
+    )
+    return result

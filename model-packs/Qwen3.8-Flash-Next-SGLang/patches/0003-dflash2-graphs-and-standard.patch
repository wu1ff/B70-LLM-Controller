+def accept_k7(candidates, target_probs, support, q_rows, accept_uniforms):
+    bs, _, vocab = target_probs.shape
+    accepted = torch.empty(bs, dtype=torch.int64, device=candidates.device)
+    p = torch.empty((bs, 7), dtype=torch.float32, device=candidates.device)
+    q = torch.empty_like(p)
+    _accept_k7[(bs,)](
+        candidates, target_probs, support, q_rows, accept_uniforms, accepted, p, q,
+        vocab, *accept_uniforms.stride(),
+    )
+    terminal = target_probs[torch.arange(bs, device=candidates.device), accepted]
+    _recovery_k7[(bs,)](terminal, support, q_rows, accepted, vocab)
+    return accepted.clamp_min_(0), terminal, p, q

+"""Experiment with canonical BF16 TP reduction inside packed HC injection."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _gather_combine(gathered, residual, gates, weight, out, normalized,
+                    ROWS: tl.constexpr, GATE_STRIDE: tl.constexpr, RESIDUAL_STRIDE: tl.constexpr, EPS: tl.constexpr,
+                    NORMALIZE: tl.constexpr,
+                    QUARTERS: tl.constexpr, P0: tl.constexpr, P1: tl.constexpr,
+                    P2: tl.constexpr, P3: tl.constexpr):
+    row, stream = tl.program_id(0), tl.program_id(1)
+    col = tl.arange(0, 4096)
+    mask = col < 2560
+    quarter = col // 640
+    order = tl.where(quarter == 0, P0, tl.where(quarter == 1, P1, tl.where(quarter == 2, P2, P3)))
+    if QUARTERS:
+        offset = (quarter * ROWS + row) * 640 + col % 640
+    else:
+        offset = row * 2560 + col
+    part = gathered + offset
+    a = tl.load(part + (order & 3) * ROWS * 2560, mask, 0.).to(tl.float32)
+    b = tl.load(part + ((order >> 2) & 3) * ROWS * 2560, mask, 0.).to(tl.float32)
+    c = tl.load(part + ((order >> 4) & 3) * ROWS * 2560, mask, 0.).to(tl.float32)
+    d = tl.load(part + ((order >> 6) & 3) * ROWS * 2560, mask, 0.).to(tl.float32)
+    ab = a + b
+    ab = tl.where((order & 256) != 0, ab.to(tl.bfloat16).to(tl.float32), ab)
+    second = tl.where((order & 1024) != 0, c + d, ab + c)
+    second = tl.where((order & 512) != 0, second.to(tl.bfloat16).to(tl.float32), second)
+    combined_partial = tl.where((order & 1024) != 0, ab, d) + second
+    block = combined_partial.to(tl.bfloat16).to(tl.float32)
+    residual_offset = row * 10240 + stream * 2560 + col
+    prior = tl.load(residual + row * RESIDUAL_STRIDE + stream * 2560 + col, mask, 0.).to(tl.float32)
+    gate = tl.load(gates + row * GATE_STRIDE + stream).to(tl.float32)
+    scale = 2.0 * tl.sigmoid(gate / 4)
+    y = (prior + block * scale).to(tl.bfloat16)
+    tl.store(out + residual_offset, y, mask)
+    if NORMALIZE:
+        v = y.to(tl.float32)
+        norm = v * tl.rsqrt(tl.sum(v * v) / 2560 + EPS)
+        affine = tl.load(weight + stream * 2560 + col, mask, 0.).to(tl.float32)
+        tl.store(normalized + residual_offset, norm + norm * affine, mask)
+
+
+def apply(gathered, residual, gates, weight, out, normalized, orders, quarter=True, eps=1e-6):
+    rows = residual.shape[0]
+    _gather_combine[(rows,4)](gathered, residual, gates, weight, out, normalized,
+                             rows, gates.stride(0), residual.stride(0), eps,
+                             normalized is not None, quarter, *orders)
+
+
+# Each native C1 ring quarter starts with its rank, then the three following
+# ranks cyclically, with a BF16 boundary after each add. Quarter 3 uses the
+# equivalent commuted first pair as independently identified in the probe.
+_C1_ORDERS = (996, 825, 846, 924)
+
+
+def consume(packed, residuals, *next_norm):
+    residual, _, gate = residuals
+    if (residual.shape != (8,10240) or residual.stride(1) != 1
+            or gate.shape != (8,4) or gate.stride(1) != 1
+            or packed.shape != (4,4,8,640) or not packed.is_contiguous()
+            or packed.dtype != residual.dtype or gate.dtype != residual.dtype
+            or residual.dtype != torch.bfloat16):
+        raise RuntimeError("Unexpected C1 gathered HC operands")
+    out = residual.new_empty(residual.shape)
+    norm = next_norm[0] if next_norm else None
+    if norm is None:
+        apply(packed, residual, gate, None, out, None, _C1_ORDERS)
+        return (out,None) if next_norm else out
+    if norm.group_size != 2560 or norm.weight.shape != (10240,) or not norm.weight.is_contiguous():
+        raise RuntimeError("Unexpected C1 gathered HC normalization")
+    normalized = torch.empty_like(out)
+    apply(packed, residual, gate, norm.weight, out, normalized, _C1_ORDERS, eps=norm.variance_epsilon)
+    return out, normalized

+@triton.jit
+def _extend_ple_hash(contexts, reqs, token_offsets, multipliers, vocab_sizes,
+                     offsets, output, rows, stride, EOS: tl.constexpr):
+    lane = tl.program_id(0) * 16 + tl.arange(0, 16)
+    head = tl.arange(0, 16)
+    active = lane < rows
+    req = tl.load(reqs + lane, active, 0)
+    token = tl.load(token_offsets + lane, active, 0)
+    context = req * stride + token
+    current = tl.load(contexts + context + 2, active, 0).to(tl.int64)
+    previous = tl.load(contexts + context + 1, active, 0).to(tl.int64)
+    older = tl.load(contexts + context, active, 0).to(tl.int64)
+    older = tl.where(previous == EOS, EOS, older)
+    bigram = (current * tl.load(multipliers)) ^ (previous * tl.load(multipliers + 1))
+    trigram = bigram ^ (older * tl.load(multipliers + 2))
+    mixed = tl.where(head[None, :] < 8, bigram[:, None], trigram[:, None])
+    size = tl.load(vocab_sizes + head)[None, :]
+    remainder = mixed % size
+    ids = tl.where(remainder < 0, remainder + size, remainder) + tl.load(offsets + head)[None, :]
+    tl.store(output + lane[:, None] * 16 + head[None, :], ids, active[:, None])
+

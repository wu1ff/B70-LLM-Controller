index 0000000000000000000000000000000000000000..85a82f4d525581039608e41ae4b432a3098afc68
--- /dev/null
+++ b/python/sglang/srt/speculative/draft_window.py
@@ -0,0 +1,53 @@
+"""Build the virtual read window for the B70 K7 draft from committed device lengths."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pack(lengths, owners, table, pointers, reads, BS: tl.constexpr, STRIDE: tl.constexpr):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    lanes = tl.arange(0, 4)
+    lens = tl.load(lengths + lanes, lanes < BS, 0).to(tl.int32)
+    windows = tl.minimum(lens, 2047)
+    start = tl.sum(tl.where(lanes < row, windows, 0), 0)
+    mask_start = tl.sum(tl.where(lanes < row, 8 * (lens + 8), 0), 0)
+    length = tl.load(lengths + row).to(tl.int32)
+    size = tl.minimum(length, 2047)
+    offset = length - size
+    owner = tl.load(owners + row).to(tl.int64)
+    cols = tile * 128 + tl.arange(0, 128)
+    live = cols < size
+    ids = tl.load(table + owner * STRIDE + offset + cols, live, 0)
+    tl.store(reads + start + cols, ids, live)
+    if tile == 0:
+        tl.store(pointers + row, start)
+        tl.store(pointers + 5 + row, mask_start)
+        tl.store(pointers + 10 + row, row * 8)
+        tl.store(pointers + 15 + row, offset)
+        if row == BS - 1:
+            tl.store(pointers + BS, start + size)
+            tl.store(pointers + 5 + BS, mask_start + 8 * (length + 8))
+            tl.store(pointers + 10 + BS, 8 * BS)
+
+
+def allocate(device):
+    return (torch.empty(20, device=device, dtype=torch.int32),
+            torch.empty(4 * 2047, device=device, dtype=torch.int64))
+
+
+def prepare(buffers, lengths, owners, table):
+    _pack[(len(owners), 16)](lengths, owners, table, *buffers, len(owners), table.stride(0))
+    return buffers
+
+
+def metadata(buffers, batch):
+    from sglang.srt.layers.attention.triton_backend import ForwardMetadata, WindowRail
+    from sglang.srt.mem_cache.kv.alloc.id_space import IdSpaceKind
+    pointers, reads = buffers
+    n = batch.batch_size
+    rail = WindowRail(kv_indptr=pointers[:n+1], kv_offsets=pointers[15:15+n],
+                      kv_indices=reads[:batch.flashnext_window_rows[1]], kv_indices_exact=True)
+    return ForwardMetadata(None, None, 8, None, None, None, pointers[10:11+n], None,
+                           pointers[5:6+n], windows={IdSpaceKind.FULL: rail})
diff --git a/python/sglang/srt/speculative/early_query_group.py b/python/sglang/srt/speculative/early_query_group.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ce504bbab13c95cb4f5dceb76aecc3b3edccc25
--- /dev/null
+++ b/python/sglang/srt/speculative/early_query_group.py
@@ -0,0 +1,222 @@
+"""Issue an admitted C1–C4 draft graph after commit, before the CPU schedules its next round."""
+from dataclasses import dataclass
+from hashlib import blake2s
+import logging
+import struct
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.managers.scheduler_components.shm_tag_exchange import fold_u64
+from sglang.srt.speculative.round_exchange import channel
+from sglang.srt.speculative.spec_tp_sync import SpecTpSyncSite
+
+log = logging.getLogger(__name__)
+
+
+@triton.jit
+def _stage(ids, positions, virtual, reads, ptr, mapping, graph_ids, graph_pos, graph_loc,
+           graph_reads, graph_ind, graph_off, graph_qo, graph_mask):
+    row, tile = tl.program_id(0), tl.program_id(1)
+    cols = tile*128 + tl.arange(0, 128)
+    small = cols < 8
+    dest = row*8 + cols
+    token = tl.load(ids + dest, small, 0)
+    # A failed earlier STANDARD can still have a queued private lookahead.
+    # Keep indexing bounded until the scheduler discards that row's result.
+    token = tl.where(token < 0, tl.load(ids + row*8 + 1), token)
+    tl.store(graph_ids + dest, token, small)
+    tl.store(graph_pos + dest, tl.load(positions + dest, small, 0), small)
+    write = tl.load(virtual + dest, small, 0)
+    page = tl.load(mapping + write//128, small, 0)
+    tl.store(graph_loc + dest, page*128 + write%128, small)
+    start = tl.load(ptr+row)
+    end = tl.load(ptr+row+1)
+    live = start + cols < end
+    read = tl.load(reads + start + cols, live, 0)
+    slot = tl.load(mapping + read//128, live, 0)
+    tl.store(graph_reads + start + cols, slot*128 + read%128, live)
+    if tile == 0:
+        tl.store(graph_ind + row, start)
+        tl.store(graph_mask + row, tl.load(ptr + 5 + row))
+        tl.store(graph_qo + row, row*8)
+        tl.store(graph_off + row, tl.load(ptr + 15 + row))
+        if row == tl.num_programs(0)-1:
+            tl.store(graph_ind + row+1, end)
+            tl.store(graph_mask + row+1, tl.load(ptr+6+row))
+            tl.store(graph_qo + row+1, (row+1)*8)
+
+
+@triton.jit
+def _kv_copy(k_ptrs, v_ptrs, locations, shadow, RESTORE: tl.constexpr):
+    layer = tl.program_id(0)
+    row = tl.program_id(1)
+    kp = tl.load(k_ptrs + layer).to(tl.pointer_type(tl.bfloat16))
+    vp = tl.load(v_ptrs + layer).to(tl.pointer_type(tl.bfloat16))
+    col = tl.arange(0, 256)
+    address = tl.load(locations + row).to(tl.int64)*256 + col
+    sk = shadow + (layer*tl.num_programs(1) + row)*256 + col
+    sv = sk + 5*tl.num_programs(1)*256
+    if RESTORE:
+        tl.store(kp + address, tl.load(sk))
+        tl.store(vp + address, tl.load(sv))
+    else:
+        tl.store(sk, tl.load(kp + address))
+        tl.store(sv, tl.load(vp + address))
+
+
+def agreed(phase, grant, eligible):
+    exchange = channel(phase)
+    if exchange is None:
+        return False
+    vote = (int(eligible), *fold_u64(grant.digest))
+    return all(row[0] and tuple(row[1:]) == vote[1:] for row in exchange.allgather(vote))
+
+
+def settings(req):
+    p = req.sampling_params
+    return p.sampling_seed, p.temperature, p.top_k, p.top_p, p.min_p
+
+
+def uniforms(worker, batch, device_length, old_lengths):
+    info = batch.sampling_info
+    dev = device_length.device
+    bs = len(old_lengths)
+    draws = torch.rand((bs, 7), device=dev)
+    seeded = info.eager_seeded_rows or ()
+    previous = getattr(worker, "_a0041_seed_tables", {})
+    live = {}
+    for i, is_seeded in enumerate(seeded):
+        if not is_seeded:
+            continue
+        seed = batch.reqs[i].sampling_params.sampling_seed % (1 << 64)
+        base = old_lengths[i] // 128 * 128
+        key = (seed, base)
+        table = previous.get(key)
+        if table is None:
+            # Include commits across the final position in this host tile.
+            values = [[(int.from_bytes(blake2s(struct.pack("<QQII",seed,pos,1,j),
+                        digest_size=4).digest(),"little") >> 8)*2.0**-24 for j in range(7)]
+                      for pos in range(base, base+136)]
+            cpu = torch.tensor(values, dtype=torch.float32, pin_memory=True)
+            table = cpu.to(dev, non_blocking=True)
+        live[key] = table
+        selected = table.index_select(0, device_length[i:i+1].long() - base)
+        if bs == 1:
+            draws = selected
+        else:
+            draws[i:i+1].copy_(selected)
+    worker._a0041_seed_tables = live
+    worker._tp_sync.sync(SpecTpSyncSite.DFLASH_SELECTOR, draws)
+    return draws
+
+
+@dataclass
+class Ticket:
+    grant: object
+    draft_input: object
+    lengths: torch.Tensor
+    anchor: torch.Tensor
+    coverage: object
+    params: tuple
+    entry: object
+    embedding: object
+    draws: torch.Tensor
+    output: tuple
+    writes: torch.Tensor
+    check: bool
+
+
+def bound(worker, entry, embedding):
+    if entry is None or entry.replays < 3 or entry.bindings is None:
+        return False
+    graphs = worker.draft_model._flashnext_query_graphs
+    model = worker.draft_model
+    # The graph's model is the draft backbone inside the causal LM wrapper.
+    backbone = model.model if hasattr(model, "model") and hasattr(model.model, "layers") else model
+    backend = worker.draft_model_runner.attn_backend
+    scope, guard = entry.bindings
+    return (scope[:2] == (id(backbone), id(backend)) and scope[3] == id(embedding)
+            and guard.valid((*graphs._kv(backbone, backend), worker._v6_calibration, embedding.weight)))
+
+
+@torch.inference_mode()
+def issue(worker, batch, grant, next_input, embedding, temps, greedy):
+    worker._a0041_ticket = None
+    prepared = worker._flashnext_prepared_draft
+    pages = worker.draft_model.b70_pages
+    coverage = pages.query_coverage
+    bs = len(batch.reqs)
+    lengths = [owner[-1] for owner in grant.owners]
+    # The previous coverage must certify every read/write page for every
+    # possible next commit, and the graph's short/windowed geometry must hold.
+    def page_key(delta):
+        return tuple((req, req.kv.req_pool_idx, req.kv.kv_allocated_len,
+                      max(pos+delta-2047,0)//128, (pos+delta+7)//128)
+                     for req,pos in zip(batch.reqs,lengths,strict=True))
+    short = max(lengths) + 8 <= 2048
+    graphs = worker.draft_model._flashnext_query_graphs
+    entry = graphs.entries.get((bs, True, short, True))
+    ok = (prepared is not None and prepared[1] is next_input and prepared[3] is not None
+          and coverage is not None and coverage[1] == pages.mapping_generation
+          and coverage[0] == page_key(0) == page_key(8)
+          and short == (max(lengths)+16 <= 2048) and not pages._exchange_broken
+          and not worker._aux_pending and worker._resident_prefix_ptrs is not None
+          and worker._tp_sync.enabled(SpecTpSyncSite.DFLASH_SELECTOR)
+          and bound(worker, entry, embedding))
+    if not agreed("early_issue", grant, ok):
+        return
+    ids, pos, loc = prepared[2]
+    ptr, reads = prepared[3]
+    dest = graphs._inputs(entry.batch, entry.metadata)
+    graph_ids, graph_pos, writes, qo, mask, ind, off, graph_reads = dest
+    _stage[(bs,16)](ids,pos,loc,reads,ptr,pages.mapping,graph_ids,graph_pos,writes,
+                  graph_reads,ind,off,qo,mask)
+    draws = uniforms(worker, batch, next_input.new_seq_lens, lengths)
+    torch._foreach_copy_(list(entry.proposal_inputs), [draws, temps, greedy])
+    shadow = getattr(worker, "_a0041_shadow", None)
+    if shadow is None:
+        shadow = worker._a0041_shadow = torch.empty((10,32,256),device=writes.device,dtype=torch.bfloat16)
+    k_ptrs,v_ptrs = worker._resident_prefix_ptrs
+    _kv_copy[(5,bs*8)](k_ptrs,v_ptrs,writes,shadow,False)
+    entry.graph.replay()
+    _kv_copy[(5,bs*8)](k_ptrs,v_ptrs,writes,shadow,True)
+    # No model work on another request can consume the borrowed outputs before
+    # a fresh scheduler grant. Clone the tiny ticket so a discarded launch,
+    # later admission or a reused slot cannot subsequently mutate this result.
+    output = tuple(t.clone() for t in entry.proposal_output)
+    if not hasattr(worker, "_a0041_validated"):
+        worker._a0041_validated = {}
+    check = worker._a0041_validated.get(bs, 0) < 3
+    worker._a0041_ticket = Ticket(grant,next_input,next_input.new_seq_lens,next_input.bonus_tokens,
+                                  coverage,tuple(map(settings,batch.reqs)),entry,embedding,draws,output,writes.clone(),check)
+    worker._a0041_ticket.chain = torch.cat((next_input.bonus_tokens[:,None],output[0]),1)
+
+
+def take(worker,batch,grant,draft_input):
+    ticket = getattr(worker, "_a0041_ticket", None)
+    worker._a0041_ticket = None
+    if grant is None or not 1 <= len(batch.reqs) <= 4:
+        return None
+    pages = worker.draft_model.b70_pages
+    prepared = getattr(worker,"_flashnext_prepared_draft",None)
+    ok = (ticket is not None and prepared is not None and prepared[0] is ticket.grant
+          and prepared[1] is draft_input and prepared[3] is not None
+          and worker._draft_sampler is None and not worker._info_dumper.enabled
+          and grant.iteration == ticket.grant.iteration + 1
+          and grant.cache_owners == ticket.grant.cache_owners and ticket.draft_input is draft_input
+          and ticket.lengths is batch.seq_lens and ticket.anchor is draft_input.bonus_tokens
+          and ticket.coverage is pages.query_coverage and ticket.coverage[1] == pages.mapping_generation
+          and ticket.params == tuple(map(settings,batch.reqs)) and bound(worker,ticket.entry,ticket.embedding))
+    return ticket if agreed("early_take",grant,ok) else None
+
+
+def validate(worker,ticket,proposal,writes):
+    from sglang.srt.hardware_backend.xpu.graph_runner.flashnext_target import TargetGraphs
+    same = all(torch.equal(a,b) for a,b in zip(proposal,ticket.output,strict=True))
+    if not TargetGraphs._all_ranks(same and torch.equal(writes,ticket.writes)):
+        raise RuntimeError("Ahead-of-readback draft diverged from admitted query")
+    bs = len(ticket.grant.owners)
+    worker._a0041_validated[bs] = worker._a0041_validated.get(bs,0) + 1
+    log.info("A0041 early draft width=%d exact admission=%d",bs,worker._a0041_validated[bs])
diff --git a/python/sglang/srt/speculative/exact_categorical.py b/python/sglang/srt/speculative/exact_categorical.py
new file mode 100644
index 0000000000000000000000000000000000000000..c85a7fb2852197a01053a5cb606260f541eedefc
--- /dev/null
+++ b/python/sglang/srt/speculative/exact_categorical.py
@@ -0,0 +1,50 @@
+"""Strict inverse CDF of the represented masses, including zero and subnormal weights."""
+from functools import cache
+import math
+import torch
+
+
+@cache
+def native():
+    torch.ops.load_library("/opt/flashnext/a0041/categorical.so")
+    return torch.ops.a0041_categorical.forward
+
+
+def portable(row, draw):
+    if not 0 <= draw <= 1:
+        return -1
+    live = []
+    denominator = 1
+    for token,value in enumerate(row):
+        if not math.isfinite(value) or value < 0:
+            return -1
+        if value:
+            n,d = value.as_integer_ratio()
+            denominator = max(denominator,d)
+            live.append((token,n,d))
+    if not live:
+        return -1
+    # Every IEEE denominator is a power of two.
+    mass = [(token,n*(denominator//d)) for token,n,d in live]
+    total = sum(m for _,m in mass)
+    n,d = draw.as_integer_ratio()
+    threshold = min(total*n//d,total-1)
+    cumulative = 0
+    for token,m in mass:
+        cumulative += m
+        if cumulative > threshold:
+            return token
+    raise RuntimeError("Unreachable exact CDF endpoint")
+
+
+def sample(probs,uniforms,report_in_result):
+    if (probs.is_xpu and probs.dtype == uniforms.dtype == torch.float32
+            and probs.ndim == 2 and 0 < probs.shape[1] <= 262144 and len(probs)>0
+            and uniforms.shape == (len(probs),) and probs.device==uniforms.device):
+        ids = native()(probs.contiguous(),uniforms)
+    else:
+        ids = torch.tensor([portable(row,float(u)) for row,u in zip(probs.tolist(),uniforms.tolist(),strict=True)],
+                           device=probs.device,dtype=torch.int64)
+    if not report_in_result and (ids < 0).any().item():
+        raise ValueError("STANDARD terminal distribution has zero or nonfinite mass, invalid weights or draw")
+    return ids
diff --git a/python/sglang/srt/speculative/flashnext_cycle.py b/python/sglang/srt/speculative/flashnext_cycle.py
new file mode 100644
index 0000000000000000000000000000000000000000..a9f2f9d3b657dfd64a7331255661b16700b89427
--- /dev/null
+++ b/python/sglang/srt/speculative/flashnext_cycle.py
@@ -0,0 +1,301 @@
+"""Small device operations on the Flash Next K7 execution path."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _accept_k7(chain, probs, support, q_rows, uniforms, accepted, p_out, q_out,
+               VOCAB: tl.constexpr, U0: tl.constexpr, U1: tl.constexpr):
+    row = tl.program_id(0)
+    offsets = tl.arange(0, 8)
+    valid = offsets < 7
+    tokens = tl.load(chain + row * 8 + offsets + 1, valid, 0)
+    p = tl.load(probs + (row * 8 + offsets) * VOCAB + tokens, valid, 0)
+    lanes = tl.arange(0, 16)
+    indices = (row * 7 + offsets[:, None]) * 16 + lanes[None, :]
+    ids = tl.load(support + indices, valid[:, None], -1)
+    mass = tl.load(q_rows + indices, valid[:, None], 0)
+    q = tl.sum(tl.where(ids == tokens[:, None], mass, 0.), axis=1)
+    u = tl.load(uniforms + row * U0 + offsets * U1, valid, 0.)
+    hit = (q > 0.) & ((p >= q) | (u.to(tl.float64) * q.to(tl.float64) < p.to(tl.float64)))
+    count = tl.min(tl.where(valid & ~hit, offsets, 7), axis=0)
+    valid_p = (p >= 0.) & (p <= 1.)
+    valid_entries = (mass >= 0.) & (mass <= 1.)
+    mass_sum = tl.sum(mass, axis=1)
+    # The proposal walk normalizes 16 FP32 values. This bound covers its
+    # reduction and 16 final roundings while still rejecting malformed rows.
+    valid_q = (q > 0.) & (tl.min(valid_entries.to(tl.int32), axis=1) != 0) & (tl.abs(mass_sum - 1.) <= 0.0000019073486328125)
+    bad = tl.sum((valid & ~(valid_p & valid_q)).to(tl.int32), 0) != 0
+    tl.store(accepted + row, tl.where(bad, -1, count))
+    tl.store(p_out + row * 7 + offsets, p, valid)
+    tl.store(q_out + row * 7 + offsets, q, valid)

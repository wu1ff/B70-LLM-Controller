+@triton.jit
+def _stage_k7(ids_out, pos_out, rope_out, write_out, rows_out, lens_out, state_out,
+              ids, pos, rope, write, rows, lens, state, lengths_out, cumulative_out,
+              pages_out, pages, columns, ROWS: tl.constexpr, IN_PAGE_STRIDE: tl.constexpr,
+              OUT_PAGE_STRIDE: tl.constexpr, ROPE_STRIDE: tl.constexpr, BLOCK: tl.constexpr,
+              PAGE_SIZE: tl.constexpr):
+    program = tl.program_id(0)
+    if program == 0:
+        j = tl.arange(0, 32)
+        live = j < ROWS
+        req_live = j < ROWS // 8
+        tl.store(ids_out + j, tl.load(ids + j, live, 0), live)
+        tl.store(pos_out + j, tl.load(pos + j, live, 0), live)
+        tl.store(write_out + j, tl.load(write + j, live, 0), live)
+        for axis in tl.static_range(3):
+            tl.store(rope_out + axis * ROWS + j,
+                     tl.load(rope + axis * ROPE_STRIDE + j, live, 0), live)
+        tl.store(rows_out + j, tl.load(rows + j, req_live, 0), req_live)
+        tl.store(lens_out + j, tl.load(lens + j, req_live, 0), req_live)
+        tl.store(state_out + j, tl.load(state + j, req_live, 0), req_live)

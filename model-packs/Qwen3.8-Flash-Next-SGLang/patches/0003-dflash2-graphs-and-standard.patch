+@triton.jit
+def _pack_k7_outputs(candidates, accepted, bonus, tokens, lengths):
+    row = tl.program_id(0)
+    cols = tl.arange(0, 8)
+    count = tl.load(accepted + row)
+    draft = tl.load(candidates + row * 8 + cols + 1, cols < 7, 0)
+    emitted = tl.where(cols == count, tl.load(bonus + row), draft)
+    tl.store(tokens + row * 8 + cols, emitted)
+    tl.store(lengths + row, count + 1)

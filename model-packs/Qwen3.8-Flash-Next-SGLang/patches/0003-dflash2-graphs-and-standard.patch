diff --git a/python/sglang/srt/speculative/cdf_recovery.py b/python/sglang/srt/speculative/cdf_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b0948b5bf2b4901793f57a0bb3236ecdebb46f9
--- /dev/null
+++ b/python/sglang/srt/speculative/cdf_recovery.py
@@ -0,0 +1,41 @@
+"""Finish STANDARD's strict inverse CDF without materializing a vocabulary mask."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _count(cdf, uniforms, partials, WIDTH: tl.constexpr, U_STRIDE: tl.constexpr,
+           BLOCK: tl.constexpr):
+    row, tile = tl.program_id(0), tl.program_id(1)
+    total = tl.load(cdf + row * WIDTH + WIDTH - 1)
+    draw = tl.load(uniforms + row * U_STRIDE)
+    # Reproduce torch.nextafter(total, -inf) on a nonnegative FP32 CDF.
+    # For an empty residual row the neighbor below +0 is -min_subnormal.
+    total_bits = total.to(tl.uint32, bitcast=True)
+    below = tl.where(total == 0., 0x80000001, total_bits - 1).to(tl.float32, bitcast=True)
+    threshold = tl.minimum(draw * total, below)
+    cols = tile * BLOCK + tl.arange(0, BLOCK)
+    values = tl.load(cdf + row * WIDTH + cols, cols < WIDTH, float("inf"))
+    le = (cols < WIDTH) & (values <= threshold) & (total == total) & (draw == draw)
+    tl.store(partials + row * tl.num_programs(1) + tile, tl.sum(le.to(tl.int32), axis=0))
+
+
+@triton.jit
+def _merge(partials, tokens, WIDTH: tl.constexpr, TILES: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    cols = tl.arange(0, BLOCK)
+    counts = tl.load(partials + row * TILES + cols, cols < TILES, 0)
+    tl.store(tokens + row, tl.minimum(tl.sum(counts, axis=0), WIDTH - 1))
+
+
+def sample(cdf, uniforms):
+    rows, width = cdf.shape
+    block = 1024
+    tiles = triton.cdiv(width, block)
+    parts = torch.empty((rows, tiles), device=cdf.device, dtype=torch.int32)
+    result = torch.empty(rows, device=cdf.device, dtype=torch.int64)
+    _count[(rows, tiles)](cdf, uniforms, parts, width, uniforms.stride(0), block, num_warps=4)
+    _merge[(rows,)](parts, result, width, tiles, triton.next_power_of_2(tiles), num_warps=4)
+    return result
diff --git a/python/sglang/srt/speculative/checked_scatter.py b/python/sglang/srt/speculative/checked_scatter.py
new file mode 100644
index 0000000000000000000000000000000000000000..27a8b2977ec08e4231ef62524207f2935ed30a30
--- /dev/null
+++ b/python/sglang/srt/speculative/checked_scatter.py
@@ -0,0 +1,21 @@
+"""Check unpadded reduction on live, layer-local BF16 partials before steady use."""
+import logging
+import torch
+from sglang.srt.hardware_backend.xpu.graph_runner.flashnext_target import TargetGraphs
+from sglang.srt.speculative.row_scatter import reduce_rows
+
+_counts={}
+def run(owner,partial):
+    key=(owner.group, owner.rows%4==0)
+    checks=_counts.get(key,0)
+    if checks is False:
+        return owner.shard(owner.group.all_reduce(partial))
+    local=reduce_rows(owner.group,partial)
+    if checks<2:
+        ordinary=owner.shard(owner.group.all_reduce(partial.clone()))
+        exact=TargetGraphs._all_ranks(torch.equal(ordinary.contiguous().view(torch.int16),local.view(torch.int16)))
+        _counts[key]=checks+1 if exact else False
+        logging.getLogger(__name__).info("A0041 unpadded reduction rows=%d admission=%d exact=%s",
+                                         owner.rows,checks+1,exact)
+        return ordinary
+    return local

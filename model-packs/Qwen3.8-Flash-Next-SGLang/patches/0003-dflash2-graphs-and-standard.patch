+V6_PLE = V6_TARGET and os.getenv("SGLANG_FLASHNEXT_V6_PLE_BATCH") == "1"
+FUSED_TP_HC = V6_TARGET and os.getenv("SGLANG_FLASHNEXT_FUSED_TP_HC") == "1"
+COMPACT_EXPERTS = V6_TARGET and os.getenv("SGLANG_FLASHNEXT_COMPACT_EXPERTS") == "1"
+
+
+@cache
+def load_compact_experts():
+    path = Path("/opt/flashnext/a0035/libastra_a0035.so")
+    expected = "83846d1ec0e7d7ac2bed252dd610fafb0804616b7876334a8fcba3b04198ed84"
+    if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
+        raise RuntimeError(f"Unexpected compact expert binary at {path}")
+    torch.ops.load_library(str(path))
+
+
+@cache
+def packed_experts(requests):
+    # vLLM 0.33 astra_ownership.apply, Apache-2.0. Both libraries are
+    # already part of the digest-pinned base and use the same cyclic packs.
+    from sglang.srt.layers.quantization.qwen4_exp_intel_moe import NATIVE_LIBRARY
+    name,digest=(
+        ("libdominant_w4_layout.so","1a2e8f582e76e27bbc478a9c2ffa6f26f6e2283673a4059a5c5c0564d2c9d673")
+        if requests==1 else
+        ("libastra_batch.so","551f15c64119aff9905b651f880d7c1313bf0ade3fb3fcb4dc31a7432c50f77a")
+    )
+    library=NATIVE_LIBRARY.with_name(name)
+    if hashlib.sha256(library.read_bytes()).hexdigest()!=digest:
+        raise RuntimeError(f"Unexpected packed expert binary {name}")
+    torch.ops.load_library(str(library))
+    if requests==1:
+        return lambda *args:torch.ops.dominant_w4_layout.forward(*args,1)
+    return torch.ops.astra_batch.forward
+
+
+@torch.compile
+def activate_hc(low):
+    return F.silu(low/4)
+
+
+@torch.compile
+def read_hc(up, normalized):
+    gates=torch.sigmoid(up).unflatten(-1,(4,2560))
+    return (gates*normalized.unflatten(-1,(4,2560))).mean(dim=-2)
+
+
+@contextmanager
+def bind(instance, name, value):
+    """Scope dispatch overrides to capture in this single-threaded model worker."""
+    missing = object()
+    old = vars(instance).get(name, missing)
+    setattr(instance, name, value)
+    try:
+        yield
+    finally:
+        if old is missing:
+            delattr(instance, name)
+        else:
+            setattr(instance, name, old)
+
+
+class ChainRows:
+    def __init__(self, requests, fuse_tp_hc=False, compact_experts=False):
+        self.requests = requests
+        self.fuse_tp_hc = fuse_tp_hc

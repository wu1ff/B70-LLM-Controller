+# SPDX-License-Identifier: Apache-2.0
+# Contains code derived from vLLM's topk_topp_triton.py, Copyright contributors to vLLM.
+"""Parallel first vocabulary pass of the v6 filter for target verification."""
+import torch
+from vllm.triton_utils import tl, triton
+from vllm.utils.gpu_sync_debug import gpu_sync_allowed
+from vllm.v1.sample.ops import topk_topp_triton as donor
+from vllm.v1.sample.ops.topk_topp_triton import _update_min_larger_stats
+
+
+@triton.jit
+def _pivot(LOGITS, STRIDE: tl.constexpr, K, PERCENTILE_TO_STD_TABLE, output,
+           VOCAB_SIZE: tl.constexpr, BLOCK_SIZE: tl.constexpr):
+    row = tl.program_id(0)
+    LOGITS_ROW = LOGITS + row.to(tl.int64) * STRIDE
+    k = tl.load(K + row)
+    # Zeroth pass: Compute avg and std from a sample block
+    offs = tl.arange(0, BLOCK_SIZE)
+    mask_n = offs < VOCAB_SIZE
+    logits_blk0 = tl.load(
+        LOGITS_ROW + offs, mask=mask_n, other=-float("inf")
+    )
+    # Exclude -inf values (e.g. from grammar bitmasks) from
+    # statistics to avoid NaN in pivot computation.
+    finite_mask = (logits_blk0 > -float("inf")) & mask_n
+    num_finite = tl.sum(finite_mask)
+    finite_logits = tl.where(finite_mask, logits_blk0, 0.0)
+    avg_logit = tl.where(
+        num_finite > 0, tl.sum(finite_logits) / num_finite, 0.0
+    )
+    sq_avg_logit = tl.where(
+        num_finite > 0,
+        tl.sum(finite_logits * finite_logits) / num_finite,
+        0.0,
+    )
+    std_logit = tl.sqrt(
+        tl.maximum(sq_avg_logit - avg_logit * avg_logit, 0.0)
+    )
+
+    # Calculate outlier pivot t for Gaussian sigma-truncation
+    percentile = tl.cast(k / VOCAB_SIZE * 200, tl.uint32)
+    percentile = tl.minimum(percentile, 199)
+    sigma = tl.load(PERCENTILE_TO_STD_TABLE + percentile)
+    sigma = sigma + tl.abs(sigma) * -0.15
+    outlier_pivot = avg_logit + std_logit * sigma
+
+    tl.store(output + row, outlier_pivot)
+
+
+@triton.jit
+def _tiles(logits, pivot, stats, STRIDE: tl.constexpr, VOCAB: tl.constexpr, BLOCK: tl.constexpr):
+    row, tile = tl.program_id(0), tl.program_id(1)
+    x = tile * BLOCK + tl.arange(0, BLOCK)
+    data = tl.load(logits + row * STRIDE + x, x < VOCAB, -float("inf"))
+    finite = data > -float("inf")
+    p = stats + (row * tl.num_programs(1) + tile) * 4
+    tl.store(p, tl.min(tl.where(finite, data, float("inf"))).to(tl.int32, bitcast=True))
+    tl.store(p + 1, tl.max(data).to(tl.int32, bitcast=True))
+    tl.store(p + 2, tl.sum(finite))
+    tl.store(p + 3, tl.sum(data > tl.load(pivot + row)))
+
+
+@triton.jit
+def _offsets(stats, row_stats, positions, NTILES: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    x = tl.arange(0, BLOCK)
+    p = stats + (row * NTILES + x) * 4
+    live = x < NTILES
+    mins = tl.load(p, live, 0x7f800000).to(tl.float32, bitcast=True)
+    maxs = tl.load(p + 1, live, -0x800000).to(tl.float32, bitcast=True)
+    finite = tl.load(p + 2, live, 0)
+    counts = tl.load(p + 3, live, 0)
+    maximum = tl.max(maxs)
+    dest = row_stats + row * 4
+    tl.store(dest, tl.minimum(tl.min(mins), maximum).to(tl.int32, bitcast=True))
+    tl.store(dest + 1, maximum.to(tl.int32, bitcast=True))
+    tl.store(dest + 2, tl.sum(finite))
+    tl.store(dest + 3, tl.sum(counts))
+    tl.store(positions + row * NTILES + x, tl.cumsum(counts) - counts, live)
+
+
+@triton.jit
+def _compact(logits, pivot, positions, buffer, STRIDE: tl.constexpr, VOCAB: tl.constexpr,
+             BLOCK: tl.constexpr):
+    row, tile = tl.program_id(0), tl.program_id(1)
+    x = tile * BLOCK + tl.arange(0, BLOCK)
+    data = tl.load(logits + row * STRIDE + x, x < VOCAB, -float("inf"))
+    keep = data > tl.load(pivot + row)
+    start = tl.load(positions + row * tl.num_programs(1) + tile)
+    tl.store(buffer + row * VOCAB + start + tl.cumsum(keep) - 1, data, keep)
+
+
+# SPDX-License-Identifier: Apache-2.0
+# Appended to the generated tiled filter for the parallel masking experiment.
+@triton.jit
+def _count_duplicates(logits, stride: tl.constexpr, stats, counts, VOCAB: tl.constexpr,
+                      BLOCK: tl.constexpr):
+    row, tile = tl.program_id(0), tl.program_id(1)
+    dest = stats + row * 4
+    pivot = tl.load(dest).to(tl.float32, bitcast=True)
+    keep = tl.load(dest + 2).to(tl.uint32, bitcast=True)
+    duplicates = tl.load(dest + 3).to(tl.uint32, bitcast=True)
+    if pivot != -float("inf") and keep < duplicates:
+        x = tile * BLOCK + tl.arange(0, BLOCK)
+        live = x < VOCAB
+        values = tl.load(logits + row * stride + x, live, -float("inf"))
+        duplicate = tl.load(dest + 1).to(tl.float32, bitcast=True)
+        count = tl.sum((tl.abs(values - duplicate) < 1e-9) & live)
+        tl.store(counts + row * tl.num_programs(1) + tile, count)
+
+
+@triton.jit
+def _apply_mask(logits, stride: tl.constexpr, stats, counts, VOCAB: tl.constexpr,
+                BLOCK: tl.constexpr, TILE_BOUND: tl.constexpr):
+    row, tile = tl.program_id(0), tl.program_id(1)
+    dest = stats + row * 4
+    pivot = tl.load(dest).to(tl.float32, bitcast=True)
+    if pivot != -float("inf"):
+        keep = tl.load(dest + 2).to(tl.uint32, bitcast=True)
+        duplicates = tl.load(dest + 3).to(tl.uint32, bitcast=True)
+        x = tile * BLOCK + tl.arange(0, BLOCK)
+        live = x < VOCAB
+        ptr = logits + row * stride + x
+        values = tl.load(ptr, live, -float("inf"))
+        mask = (values > pivot) & live
+        if keep < duplicates:
+            prev_tiles = tl.arange(0, TILE_BOUND)
+            previous = tl.load(counts + row * tl.num_programs(1) + prev_tiles, prev_tiles < tile, 0)
+            duplicate = tl.load(dest + 1).to(tl.float32, bitcast=True)
+            tied = (tl.abs(values - duplicate) < 1e-9) & live
+            rank = tl.sum(previous) + tl.cumsum(tied)
+            mask &= (~tied) | (rank <= keep)
+        tl.store(ptr, tl.where(mask, values, -float("inf")), live)
+
+@triton.jit(do_not_specialize=["BATCH_SIZE"])
+def _prepared_filter_kernel(
+    LOGITS,
+    LOGITS_STRIDE_0,
+    PIVOT,
+    ROW_STATS,
+    MASK_STATS,
+    BUFFER,
+    PERCENTILE_TO_STD_TABLE,
+    NORMAL_CDF_TO_SIGMA_TABLE,
+    K,
+    P,
+    BATCH_SIZE,
+    VOCAB_SIZE: tl.constexpr,
+    MASK_VALUE: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    BLOCK_SIZE_TRUNC: tl.constexpr,
+    TOPK_ENABLED: tl.constexpr,
+    TOPP_ENABLED: tl.constexpr,
+    SPLIT_COVERS_PONLY: tl.constexpr,
+):
+    NUM_TILES: tl.constexpr = (VOCAB_SIZE + BLOCK_SIZE - 1) // BLOCK_SIZE
+    pid = tl.program_id(0)
+    num_programs = tl.num_programs(0)
+    for row_id in tl.range(pid, BATCH_SIZE, num_programs):
+        LOGITS_ROW = LOGITS + row_id.to(tl.int64) * LOGITS_STRIDE_0
+        BUFFER_ROW = BUFFER + pid * VOCAB_SIZE
+
+        final_pivot = -float("inf")
+        duplicate_logit = float("inf")
+        num_duplicate_logit = tl.zeros((), dtype=tl.uint32)
+        num_keep = tl.zeros((), dtype=tl.uint32)
+        num_kept = tl.zeros((), dtype=tl.uint32)
+
+        max_logit = -float("inf")
+        min_logit = float("inf")
+
+        if TOPK_ENABLED:
+            k = tl.load(K + row_id)
+            if k < VOCAB_SIZE:
+                outlier_pivot = tl.load(PIVOT + row_id)
+                row_stats = ROW_STATS + row_id * 4
+                min_logit = tl.load(row_stats).to(tl.float32, bitcast=True)
+                max_logit = tl.load(row_stats + 1).to(tl.float32, bitcast=True)
+                num_finite_total = tl.load(row_stats + 2).to(tl.uint32)
+                num_outliers = tl.load(row_stats + 3).to(tl.uint32)
+                # Second passes: Ternary search for pivot
+                num_iters = 0
+                k_pivot = float("inf")
+                k_pivots_num = tl.zeros((), dtype=tl.uint32)
+                min_larger = float("inf")
+                num_min_larger = tl.zeros((), dtype=tl.uint32)
+                if num_finite_total <= k:
+                    # All finite logits survive top-k; skip the cutoff search.
+                    k_pivot = -float("inf")
+                elif num_outliers > k:
+                    max_range = max_logit
+                    min_range = outlier_pivot
+                    search_range = tl.cast(num_outliers, tl.int32)
+                    search_iters = tl.cast(
+                        (num_outliers + BLOCK_SIZE_TRUNC - 1) // BLOCK_SIZE_TRUNC,
+                        tl.int32,
+                    )
+                    found_pivot = 0
+                    while found_pivot == 0:
+                        k_pivot_0 = (max_range - min_range) * 1.0 / 3.0 + min_range
+                        k_pivots_num_0 = tl.zeros((), dtype=tl.uint32)
+                        min_larger_0 = float("inf")
+                        num_min_larger_0 = tl.zeros((), dtype=tl.uint32)
+
+                        k_pivot_1 = (max_range - min_range) * 2.0 / 3.0 + min_range
+                        k_pivots_num_1 = tl.zeros((), dtype=tl.uint32)
+                        min_larger_1 = float("inf")
+                        num_min_larger_1 = tl.zeros((), dtype=tl.uint32)
+

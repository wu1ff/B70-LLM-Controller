+@triton.jit
+def _finish_commit(tokens, counts, prefix, controls, lengths, next_prefix, bonus, host_rail,
+                   WIDTH: tl.constexpr, STOPS: tl.constexpr, STOP_TILE: tl.constexpr,
+                   STAGE_HOST: tl.constexpr):
+    row = tl.program_id(0)
+    cols = tl.arange(0, WIDTH)
+    count = tl.load(counts + row)
+    cap = tl.load(controls + row * (STOPS + 1))
+    emitted = tl.load(tokens + row * WIDTH + cols)
+    limit = tl.minimum(count, cap)
+    if STOPS:
+        lanes = tl.arange(0, STOP_TILE)
+        stop_ids = tl.load(controls + row * (STOPS + 1) + 1 + lanes, lanes < STOPS, -1)
+        hits = tl.sum(((emitted[:, None] == stop_ids[None, :]) &
+                       (stop_ids[None, :] >= 0)).to(tl.int32), 1) != 0
+        first_stop = tl.min(tl.where(hits, cols + 1, WIDTH), 0)
+        limit = tl.minimum(limit, first_stop)
+    length = tl.load(prefix + row) + limit
+    tl.store(lengths + row, limit)
+    tl.store(next_prefix + row, length)
+    tl.store(bonus + row, tl.load(tokens + row * WIDTH + limit - 1))
+    if STAGE_HOST:
+        tl.store(host_rail + row * WIDTH + cols, emitted)
+        requests = tl.num_programs(0)
+        tl.store(host_rail + requests * WIDTH + row, limit)
+        tl.store(host_rail + requests * (WIDTH + 1) + row, length)
+
+
+def finish_commit(reqs, out_tokens, commit_lens, prefix_lens, stop_token_ids, *, stage_host=False):
+    stops = [() if r.sampling_params.ignore_eos
+             else tuple(sorted(t for t in stop_token_ids(r) if t is not None and t >= 0)) for r in reqs]
+    width = max(map(len, stops))
+    # Keep uncommon, larger stop sets on the shared eager path.
+    if width > 16:
+        return None
+    rows = [[max(1, r.sampling_params.max_new_tokens - len(r.output_ids)),
+             *ids, *([-1] * (width - len(ids)))] for r, ids in zip(reqs, stops, strict=True)]
+    controls = torch.tensor(rows, dtype=torch.int64, pin_memory=True).to(
+        out_tokens.device, non_blocking=True,
+    )
+    lengths = torch.empty_like(commit_lens)
+    next_prefix = torch.empty_like(prefix_lens)
+    bonus = torch.empty_like(prefix_lens, dtype=torch.int64)
+    host_rail = (
+        torch.empty(len(reqs) * 10, dtype=torch.int64, device=out_tokens.device)
+        if stage_host else None
+    )
+    _finish_commit[(len(reqs),)](
+        out_tokens, commit_lens, prefix_lens, controls, lengths, next_prefix, bonus, host_rail,
+        8, width, triton.next_power_of_2(max(1, width)), stage_host,
+    )
+    if stage_host:
+        return lengths, bonus, next_prefix, host_rail
+    return lengths, bonus, next_prefix

+@triton.jit
+def _k7_ple_hash(tokens, slots, locs, lengths, history, multipliers, vocab_sizes,
+                 offsets, output, EOS: tl.constexpr, HAS_LENGTHS: tl.constexpr):
+    lane = tl.arange(0, 128)
+    row = tl.program_id(0)
+    col = lane // 16
+    head = lane % 16
+    base = row * 8
+    loc = tl.load(locs + base + tl.arange(0, 8))
+    active = tl.sum((loc != 0).to(tl.int32), 0) != 0
+    length = tl.load(lengths + row) if HAS_LENGTHS else 8
+    slot = tl.where(active & (length != 0), tl.maximum(tl.load(slots + row), 0), 0)
+    older = tl.load(history + 2 * slot)
+    previous = tl.load(history + 2 * slot + 1)
+    t0 = tl.load(tokens + base + col, col < length, EOS)
+    t1 = tl.where(col == 0, previous,
+                  tl.load(tokens + base + col - 1, (col >= 1) & (col <= length), EOS))
+    t2 = tl.where(col == 0, older, tl.where(col == 1, previous,
+                  tl.load(tokens + base + col - 2, (col >= 2) & (col <= length + 1), EOS)))
+    t2 = tl.where(t1 == EOS, EOS, t2)
+    mix = (t0 * tl.load(multipliers)) ^ (t1 * tl.load(multipliers + 1))
+    mix = tl.where(head < 8, mix, mix ^ (t2 * tl.load(multipliers + 2)))
+    sizes = tl.load(vocab_sizes + head)
+    remainder = mix % sizes
+    ids = tl.where(remainder < 0, remainder + sizes, remainder) + tl.load(offsets + head)
+    tl.store(output + row * 128 + lane, ids)
+
+
+def k7_ple_ids(tokens, locs, lengths, slots, history, embedding):
+    requests = slots.numel()
+    if (embedding.ngram_size != 3 or embedding.ngram_heads != 16
+            or history.shape[1:] != (2,) or not tokens.is_xpu
+            or locs is None or locs.shape != tokens.shape
+            or tokens.numel() != requests * 8
+            or (lengths is not None and lengths.numel() < requests)):
+        return None
+    params = (embedding.layer_multipliers, embedding.ngram_heads_vocab_sizes,
+              embedding.ngram_heads_offsets)
+    if any(t.device != tokens.device or not t.is_contiguous()
+           for t in (slots, history, tokens, locs, *params)):
+        return None
+    if lengths is not None and (lengths.device != tokens.device or not lengths.is_contiguous()):
+        return None
+    result = torch.empty((tokens.numel(), 16), dtype=torch.int64, device=tokens.device)
+    _k7_ple_hash[(requests,)](
+        tokens, slots, locs, lengths, history, *params, result, embedding.eos_token_id,
+        lengths is not None, num_warps=4,
+    )
+    return result

index 0000000000000000000000000000000000000000..733f09c9aa89087a0446da406d7a2eb92851848e
--- /dev/null
+++ b/python/sglang/srt/speculative/proposal_exchange.py
@@ -0,0 +1,41 @@
+"""Exchange the native BF16 score and a local token index in one 32-bit word."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pack(scores, local_ids, words, K: tl.constexpr):
+    row = tl.program_id(0)
+    x = row * K + tl.arange(0, K)
+    bits = tl.load(scores + x).to(tl.uint16, bitcast=True).to(tl.uint32)
+    local = tl.load(local_ids + x).to(tl.uint32)
+    tl.store(words + x, (bits << 16) | local)
+
+
+@triton.jit
+def _unpack(words, scores, ids, SHARD: tl.constexpr, K: tl.constexpr, TP: tl.constexpr):
+    row = tl.program_id(0)
+    col = tl.arange(0, TP * K)
+    rank = col // K
+    # all_gather_into_tensor concatenates rank-local [rows, K] tensors.
+    word = tl.load(words + (rank * tl.num_programs(0) + row) * K + col % K).to(tl.uint32)
+    bits = (word >> 16).to(tl.uint16)
+    tl.store(scores + row * TP * K + col, bits.to(tl.bfloat16, bitcast=True).to(tl.float32))
+    tl.store(ids + row * TP * K + col, rank * SHARD + (word & 65535))
+
+
+def exchange(group, scores, local_ids, shard):
+    rows, k = scores.shape
+    tp = group.world_size
+    payload = scores.new_empty((rows, k), dtype=torch.int32)
+    gathered = payload.new_empty((tp * rows, k))
+    _pack[(rows,)](scores, local_ids, payload, k, num_warps=1)
+    group.all_gather_into_tensor(gathered, payload)
+    merged_scores = scores.new_empty((rows, tp * k), dtype=torch.float32)
+    merged_ids = payload.new_empty((rows, tp * k))
+    _unpack[(rows,)](gathered, merged_scores, merged_ids, shard, k, tp, num_warps=1)
+    # Keep exactly the existing FP32 global top-k and rank-major order of ties.
+    values, positions = torch.topk(merged_scores, k, dim=-1)
+    return merged_ids.gather(-1, positions).long(), values, None
diff --git a/python/sglang/srt/speculative/round_exchange.py b/python/sglang/srt/speculative/round_exchange.py
new file mode 100644
index 0000000000000000000000000000000000000000..526dce649ad92f1f3646aa0d15a2ed56731196db
--- /dev/null
+++ b/python/sglang/srt/speculative/round_exchange.py
@@ -0,0 +1,49 @@
+"""Single-host TP agreement for draft admission and packed target selection."""
+from dataclasses import dataclass
+
+from sglang.srt.managers.scheduler_components.shm_tag_exchange import ShmTagExchange, fold_u64
+from sglang.srt.runtime_context import get_parallel
+
+
+class RoundExchange(ShmTagExchange):
+    def post(self, values):
+        # Match ShmTagExchange.allgather, but let the caller stage local GPU
+        # inputs between publishing this rank's decision and reading peers.
+        self.seq += 1
+        tag = self.seq & ((1 << 23) - 1)
+        base = (self.seq & 1) * self.rows * self.width
+        self._store(base + self.rank * self.width, values, tag)
+        return Ticket(self, base, len(values), tag)
+
+
+@dataclass
+class Ticket:
+    exchange: RoundExchange
+    base: int
+    columns: int
+    tag: int
+
+    def read(self):
+        return self.exchange._wait_rows(self.base, self.columns, self.tag)
+
+
+_exchanges = {}
+
+
+def channel(kind):
+    group = get_parallel().tp_group.cpu_group
+    key = (group, kind)
+    if key not in _exchanges:
+        # Called in the same order as the original group-wide Gloo vote.
+        # The private campaign TP4 group uses four devices in one container.
+        from sglang.srt.distributed.parallel_state import in_the_same_node_as
+        if not all(in_the_same_node_as(group, source_rank=0)):
+            _exchanges[key] = None
+        else:
+            _exchanges[key] = RoundExchange(group, "flashnext_" + kind, width=3)
+    return _exchanges[key]
+
+
+def target_vote(route, grant):
+    exchange = channel("verify")
+    return exchange.post((route, *fold_u64(grant))) if exchange is not None else None
diff --git a/python/sglang/srt/speculative/row_scatter.py b/python/sglang/srt/speculative/row_scatter.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab34dbd5f463b909e057d57f6006c7b60ffbbd18
--- /dev/null
+++ b/python/sglang/srt/speculative/row_scatter.py
@@ -0,0 +1,29 @@
+"""Preserve the original BF16 collective partition before extracting complete HC rows."""
+import torch
+
+
+def reduce_rows(group, partial):
+    rows,hidden=partial.shape
+    rank=group.rank_in_group
+    local_rows=(rows+3)//4
+    quarter=partial.numel()//4
+    local=partial.new_empty(quarter)
+    group.reduce_scatter_tensor(local,partial.contiguous().view(-1))
+    if rows%4==0:
+        return local.view(local_rows,hidden)
+    # The four unpadded element partitions are the original collective's
+    # partitions. Only the first few words of the next partition are needed
+    # at a partial-row boundary. Padding before reduction changes BF16 order.
+    span=local_rows*hidden
+    gap=span-quarter
+    edges=partial.new_empty((4,3*gap))
+    group.all_gather_into_tensor(edges.view(-1),local[:3*gap])
+    out=partial.new_empty(span)
+    tail=local[rank*gap:]
+    out[:len(tail)].copy_(tail)
+    if rank<3:
+        out[len(tail):].copy_(edges[rank+1,:(rank+1)*gap])
+    else:
+        out[len(tail):].zero_()
+    return out.view(local_rows,hidden)
+
diff --git a/python/sglang/srt/speculative/segment_owner.py b/python/sglang/srt/speculative/segment_owner.py
new file mode 100644
index 0000000000000000000000000000000000000000..989267afa14d9335c5616972dcd4ddd7713dab45
--- /dev/null
+++ b/python/sglang/srt/speculative/segment_owner.py
@@ -0,0 +1,49 @@
+"""Sample only the first reachable terminal within each rank's contiguous chain segment."""
+import torch
+from sglang.srt.speculative import flashnext_dflash2 as standard
+
+
+def local(target,chain,support,q_rows,draws,rank):
+    rows=len(target)
+    first=rank*rows
+    last=first+rows
+    positions=torch.arange(first,last,device=target.device)
+    lanes,steps=positions//8,positions%8
+    edge=steps.clamp_max(6)
+    ids,weights=support[lanes,edge],q_rows[lanes,edge]
+    proposed=chain[lanes,edge+1]
+    p=target.gather(1,proposed[:,None]).flatten()
+    q=torch.where(ids==proposed[:,None],weights,0.).sum(1)
+    valid=((p>=0)&(p<=1)&(q>0)&(q<=1)&((weights>=0)&(weights<=1)).all(1)
+           &((weights.sum(1)-1).abs()<=16*torch.finfo(torch.float32).eps))
+    hit=(steps<7)&valid&((p>=q)|(draws[lanes,edge].double()*q.double()<p.double()))
+    # An all-accepted segment reports 8. A segment containing position 7
+    # always supplies a possible full-accept bonus. The global minimum picks
+    # the first true rejection or that bonus without another collective.
+    offsets=torch.where(hit,8,steps)
+    first_lane,last_lane=first//8,(last-1)//8
+    decisions=[]
+    for lane in range(first_lane,last_lane+1):
+        lo=max(first,lane*8)-first
+        hi=min(last,(lane+1)*8)-first
+        decisions.append(offsets[lo:hi].amin())
+    picked=torch.stack(decisions)
+    owners=torch.arange(first_lane,last_lane+1,device=target.device)
+    idx=(owners*8+picked-first).clamp(0,rows-1)
+    terminal=target.index_select(0,idx)
+    chosen_ids,chosen_q=support[owners,picked.clamp_max(6)],q_rows[owners,picked.clamp_max(6)]
+    subtract=picked<7
+    terminal.scatter_(1,chosen_ids,(terminal.gather(1,chosen_ids)-chosen_q*subtract[:,None]).clamp_min(0))
+    terminal[:,0].masked_fill_(subtract & ~valid.index_select(0,idx),float("nan"))
+    recovery=standard.sample_probs(terminal,draws[owners,7],report_in_result=True)
+    result=chain.new_full((len(chain),2),8)
+    result[first_lane:last_lane+1,0].copy_(picked)
+    result[first_lane:last_lane+1,1].copy_(recovery)
+    return result
+
+
+def resolve(all_rows,requests):
+    offsets,tokens=all_rows.view(4,requests,2).unbind(-1)
+    counts,owners=offsets.min(0)
+    picked=tokens.gather(0,owners[None]).flatten()
+    return counts.int(),picked.contiguous(),torch.zeros_like(counts,dtype=torch.int32)

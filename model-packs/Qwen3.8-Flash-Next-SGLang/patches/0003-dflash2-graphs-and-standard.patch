+                )
+                num_kept = tl.zeros((), dtype=tl.uint32)
+
+                # Top-p only path
+                final_pivot = tl.log(p_pivot * sum_exp_logits) + max_sample
+
+        # Publish the original pivot and duplicate quota. Duplicate tokens
+        # are kept in increasing vocabulary index, including across tiles.
+        active_pivot = tl.where(final_pivot < max_logit, final_pivot, -float("inf"))

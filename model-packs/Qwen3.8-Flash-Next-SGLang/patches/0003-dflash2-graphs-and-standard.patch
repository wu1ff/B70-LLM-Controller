+        req = tl.load(rows + row // 8, live, 0).to(tl.int64)
+        page = tl.load(pages + req * IN_PAGE_STRIDE + col * PAGE_SIZE, live, 0) // PAGE_SIZE
+    else:
+        page = tl.load(pages + (row // 8) * IN_PAGE_STRIDE + col, live, 0)
+    tl.store(pages_out + row * OUT_PAGE_STRIDE + col, page, live)
+

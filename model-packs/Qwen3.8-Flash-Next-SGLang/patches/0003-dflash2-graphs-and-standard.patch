+    order = tl.where(score != score, 2147483647, order).to(tl.int64)
+    key = (order << 32) | (4294967295 - gid.to(tl.int64))
+    tl.store(partials + row * tl.num_programs(1) + tile, tl.max(tl.where(live, key, -9223372036854775807), 0))
+
+
+def local_winners(shard, ids, initially_open, rank, vocab):
+    rows, width = shard.shape
+    blocks = triton.cdiv(width, 1024)
+    parts = torch.empty((rows, blocks), dtype=torch.int64, device=shard.device)
+    _local_keys[(rows, blocks)](
+        shard, ids, initially_open, parts, width, vocab, rank,
+        THINK_CLOSE, TOOL_START, *EOS_IDS, 1024, num_warps=4,
+    )
+    return parts.amax(1)
+
+
+def merge_keys(keys):
+    return 4294967295 - (keys.amax(0) & 4294967295)
+
+
+class PackedHead:
+    def __init__(self, processor, full, ids):
+        self.processor = processor
+        self.full = full
+        self.ids = ids
+        self.local = None
+        self.open = torch.zeros(len(ids) // 8, device=ids.device, dtype=torch.bool)
+        self.open_value = (False,) * len(self.open)
+        self.full_graph = self.greedy_graph = None
+        self.greedy_checks = 0
+        self.owner_graph = None
+        self.owner_checks = 0
+        self.owner_reference = None
+
+    def intercept(self, logits, logits_metadata, use_buffer):
+        if (self.local is not None or not use_buffer or logits_metadata.next_token_logits_buffer is not self.full
+                or self.processor.final_logit_softcapping or not logits.is_contiguous()
+                or not logits.is_xpu or logits.dtype != torch.bfloat16 or len(logits) != len(self.full)
+                or self.full.dtype != torch.float32 or not self.full.is_contiguous()
+                or self.full.shape[1] > logits.shape[1] * 4
+                or self.full.shape[1] <= logits.shape[1] * 3):
+            raise RuntimeError("Unexpected packed BF16 vocabulary gather geometry")
+        # Before the gather, the existing FP32 output rail is unused. Publish
+        # the local projection in that rail, then gather into separate storage
+        # before overwriting it with FP32 in the ordinary suffix.
+        self.local = self.full.view(torch.bfloat16).flatten()[:logits.numel()].view_as(logits)
+        self.local.copy_(logits)
+        return self.full
+
+    def capture(self, pool):
+        if self.local is None:
+            return
+        group = get_parallel().tp_group
+        assert group.world_size == 4 and self.full.shape[1] == self.processor.vocab_size
+        meta = SimpleNamespace(next_token_logits_buffer=self.full)
+
+        def resolve():
+            keys = local_winners(self.local, self.ids, self.open, group.rank_in_group, self.processor.vocab_size)
+            gathered = keys.new_empty((4, len(keys)))
+            group.all_gather_into_tensor(gathered.view(-1), keys)
+            return merge_keys(gathered)
+
+        # Precompile Triton kernels and initialize collective devices outside
+        # either suffix capture. Both suffixes reuse the trunk's graph pool.
+        resolve()
+        self.full_graph = torch.xpu.XPUGraph()
+        with torch.xpu.graph(self.full_graph, pool=pool):
+            self.processor._gather_softcap_fused(self.local, meta, True)
+        self.greedy_graph = torch.xpu.XPUGraph()
+        with torch.xpu.graph(self.greedy_graph, pool=pool):
+            self.winner = resolve()
+        if len(self.local) in (8, 16, 24, 32):
+            from sglang.srt.speculative.owned_standard import capture_exchange
+            self.owner_graph = capture_exchange(self, pool)
+
+    def replay_owner(self, check):
+        self.owner_reference = None
+        self.owner_graph.replay()
+        if check or self.owner_checks < 2:
+            rank = get_parallel().tp_group.rank_in_group
+            expected_owner = self.owned.clone()
+            self.full_graph.replay()
+            rows = len(expected_owner)
+            if not torch.equal(self.full[rank*rows:(rank+1)*rows], expected_owner):
+                raise RuntimeError("Target row owner disagrees with the full vocabulary gather")
+            if check:
+                return None
+            self.owner_checks += 1
+            self.owner_reference = self.full
+            return expected_owner
+        return self.owned
+
+    def replay(self, open_rows, check, requests):
+        if self.local is None:
+            return None
+        if open_rows is None:
+            self.full_graph.replay()
+            return None
+        if self.open_value != open_rows:
+            source = torch.tensor(open_rows, dtype=torch.bool, pin_memory=True)
+            self.open.copy_(source, non_blocking=True)
+            self.open_value = open_rows
+        self.greedy_graph.replay()
+        if check or self.greedy_checks < 2:
+            self.full_graph.replay()
+            # Apply the dense reference EOS guard to just the two affected
+            # vocabulary columns. Restore the original columns for subsequent
+            # graph admission, which compares every unadjusted logit.
+            from sglang.srt.speculative.flashnext_dflash2 import mask_reasoning_eos
+            original = self.full[:, list(EOS_IDS)].clone()
+            mask_reasoning_eos(self.full, requests, self.ids.view(-1, 8))
+            expected = self.full.argmax(-1)
+            self.full[:, list(EOS_IDS)] = original
+            if not torch.equal(expected, self.winner):
+                raise RuntimeError("Packed greedy shard winner disagrees with dense masked argmax")
+            self.greedy_checks += 1
+            import logging
+            logging.getLogger(__name__).info(
+                "Flash Next packed target key=greedy-head admission=%d rows=%d exact=True",
+                self.greedy_checks, len(self.winner),
+            )
+            return None
+        return self.winner
diff --git a/python/sglang/srt/speculative/head_admission.py b/python/sglang/srt/speculative/head_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..f4f6069303c6f6a18d86d40d015dccd77563b32c
--- /dev/null
+++ b/python/sglang/srt/speculative/head_admission.py
@@ -0,0 +1,57 @@
+"""Check the actual local LM projection on the existing eager warmup before capture."""
+from contextlib import contextmanager
+from dataclasses import replace
+import logging
+
+import torch
+import torch.distributed as dist
+
+from sglang.srt.runtime_context import get_parallel
+
+log = logging.getLogger(__name__)
+
+class HeadAdmission:
+    def __init__(self, processor, rows, bind):
+        self.processor, self.rows, self.bind = processor, rows, bind
+        self.observations = []
+        self.allowed = False
+
+    @contextmanager
+    def warm(self):
+        processor, bind = self.processor, self.bind
+        original = processor._can_gather_softcap_fused
+
+        def observe(logits, local_hidden, lm_head, metadata):
+            ordinary = original(logits, local_hidden, lm_head, metadata)
+            # The capture has a fixed non-null output buffer; this check
+            # reads only its presence, so avoid allocating a second buffer.
+            with (bind(processor, "_flashnext_packed_logits", True),
+                  bind(processor, "defer_verify_gather", False)):
+                scoped = original(logits, local_hidden, lm_head,
+                                  replace(metadata, next_token_logits_buffer=logits))
+            valid = (scoped and get_parallel().tp_group.world_size == 4
+                     and logits.shape[0] == self.rows
+                     and logits.shape[1] * 3 < processor.vocab_size <= logits.shape[1] * 4)
+            self.observations.append((bool(valid), tuple(logits.shape), str(logits.dtype), bool(ordinary)))
+            return ordinary
+
+        with bind(processor, "_can_gather_softcap_fused", observe):
+            yield
+        vote = torch.tensor(int(len(self.observations) == 1 and self.observations[0][0]),dtype=torch.int32)
+        dist.all_reduce(vote, op=dist.ReduceOp.MIN, group=get_parallel().tp_group.cpu_group)
+        self.allowed = bool(vote.item())
+        log.info("Packed vocabulary eligibility rows=%d all_ranks=%s observed=%s",
+                 self.rows,self.allowed,self.observations)
+
+    @contextmanager
+    def capture(self, head):
+        if not self.allowed:
+            yield
+            return
+        with (self.bind(self.processor,"defer_verify_gather",False),
+              self.bind(self.processor,"_gather_softcap_fused",head.intercept)):
+            yield
+        if head.local is None:
+            raise RuntimeError("Qualified packed projection did not reach its capture owner")
+        log.info("Packed vocabulary intercepted rows=%d BF16_shard=%s FP32_rail_alias=%s",
+                 self.rows, tuple(head.local.shape), head.local.data_ptr() == head.full.data_ptr())
diff --git a/python/sglang/srt/speculative/next_ple.py b/python/sglang/srt/speculative/next_ple.py
new file mode 100644
index 0000000000000000000000000000000000000000..30ee5d9a27d52fd4ebe0ac39474de503b410d395
--- /dev/null
+++ b/python/sglang/srt/speculative/next_ple.py
@@ -0,0 +1,75 @@
+"""Gather a certified next draft's disk PLE rows into private, bounded host storage."""
+from concurrent.futures import ThreadPoolExecutor
+
+import numpy as np
+import torch
+
+from sglang.srt.mem_cache.ple_state_pool import NGRAM_PART
+from sglang.srt.speculative.flashnext_cycle import k7_ple_ids
+
+
+def _read(disk, host, ready):
+    ready.synchronize()
+    ids = host.view(-1).numpy()
+    # Private pinned output and independent indices let a discarded ticket
+    # finish without borrowing the active prefill stage or its native worker.
+    width = disk.stage.shape[1]
+    rows = torch.empty((len(ids),width),dtype=torch.int16,pin_memory=True)
+    words = rows.numpy().view(np.uint16)
+    owned = (ids >= disk.start) & (ids < disk.end)
+    words.fill(0)
+    words[owned] = disk.table[ids[owned]]
+    return rows,ids
+
+
+@torch.inference_mode()
+def prepare(worker, batch, ticket, locations):
+    packed = getattr(worker.target_worker,"_flashnext_packed",None)
+    if packed is None:
+        return None
+    n = len(batch.reqs)
+    longest = max(o[-1] for o in ticket.grant.owners)
+    key = packed.key(n, longest+1)
+    if key is None or packed.key(n, longest+8) != key:
+        return None
+    entry = packed.entries.get(key)
+    if entry is None or entry.checks < 2 or not entry.ple_host_ids or len(entry.ple_host_ids) != 1:
+        return None
+    layer, = entry.ple_host_ids
+    embed = packed.runner.model.model.layers[layer].ple.ple_embedding
+    disk = embed.ngram_embedding.intel_disk_ple
+    prior = getattr(worker,"_a0041_ple_future",None)
+    if disk is None or (prior is not None and not prior.done()):
+        return None
+    # Propagate any I/O error even when the scheduler discarded its ticket.
+    if prior is not None:
+        prior.result()
+    router = packed.runner.token_to_kv_pool.layer_router
+    router.wait_for_part(NGRAM_PART)
+    history = router.part_view(NGRAM_PART).context
+    if history is None:
+        return None
+    linear = packed.backend.linear_attn_backend
+    slots = linear._translate_mamba_indices(packed.runner.req_to_token_pool.get_mamba_indices(batch.req_pool_indices))
+    chain = ticket.chain.flatten()
+    ids = k7_ple_ids(chain,locations.flatten(),None,slots,history,embed)
+    if ids is None:
+        return None
+    host = torch.empty_like(ids,device="cpu",pin_memory=True)
+    host.copy_(ids,non_blocking=True)
+    ready = torch.xpu.current_stream(ids.device).record_event()
+    if not hasattr(worker,"_a0041_ple_executor"):
+        worker._a0041_ple_executor = ThreadPoolExecutor(max_workers=1,thread_name_prefix="ahead-ple")
+    future = worker._a0041_ple_executor.submit(_read,disk,host,ready)
+    worker._a0041_ple_future = future
+    pending = [(disk,ids,host,entry.batch.flashnext_ple_rows[layer])]
+    return entry,pending,ready,future
+
+
+def compare(ahead, ordinary):
+    if ordinary is None or ahead[0] is not ordinary[0] or ordinary[3] is None:
+        raise RuntimeError("Ahead PLE entry or gather does not match the authorized target")
+    future_rows,future_ids = ahead[3].result()
+    actual_rows,actual_ids = ordinary[3].result()
+    if not np.array_equal(future_ids,actual_ids) or not torch.equal(future_rows,actual_rows):
+        raise RuntimeError("Ahead PLE differs from ordinary live hashes or BF16 rows")
diff --git a/python/sglang/srt/speculative/owned_standard.py b/python/sglang/srt/speculative/owned_standard.py
new file mode 100644
index 0000000000000000000000000000000000000000..f21206d0eb95a60ce6015ca87109989e27fcd27f
--- /dev/null
+++ b/python/sglang/srt/speculative/owned_standard.py
@@ -0,0 +1,102 @@
+"""Run one full K7 STANDARD verifier per TP rank for eligible C4 decode."""
+import json
+import logging
+from types import SimpleNamespace
+import torch
+import torch.distributed as dist
+
+from sglang.kernels.ops.activation.softcap import gathered_softcap_logits
+from sglang.srt.runtime_context import get_parallel
+from sglang.srt.speculative import flashnext_dflash2
+
+
+def capture_exchange(head, pool):
+    group = get_parallel().tp_group
+    assert len(head.local) in (8, 16, 24, 32) and group.world_size == 4
+    rows = len(head.local) // group.world_size
+    # The BF16 outgoing shard occupies less than the first quarter of full.
+    # The chosen FP32 destination occupies the final quarter and is disjoint.
+    head.owned = head.full[-rows:]
+    assert head.owned.data_ptr() >= head.local.data_ptr() + head.local.nbytes
+
+    def exchange():
+        received = head.local.new_empty((4, rows, head.local.shape[-1]))
+        group.all_to_all_single(received.flatten(0,1), head.local)
+        gathered_softcap_logits(received, None, head.owned)
+
+    exchange()
+    graph = torch.xpu.XPUGraph()
+    with torch.xpu.graph(graph, pool=pool):
+        exchange()
+    return graph
+
+
+def _admit(raw, candidates, support, q_rows, info, reqs, uniforms, rank, owned_probs, decisions):
+    from vllm.v1.sample.ops.topk_topp_triton import apply_top_k_top_p_triton
+    # This dense 32-row path uses the independent installed donor, including
+    # full-width FP32 temperature and optional min-p, top-k and top-p.
+    with torch.inference_mode():
+        flashnext_dflash2.mask_reasoning_eos(raw, reqs, candidates)
+        scaled = raw / info.temperatures.repeat_interleave(8, dim=0)
+        if info.need_min_p_sampling:
+            floor = info.min_ps.repeat_interleave(8).log()
+            scaled.masked_fill_(scaled < scaled.amax(-1, keepdim=True) + floor[:,None], -torch.inf)
+        masked = apply_top_k_top_p_triton(scaled, info.top_ks.repeat_interleave(8).int(),
+                                          info.top_ps.repeat_interleave(8).float())
+        full = masked.softmax(-1).view(4,8,-1)
+        same_probs = torch.equal(full[rank:rank+1], owned_probs)
+        counts, final, _, _ = flashnext_dflash2.verify_standard_sparse(
+            candidates, full, support, q_rows, uniforms[:,:-1], uniforms[:,-1],
+        )
+        same_decisions = torch.equal(decisions[:,0],counts.long()) and torch.equal(decisions[:,1],final)
+    good = torch.tensor(int(same_probs and same_decisions), dtype=torch.int32)
+    dist.all_reduce(good,op=dist.ReduceOp.MIN,group=get_parallel().tp_group.cpu_group)
+    if not good.item():
+        raise RuntimeError("Owned C4 STANDARD differs from full-row v6 probability or recovery oracle")
+    logging.getLogger(__name__).info(
+        "Flash Next packed target key=sampled-owner admission=exact rank=%d probability_words=%d decisions=4",
+        rank, owned_probs.numel(),
+    )
+
+
+def verify(candidates, local_logits, support, conditional_q, info, evaluation, *, prefix_lens, trace):
+    if len(candidates) <= 4:
+        from sglang.srt.speculative.position_owner import verify as positions
+        return positions(candidates, local_logits, support, conditional_q, info, evaluation, prefix_lens, trace)
+    group = get_parallel().tp_group
+    rank = group.rank_in_group
+    sl = slice(rank, rank + 1)
+    assert candidates.shape == (4,8) and local_logits.shape[0] == 8
+    # Keep the original batch flags and whole-vocabulary temperature, pivot,
+    # FP32 softmax and recovery arithmetic. Only row ownership has changed.
+    settings = SimpleNamespace(
+        top_ks=info.top_ks[sl], top_ps=info.top_ps[sl], min_ps=info.min_ps[sl],
+        max_top_k=info.max_top_k, need_min_p_sampling=info.need_min_p_sampling,
+        need_top_k_sampling=info.need_top_k_sampling, need_top_p_sampling=info.need_top_p_sampling,
+        is_any_greedy=info.is_any_greedy,
+    )
+    scaled = local_logits / info.temperatures[sl]
+    target = flashnext_dflash2.reference_distribution(scaled, settings, width=8).view(1,8,-1)
+    draws = evaluation.draws
+    # Replicate rank zero's sampled uniforms, including its independent
+    # rejection-recovery/bonus draw, before the owners make their decisions.
+    group.broadcast(draws, src=0)
+    accepted, bonus, p, q = flashnext_dflash2.verify_standard_sparse(
+        candidates[sl], target, support[sl], conditional_q[sl], draws[sl,:-1], draws[sl,-1],
+        report_in_result=getattr(evaluation, "report_mass_error", False),
+    )
+    local = torch.stack((accepted.long(),bonus),dim=-1)
+    decisions = local.new_empty((4,2))
+    group.all_gather_into_tensor(decisions, local)
+    reference = evaluation.flashnext_owner_reference
+    if reference is not None:
+        _admit(reference, candidates, support, conditional_q, info, evaluation.batch.reqs,
+               draws, rank, target, decisions)
+    count, final = decisions.unbind(-1)
+    if trace:
+        logging.getLogger(__name__).info("Flash Next DFlash2 STANDARD owned %s", json.dumps(dict(
+            rank=rank, prefix=prefix_lens[sl].tolist(), candidates=candidates[sl].tolist(),
+            support=support[sl].tolist(), q_rows=conditional_q[sl].tolist(), p=p.tolist(), q=q.tolist(),
+            uniforms=draws[sl].tolist(), accepted=accepted.tolist(), bonus=bonus.tolist(),
+        )))
+    return count.int(), final.contiguous(), torch.zeros_like(count,dtype=torch.int32)
diff --git a/python/sglang/srt/speculative/paged_draft.py b/python/sglang/srt/speculative/paged_draft.py
new file mode 100644
index 0000000000000000000000000000000000000000..6480663115f8437ae2a27e8bbba06c8eaae8b1dc
--- /dev/null
+++ b/python/sglang/srt/speculative/paged_draft.py
@@ -0,0 +1,70 @@
+"""Use v6 noncausal attention over the resident BF16 draft window."""
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.mem_cache.kv.alloc.id_space import IdSpaceKind
+from sglang.srt.model_executor.forward_context import get_attn_backend
+
+
+@triton.jit
+def _fill_pages(indptr, locations, writes, table, lengths, PAGE: tl.constexpr,
+                WINDOWED: tl.constexpr = False):
+    req = tl.program_id(0)
+    first = tl.load(indptr + req)
+    prefix = tl.load(indptr + req + 1) - first
+    # The worker supplies at most the final 2047 committed keys. Extend
+    # the table to the physical beginning of the first page so each tile
+    # can use the donor's normal aligned block descriptor. Its sliding
+    # mask excludes these earlier words for each of the eight queries.
+    if WINDOWED:
+        offset = tl.load(locations + first, prefix > 0, 0) % PAGE
+        page = tl.arange(0, 32)
+        pos = tl.maximum(page * PAGE - offset, 0)
+        columns: tl.constexpr = 32
+    else:
+        offset = 0
+        page = tl.arange(0, 16)
+        pos = page * PAGE
+        columns: tl.constexpr = 16
+    live_prefix = pos < prefix
+    live_query = (pos >= prefix) & (pos < prefix + 8)
+    a = tl.load(locations + first + pos, live_prefix, 0)
+    b = tl.load(writes + req * 8 + pos - prefix, live_query, 0)
+    tl.store(table + req * columns + page, tl.where(live_prefix, a, b) // PAGE)
+    tl.store(lengths + req, offset + prefix + 8)
+
+
+def attention(layer, q, k, v, batch):
+    from sglang.srt.layers.attention.triton_backend import KVWriteLoc
+    from vllm.v1.attention.ops.triton_unified_attention import unified_attention
+
+    backend = get_attn_backend()
+    meta = backend.forward_metadata
+    rail = meta.windows[IdSpaceKind.FULL]
+    requests = batch.batch_size
+    if layer.layer_id == 0 or batch.flashnext_draft_pages is None:
+        columns = 32 if batch.flashnext_draft_windowed else 16
+        table = torch.empty((requests, columns), device=q.device, dtype=torch.int32)
+        lengths = torch.empty(requests, device=q.device, dtype=torch.int32)
+        _fill_pages[(requests,)](
+            rail.kv_indptr, rail.kv_indices, batch.out_cache_loc, table, lengths, 128, batch.flashnext_draft_windowed,
+        )
+        batch.flashnext_draft_pages = table, lengths
+    else:
+        table, lengths = batch.flashnext_draft_pages
+
+    backend._set_kv_buffer(batch, layer, KVWriteLoc.for_batch(batch), k, v)
+    key, value = backend.kv_layers.read(layer.layer_id).kv()
+    query = q.reshape(requests * 8, 8, 128).contiguous()
+    output = torch.empty_like(query)
+    unified_attention(
+        q=query, k=key.view(-1, 128, 2, 128), v=value.view(-1, 128, 2, 128),
+        out=output, cu_seqlens_q=meta.qo_indptr, max_seqlen_q=8,
+        seqused_k=lengths, max_seqlen_k=(128 - 1 + 2047 + 8 if batch.flashnext_draft_windowed else 2048),
+        softmax_scale=layer.scaling, causal=False,
+        window_size=(2047 if batch.flashnext_draft_windowed else -1, -1), block_table=table, softcap=0.,
+        q_descale=None, k_descale=None, v_descale=None, use_td=True,
+    )
+    return output.flatten(1)
diff --git a/python/sglang/srt/speculative/pages_transfer.py b/python/sglang/srt/speculative/pages_transfer.py
new file mode 100644
index 0000000000000000000000000000000000000000..67d2cc5bbb017f2a581216cd6c6fb3ac11b6e6c3
--- /dev/null
+++ b/python/sglang/srt/speculative/pages_transfer.py
@@ -0,0 +1,96 @@
+"""Bounded transactional exchange for the ten same-shape, BF16 draft KV buffers."""
+from itertools import islice
+
+import torch
+
+
+BATCH = 16
+
+
+def _copy_runs(buffers, staging, runs, page_size, *, to_host):
+    for row, buf in enumerate(buffers):
+        for start, stop, slot in runs:
+            device = buf[slot * page_size:(slot + stop-start) * page_size]
+            host = staging[row, start:stop].view_as(device)
+            if to_host:
+                host.copy_(device, non_blocking=True)
+            else:
+                device.copy_(host, non_blocking=True)
+
+
+def exchange(cache, missing, page_size):
+    """Commit each bounded window, retaining exact backing for rollback until publication."""
+    buffers = cache.buffers
+    stream = torch.xpu.current_stream(buffers[0].device)
+    generation = cache.mapping_generation + 1
+    for first in range(0, len(missing), BATCH):
+        pages = missing[first:first+BATCH]
+        victims = list(islice(cache.resident.items(), len(pages)))
+        pairs = [(old, slot, new) for (old,slot),new in zip(victims,pages,strict=True)]
+        physical = sorted(pairs, key=lambda item:item[1])
+        runs = []
+        for i, (_,slot,_) in enumerate(physical):
+            if runs and slot == runs[-1][2] + i-runs[-1][0]:
+                runs[-1] = (runs[-1][0],i+1,runs[-1][2])
+            else:
+                runs.append((i,i+1,slot))
+        stage = torch.empty((len(buffers),len(pages),page_size,*buffers[0].shape[1:]),
+                            dtype=buffers[0].dtype,device="cpu",pin_memory=True)
+        _copy_runs(buffers,stage,runs,page_size,to_host=True)
+        stream.synchronize()
+        restore_count = sum(new in cache.backing for _,_,new in pairs)
+        backups = {}
+        next_backing = cache.backing.copy()
+        next_resident = cache.resident.copy()
+        # Allocate all independent pageable backups before touching a victim.
+        for i,(old,slot,new) in enumerate(physical):
+            previous = stage[:,i]
+            saved = torch.empty(previous.shape,dtype=previous.dtype,device="cpu",pin_memory=False)
+            saved.copy_(previous)
+            backups[old] = next_backing[old] = saved
+            incoming = next_backing.pop(new,None)
+            if incoming is None:
+                if restore_count:
+                    previous.zero_()
+            elif isinstance(incoming,torch.Tensor):
+                previous.copy_(incoming)
+            else:
+                torch.stack(incoming,out=previous)
+        del previous, incoming
+        for old,slot,new in pairs:
+            del next_resident[old]
+            next_resident[new] = slot
+        # The host LRU is in request order regardless of physical transfer order.
+        old_ids,slots,new_ids = zip(*pairs)
+        ids = torch.tensor(old_ids+new_ids,device=cache.mapping.device)
+        before = cache.mapping.index_select(0,ids)
+        values = torch.tensor((-1,)*len(slots)+slots,device=cache.mapping.device,dtype=cache.mapping.dtype)
+        try:
+            if restore_count:
+                _copy_runs(buffers,stage,runs,page_size,to_host=False)
+            else:
+                # Fresh pages need a device zero fill, not a PCIe upload.
+                for dest in buffers:
+                    for start,stop,slot in runs:
+                        dest[slot*page_size:(slot+stop-start)*page_size].zero_()
+            cache.mapping.index_copy_(0,ids,values)
+            stream.synchronize()
+        except BaseException:
+            # Keep the old mappings/owners for this window. Earlier successful
+            # windows have already published their correct generations.
+            try:
+                for old,slot,_ in pairs:
+                    for dest,src in zip(buffers,backups[old],strict=True):
+                        dest[slot*page_size:(slot+1)*page_size].copy_(src)
+                cache.mapping.index_copy_(0,ids,before)
+                stream.synchronize()
+            except BaseException as rollback_error:
+                cache._exchange_broken = True
+                cache.mapping_generation = generation
+                raise RuntimeError("Failed to recover draft page contents after transfer failure") from rollback_error
+            raise
+        cache.backing,cache.resident = next_backing,next_resident
+        cache.evictions += len(pages)
+        cache.restores += restore_count
+        cache.mapping_generation = generation
+        del stage
diff --git a/python/sglang/srt/speculative/position_owner.py b/python/sglang/srt/speculative/position_owner.py
new file mode 100644
index 0000000000000000000000000000000000000000..316604bebb1fb53f7a0b3f39d4ea1e363fa32874
--- /dev/null
+++ b/python/sglang/srt/speculative/position_owner.py
@@ -0,0 +1,140 @@
+"""Verify contiguous K7 target positions per TP rank after equal-size vocabulary exchange."""
+import logging
+import torch
+import torch.distributed as dist
+
+from sglang.srt.runtime_context import get_parallel
+from sglang.srt.speculative import flashnext_dflash2 as standard
+from sglang.srt.speculative.tiled_filter import apply_filter
+
+
+def mask(logits, reqs, chain, rank):
+    rows = len(logits)
+    flags = standard.initial_thinking_mask(reqs)
+    if any(flags):
+        opened = torch.tensor(flags,dtype=torch.bool,pin_memory=True).to(logits.device,non_blocking=True)
+        closed = ((chain == standard.THINK_CLOSE) | (chain == standard.TOOL_START)).cumsum(1).bool()
+        local = (opened[:,None] & ~closed).flatten()[rank*rows:(rank+1)*rows]
+        for token in standard.EOS_IDS:
+            logits[:,token].masked_fill_(local,-torch.inf)
+
+
+def local_decisions(target, chain, support, q_rows, draws, rank):
+    rows = len(target)
+    device = target.device
+    g = torch.arange(rank*rows,(rank+1)*rows,device=device)
+    r, pos = g//8, g%8
+    edge = pos.clamp_max(6)
+    ids, weights = support[r,edge], q_rows[r,edge]
+    proposed = chain[r,edge+1]
+    p = target.gather(1, proposed[:,None]).flatten()
+    q = torch.where(ids == proposed[:,None],weights,0.).sum(1)
+    valid = ((p >= 0) & (p <= 1) & (q > 0) & (q <= 1)
+             & ((weights >= 0) & (weights <= 1)).all(1)
+             & ((weights.sum(1)-1).abs() <= 16*torch.finfo(torch.float32).eps))
+    accepted = (pos < 7) & valid & ((p >= q) | (draws[r,edge].double()*q.double() < p.double()))
+    # Only a rejected proposal uses (p-q)+. The final position draws from p.
+    # Other rows never publish their counterfactual draw and must not subtract
+    # a zero residual from an accepted identical distribution.
+    subtract = (~accepted) & (pos < 7)
+    terminal = target.clone()
+    terminal.scatter_(1,ids,(terminal.gather(1,ids)-weights*subtract[:,None]).clamp_min(0))
+    terminal[:,0].masked_fill_((pos < 7) & ~valid, float("nan"))
+    recovery = standard.sample_probs(terminal,draws[r,7],report_in_result=True)
+    return torch.stack((accepted.long(),recovery),1).contiguous()
+
+
+def resolve(decisions, requests):
+    rows = decisions.view(requests,8,2)
+    count = rows[:,:7,0].cumprod(1).sum(1)
+    final = rows[:,:,1].gather(1,count[:,None]).flatten()
+    return count.int(), final.contiguous(), torch.zeros_like(count,dtype=torch.int32)
+
+
+class Suffix:
+    """Own the complete row-partitioned filter, rejection, recovery and rank exchange."""
+    def __init__(self, values, rank, need_min):
+        self.inputs = tuple(v.contiguous().clone() for v in values)
+        self.rank = rank
+        self.need_min = need_min
+        self.compute(*self.inputs)
+        self.graph = torch.xpu.XPUGraph()
+        with torch.xpu.graph(self.graph):
+            self.result,self.probs = self.compute(*self.inputs)
+        # The shared filter helper may replace its workspace at a larger width.
+        # Retain the external allocation and immutable tables used by this graph.
+        from vllm.v1.sample.ops import topk_topp_triton as donor
+        logits = self.inputs[0]
+        self.external = (donor._TRITON_BUFFER_CACHE[(logits.device, logits.dtype, logits.shape[1])],
+                         donor._TRITON_TABLE_CACHE[logits.device])
+
+    def compute(self,logits,chain,support,q_rows,draws,temperatures,ks,ps,mins):
+        return compute(logits,chain,support,q_rows,draws,temperatures,ks,ps,mins,self.rank,self.need_min)
+
+    def replay(self,values):
+        torch._foreach_copy_(list(self.inputs),list(values))
+        self.graph.replay()
+        return self.result,self.probs
+
+
+def compute(logits,chain,support,q_rows,draws,temperatures,ks,ps,mins,rank,need_min):
+    rows = len(logits)
+    sl = slice(rank*rows,(rank+1)*rows)
+    def local(value):
+        return value.repeat_interleave(8,dim=0)[sl]
+    scaled = logits / local(temperatures)
+    if need_min:
+        scaled.masked_fill_(scaled < scaled.amax(1,keepdim=True)+local(mins).log()[:,None],-torch.inf)
+    filtered = apply_filter(scaled,local(ks).int(),local(ps).float())
+    target = filtered.softmax(-1)
+    from sglang.srt.speculative import segment_owner
+    pair = segment_owner.local(target,chain,support,q_rows,draws,rank)
+    all_rows = pair.new_empty((4*len(chain),2))
+    get_parallel().tp_group.all_gather_into_tensor(all_rows,pair)
+    return segment_owner.resolve(all_rows,len(chain)),target
+
+
+_regions = {}
+
+
+@torch.inference_mode()
+def verify(chain, logits, support, q_rows, info, evaluation, prefix_lens, trace):
+    group = get_parallel().tp_group
+    rank = group.rank_in_group
+    bs = len(chain)
+    rows = len(logits)
+    assert chain.shape == (bs,8) and rows == 2*bs and 1 <= bs <= 4
+    sl = slice(rank*rows,(rank+1)*rows)
+    draws = evaluation.draws
+    group.broadcast(draws,src=0)
+    values = (logits,chain,support,q_rows,draws,info.temperatures,info.top_ks,info.top_ps,info.min_ps)
+    key = (bs,bool(info.need_min_p_sampling))
+    if key not in _regions:
+        from sglang.srt.speculative.budget import can_admit
+        _regions[key] = Suffix(values,rank,key[1]) if can_admit(logits.device,("position-standard",key)) else None
+    entry = _regions[key]
+    if entry is None:
+        result,target = compute(*values,rank,key[1])
+    else:
+        result,target = entry.replay(values)
+    if not getattr(evaluation,"report_mass_error",False) and (result[1] < 0).any().item():
+        raise ValueError("STANDARD terminal distribution has zero or nonfinite mass")
+    raw = evaluation.flashnext_owner_reference
+    if raw is not None:
+        from vllm.v1.sample.ops.topk_topp_triton import apply_top_k_top_p_triton
+        with torch.inference_mode():
+            standard.mask_reasoning_eos(raw,evaluation.batch.reqs,chain)
+            scaled = raw/info.temperatures.repeat_interleave(8,dim=0)
+            if info.need_min_p_sampling:
+                scaled.masked_fill_(scaled<scaled.amax(1,keepdim=True)+info.min_ps.repeat_interleave(8).log()[:,None],-torch.inf)
+            probs = apply_top_k_top_p_triton(scaled,info.top_ks.repeat_interleave(8).int(),
+                                             info.top_ps.repeat_interleave(8).float()).softmax(-1)
+            count,final,_,_ = standard.verify_standard_sparse(chain,probs.view(bs,8,-1),support,q_rows,draws[:,:7],draws[:,7])
+            good = torch.equal(probs[sl],target) and torch.equal(result[0],count) and torch.equal(result[1],final)
+        vote = torch.tensor(int(good),dtype=torch.int32)
+        dist.all_reduce(vote,op=dist.ReduceOp.MIN,group=group.cpu_group)
+        if not vote.item():
+            raise RuntimeError("Position-owner target probabilities or STANDARD decision differ")
+        logging.getLogger(__name__).info("A0041 positional STANDARD admission width=%d rank=%d probability_words=%d",
+                                         bs,rank,target.numel())
+    return result
diff --git a/python/sglang/srt/speculative/proposal.py b/python/sglang/srt/speculative/proposal.py

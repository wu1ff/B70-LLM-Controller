+"""Lossless resident cache for virtual target-page addresses used by the draft."""
+from collections import OrderedDict
+from contextlib import contextmanager
+from dataclasses import replace
+import os
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+
+# Four unaligned 2048-row windows plus speculative writes need at most 76
+# 128-row pages. Keep additional pages for prefill and page-boundary transitions.
+RESIDENT_PAGES = 96
+PAGE = 128
+
+
+FUSED_TRANSLATE = os.getenv("SGLANG_FLASHNEXT_FUSED_DRAFT_PAGES") == "1"
+
+
+@triton.jit
+def _translate_query_pages(mapping, writes, reads, writes_out, reads_out,
+                           nw: tl.constexpr, nr, page: tl.constexpr, block: tl.constexpr):
+    lane = tl.program_id(0) * block + tl.arange(0, block)
+    is_write = lane < nw
+    read_lane = lane - nw
+    is_read = (read_lane >= 0) & (read_lane < nr)
+    address = tl.load(writes + lane, is_write, 0).to(tl.int32)
+    address += tl.load(reads + read_lane, is_read, 0).to(tl.int32)
+    slot = tl.load(mapping + address // page, is_write | is_read, 0)
+    physical = slot * page + address % page
+    tl.store(writes_out + lane, physical, is_write)
+    tl.store(reads_out + read_lane, physical, is_read)
+
+
+class DraftPages:
+    def __init__(self, buffers, virtual_rows, resident_pages=RESIDENT_PAGES):
+        self.buffers = tuple(buffers)
+        self.capacity = resident_pages
+        self._exchange_broken = False
+        self._batch_exchange = (
+            os.getenv("SGLANG_FLASHNEXT_BATCH_PAGE_EXCHANGE") == "1"
+            and len(self.buffers) == 10 and self.buffers[0].is_xpu
+            and all(t.shape == self.buffers[0].shape and t.is_contiguous()
+                    and t.device == self.buffers[0].device for t in self.buffers)
+        )
+        self.resident = OrderedDict()
+        self.backing = {}
+        self.mapping = torch.full(((virtual_rows+PAGE-1)//PAGE,), -1,
+                                  dtype=torch.int32, device=buffers[0].device)
+        if any(len(t) < resident_pages*PAGE or t.dtype != torch.bfloat16 for t in buffers):
+            raise ValueError("Draft page cache requires complete BF16 pages")
+        self.evictions = self.restores = 0
+        self.mapping_generation = 0
+        self.query_writes = None
+        self.query_key = None
+        self.query_coverage = None
+
+    def translate(self, *addresses):
+        # Consume only live token locations. This short CPU transfer also orders
+        # replacement after the preceding attention/feature writes on the worker stream.
+        flat = torch.cat([a.reshape(-1) for a in addresses])
+        pages = np.unique(flat.detach().cpu().numpy() // PAGE).tolist()
+        self.make_resident(pages)
+        return tuple(self.physical_addresses(a) for a in addresses)
+
+    def make_resident(self, pages):
+        if self._exchange_broken:
+            raise RuntimeError("Draft page exchange requires a fresh worker")
+        if pages and (pages[0] < 0 or pages[-1] >= len(self.mapping) or len(pages) > self.capacity):
+            raise ValueError(f"Draft working set outside its page budget: {pages}")
+        if self._batch_exchange and len(pages) > 1 and len(self.resident) == self.capacity:
+            missing = []
+            for page in pages:
+                if page in self.resident:
+                    self.resident.move_to_end(page)
+                else:
+                    missing.append(page)
+            if not missing:
+                return
+            pages = list(dict.fromkeys(missing))
+            if len(pages) >= 2:
+                from sglang.srt.speculative.pages_transfer import exchange
+                exchange(self, pages, PAGE)
+                return
+        else:
+            for page in pages:
+                if page in self.resident:
+                    self.resident.move_to_end(page)
+        changed = {}
+        for page in pages:
+            if page in self.resident:
+                continue
+            if len(self.resident) < self.capacity:
+                slot = len(self.resident)
+            else:
+                old, slot = self.resident.popitem(last=False)
+                span = slice(slot*PAGE, (slot+1)*PAGE)
+                self.backing[old] = tuple(buf[span].cpu() for buf in self.buffers)
+                changed[old] = -1
+                self.evictions += 1
+            span = slice(slot*PAGE, (slot+1)*PAGE)
+            saved = self.backing.pop(page, None)
+            if saved is not None:
+                for buf, cpu in zip(self.buffers, saved, strict=True):
+                    buf[span].copy_(cpu)
+                self.restores += 1
+            elif self.evictions:
+                for buf in self.buffers:
+                    buf[span].zero_()
+            self.resident[page] = slot
+            changed[page] = slot
+        if changed:
+            self.mapping_generation += 1
+            ids = torch.tensor(list(changed), device=self.mapping.device)
+            values = torch.tensor(list(changed.values()), device=ids.device, dtype=torch.int32)
+            self.mapping.index_copy_(0, ids, values)
+
+    def reuse_query_writes(self, ticket, plan, addresses):
+        if self._exchange_broken:
+            raise RuntimeError("Draft page exchange requires a fresh worker")
+        owner, virtual, physical, generation = ticket
+        if (plan is not None and owner is plan and generation == self.mapping_generation
+                and addresses.shape == virtual.shape and addresses.device == virtual.device):
+            if addresses.data_ptr() == virtual.data_ptr() and addresses.dtype == virtual.dtype:
+                return physical.to(torch.int64)
+            # The same forward plan supplied both windows, up to dtype and
+            # layout normalization in the runner. Index the resident map
+            # using the append's exact addresses and keep its ordering.
+            return self.physical_addresses(addresses.long())
+        return None
+
+    def physical_addresses(self, addresses):
+        if self._exchange_broken:
+            raise RuntimeError("Draft page exchange requires a fresh worker")
+        return self.mapping[addresses.long() // PAGE].to(addresses.dtype) * PAGE + addresses % PAGE
+
+    def _query_addresses(self, writes, reads):
+        if self._exchange_broken:
+            raise RuntimeError("Draft page exchange requires a fresh worker")
+        if (not FUSED_TRANSLATE or not writes.is_xpu or writes.device != reads.device
+                or not writes.is_contiguous() or not reads.is_contiguous()):
+            return self.physical_addresses(writes), self.physical_addresses(reads)
+        writes_out, reads_out = torch.empty_like(writes), torch.empty_like(reads)
+        nw, nr = writes.numel(), reads.numel()
+        tile = 128
+        _translate_query_pages[(triton.cdiv(nw + nr, tile),)](
+            self.mapping, writes, reads, writes_out, reads_out, nw, nr, PAGE, tile,
+        )
+        return writes_out, reads_out
+
+    @contextmanager
+    def query(self, batch):
+        from sglang.srt.mem_cache.kv.alloc.id_space import IdSpaceKind
+        from sglang.srt.model_executor.forward_context import get_attn_backend
+        backend = get_attn_backend()
+        meta = backend.forward_metadata
+        if set(meta.windows) != {IdSpaceKind.FULL}:
+            raise RuntimeError("Unexpected draft attention history configuration")
+        rail = meta.windows[IdSpaceKind.FULL]
+        assert rail.out_cache_loc is None and rail.aligned_kv_indices is None
+        # The eager rail is allocated to the exact indptr end. Capture
+        # buffers may contain padding and must still consult the live extent.
+        count = rail.kv_indices.numel() if rail.kv_indices_exact else int(rail.kv_indptr[-1])
+        addresses = (batch.out_cache_loc, rail.kv_indices[:count])
+        key = self.query_key
+        coverage = self.query_coverage
+        if (key is not None and coverage is not None
+                and key == coverage[0] and self.mapping_generation == coverage[1]):
+            self.make_resident(coverage[2])
+        else:
+            flat = torch.cat([a.flatten() for a in addresses])
+            pages = np.unique(flat.detach().cpu().numpy() // PAGE).tolist()
+            self.make_resident(pages)
+            self.query_coverage = (key, self.mapping_generation, pages) if key is not None else None
+        writes, reads = self._query_addresses(*addresses)
+        if self.query_writes is not None and batch.iteration_cols is None:
+            self.query_writes.append(
+                (batch.iteration_ids, batch.out_cache_loc, writes, self.mapping_generation)
+            )
+        import msgspec
+        translated = msgspec.structs.replace(rail, kv_indices=reads)
+        backend.forward_metadata = replace(meta, windows={IdSpaceKind.FULL: translated})
+        try:
+            yield replace(batch, out_cache_loc=writes)
+        finally:
+            backend.forward_metadata = meta

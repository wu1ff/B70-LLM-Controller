+def resident_prefix_buffers(pool, tensors):
+    """Resolve the existing physical NHD draft-cache pointers once per pool."""
+    if (getattr(pool, "use_hnd", True) or pool.dtype != torch.bfloat16
+            or pool.start_layer != 0 or len(tensors) != 10
+            or any(not t.is_contiguous() or t.shape[1:] != (2, 128)
+                   or t.dtype != torch.bfloat16 or not t.is_xpu for t in tensors)):
+        return None
+    k_ptrs, v_ptrs = pool.k_data_ptrs, pool.v_data_ptrs
+    if k_ptrs is None or v_ptrs is None:

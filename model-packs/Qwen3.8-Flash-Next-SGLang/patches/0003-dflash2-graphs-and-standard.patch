+                            min_larger_prob = min_larger_0
+                            num_min_larger = num_min_larger_0
+                            p_pivots_sum = p_pivots_sum_0
+                            found_pivot = 1
+
+                        # Update range
+                        if p_pivots_sum_0 > p:

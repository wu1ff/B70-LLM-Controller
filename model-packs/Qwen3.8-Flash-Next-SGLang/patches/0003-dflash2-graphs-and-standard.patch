+"""Fixed-chain convolution with one sliding window view for all eight positions."""
+import torch
+from torch.nn import functional as F
+
+
+def conv(x, state, weight, bias, activation, *, conv_state_indices,
+         intermediate_conv_window, intermediate_state_indices, **tree):
+    if any(t is not None for t in tree.values()):
+        raise ValueError("Packed B70 verifier requires a chain")
+    prior = state.index_select(0, conv_state_indices.long())
+    # [request, position, channel, tap]. Each window includes the new input.
+    sequence = torch.cat((prior, x), dim=-1)
+    windows = sequence.unfold(-1, weight.shape[-1], 1).transpose(1, 2).contiguous()
+    intermediate_conv_window.index_copy_(0, intermediate_state_indices.long(), windows[..., 1:].contiguous())
+    result = (windows.float() * weight.float()).sum(dim=-1)
+    if bias is not None:
+        result = result + bias.float()
+    if activation in ("silu", "swish"):
+        result = F.silu(result)
+    return result.to(x.dtype).transpose(1, 2).contiguous()

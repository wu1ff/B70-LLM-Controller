+        tl.store(dest, active_pivot.to(tl.int32, bitcast=True))
+        tl.store(dest + 1, duplicate_logit.to(tl.int32, bitcast=True))
+        tl.store(dest + 2, num_keep.to(tl.int32, bitcast=True))
+        tl.store(dest + 3, num_duplicate_logit.to(tl.int32, bitcast=True))
+
+
+
+
+def apply_filter(logits, k, p):
+    """Use the same temporary candidate rows and tables as the installed donor."""
+    rows, vocab = logits.shape
+    assert logits.is_xpu and logits.dtype == torch.float32 and 1 <= rows <= 32
+    assert logits.stride(1) == 1 and k.dtype == torch.int32 and p.dtype == torch.float32
+    tables = donor._TRITON_TABLE_CACHE.get(logits.device)
+    if tables is None:
+        with gpu_sync_allowed():
+            tables = (logits.new_tensor(donor._NORMAL_CDF_TO_SIGMA_TABLE),
+                      logits.new_tensor(donor._PERCENTILE_TO_STD_TABLE))
+            donor._TRITON_TABLE_CACHE[logits.device] = tables
+    normal, percentile = tables
+    key = (logits.device, logits.dtype, vocab)
+    buffer = donor._TRITON_BUFFER_CACHE.get(key)
+    if buffer is None or buffer.shape[0] < rows:
+        buffer = logits.new_empty((triton.next_power_of_2(rows), vocab))
+        donor._TRITON_BUFFER_CACHE[key] = buffer
+
+    block = 4096
+    tiles = triton.cdiv(vocab, block)
+    pivot = logits.new_empty(rows)
+    stats = torch.empty((rows, tiles, 4), device=logits.device, dtype=torch.int32)
+    row_stats = stats.new_empty((rows, 4))
+    positions = stats.new_empty((rows, tiles))
+    _pivot[(rows,)](logits, logits.stride(0), k, percentile, pivot, vocab, block, num_warps=4)
+    _tiles[(rows, tiles)](logits, pivot, stats, logits.stride(0), vocab, block, num_warps=4)
+    _offsets[(rows,)](stats, row_stats, positions, tiles, triton.next_power_of_2(tiles), num_warps=4)
+    _compact[(rows, tiles)](logits, pivot, positions, buffer, logits.stride(0), vocab,
+                            block, num_warps=4)
+    mask_stats = row_stats.new_empty((rows, 4))
+    _prepared_filter_kernel[(rows,)](
+        logits, logits.stride(0), pivot, row_stats, mask_stats, buffer, percentile, normal, k, p, rows,
+        vocab, -float("inf"), block, 2048, True, True, False, num_warps=4,
+    )
+    _count_duplicates[(rows, tiles)](
+        logits, logits.stride(0), mask_stats, positions, vocab, block, num_warps=4,
+    )
+    _apply_mask[(rows, tiles)](
+        logits, logits.stride(0), mask_stats, positions, vocab, block, triton.next_power_of_2(tiles),
+        num_warps=4,
+    )
+    return logits

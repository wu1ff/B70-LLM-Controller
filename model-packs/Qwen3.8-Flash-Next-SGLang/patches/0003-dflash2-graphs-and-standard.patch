+def pack_k7_outputs(candidates, accepted, bonus):
+    tokens = torch.empty_like(candidates, dtype=torch.int64)
+    lengths = torch.empty_like(accepted, dtype=torch.int32)
+    _pack_k7_outputs[(candidates.shape[0],)](candidates, accepted, bonus, tokens, lengths)

+def stage_k7(destinations, sources, metadata, pages, columns, *, page_size=0):
+    rows = sources[0].numel()
+    if (rows not in (8, 16, 24, 32) or columns <= 0
+            or any(a.shape != b.shape or a.dtype != b.dtype or a.device != b.device
+                   for a, b in zip(destinations, sources, strict=True))
+            or any(not t.is_contiguous() for t in destinations)
+            or any(not t.is_contiguous() for i, t in enumerate(sources) if i != 2)
+            or sources[2].shape != (3, rows) or sources[2].stride(1) != 1
+            or pages.stride(1) != 1 or not metadata.page_table.is_contiguous()
+            or not metadata.cache_seqlens_int32.is_contiguous()
+            or not metadata.cu_seqlens_k.is_contiguous()):

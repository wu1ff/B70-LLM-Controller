@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Fixed K7 input copy plan, adapted from v6 b70_compiled_graph_update."""
+from operator import attrgetter
+
+import torch
+import triton
+import triton.language as tl
+
+
+FIELDS = ("input_ids", "positions", "mrope_positions", "out_cache_loc", "req_pool_indices", "seq_lens")
+INPUTS = attrgetter(*FIELDS)
+
+
+@triton.jit
+def _copy_bytes(table, BLOCK: tl.constexpr):
+    pair = tl.program_id(0)
+    dest = tl.load(table + 3 * pair).to(tl.pointer_type(tl.uint8))
+    src = tl.load(table + 3 * pair + 1).to(tl.pointer_type(tl.uint8))
+    size = tl.load(table + 3 * pair + 2)
+    columns = tl.arange(0, BLOCK)
+    for start in range(0, size, BLOCK):
+        offsets = start + columns
+        tl.store(dest + offsets, tl.load(src + offsets, offsets < size), offsets < size)
+
+
+def _signed(address):
+    return address - (1 << 64) if address >= (1 << 63) else address
+
+
+class GraphInputs:
+    def __init__(self, destinations):
+        self.destinations = destinations
+        self.geometry = tuple((d.shape, d.dtype, d.device) for d in destinations)
+        self.bytes = tuple(d.nbytes for d in destinations)
+        self.addresses = tuple(_signed(d.data_ptr()) for d in destinations)
+        self.host = torch.empty(3 * len(destinations), dtype=torch.int64, pin_memory=True)
+        self.table = torch.empty_like(self.host, device=destinations[0].device, pin_memory=False)
+        self.upload = None
+        self.key = None
+        self.disabled = False
+        self.checked = False
+
+    def stage(self, sources):
+        if tuple((s.shape, s.dtype, s.device) for s in sources) != self.geometry:
+            raise ValueError("Packed target graph input geometry changed")
+        if self.disabled:
+            torch._foreach_copy_(self.destinations, sources)
+            return False
+        fused = tuple(i for i, (d, s) in enumerate(zip(self.destinations, sources, strict=True))
+                      if self.bytes[i] and d.is_contiguous() and s.is_contiguous())
+        other = tuple(i for i in range(len(sources)) if i not in fused)
+        if other:
+            torch._foreach_copy_([self.destinations[i] for i in other], [sources[i] for i in other])
+        if not fused:
+            return False
+        stream = torch.xpu.current_stream(self.table.device)
+        key = tuple((i, _signed(sources[i].data_ptr())) for i in fused)
+        if key != self.key:
+            if self.upload is not None:
+                self.upload.synchronize()
+            values = [v for i, addr in key for v in (self.addresses[i], addr, self.bytes[i])]
+            count = len(values)
+            self.host[:count].copy_(torch.tensor(values, dtype=torch.int64))
+            self.table[:count].copy_(self.host[:count], non_blocking=True)
+            self.upload = stream.record_event()
+            self.key = key
+        for i in fused:
+            sources[i].record_stream(stream)
+        _copy_bytes[(len(fused),)](self.table, 256)
+        if not self.checked:
+            self.checked = all(torch.equal(d, s) for d, s in zip(self.destinations, sources, strict=True))
+            if not self.checked:
+                self.disabled = True
+                torch._foreach_copy_(self.destinations, sources)
+        return self.checked

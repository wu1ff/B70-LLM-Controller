+        self.compact_experts = compact_experts and (requests > 1 or self.compact_c1)
+        self.planned_experts = self.compact_experts and str(requests) in (
+            os.getenv("SGLANG_FLASHNEXT_PLANNED_EXPERT_WIDTHS", "").split(",")
+        )
+        self.pair_batch = (self.planned_experts and requests in (2, 3, 4)
+                           and str(requests) in os.getenv("SGLANG_FLASHNEXT_PARALLEL_BATCH_WIDTHS", "").split(","))
+        self.pair_batch_checks = None
+        if self.pair_batch:
+            torch.ops.load_library("/opt/flashnext/a0039/liba0039_parallel_batch.so")
+            self.pair_batch_checks = []
+        self.hc_partial = None
+        self.attention_quarters = None
+        self.hc_quarters = None
+        self.moe_partials = None
+        self.moe_shared = None
+        self.moe_quarters = None
+        if self.compact_c1 and os.getenv("SGLANG_FLASHNEXT_PARALLEL_C1") == "1":
+            torch.ops.load_library("/opt/flashnext/a0039/liba0039_parallel_c1.so")
+            self.dispatch_experts = self.dispatch_parallel_c1
+
+    def dispatch_parallel_c1(self, *args):
+        if self.moe_shared is None:
+            return packed_experts(1)(*args)
+        torch.ops.a0039_parallel_c1.forward(*args, self.moe_shared)
+        self.moe_quarters = args[-1]
+
+    def dispatch_experts(self, *args):
+        if self.compact_c1:
+            if self.moe_shared is None:
+                return packed_experts(1)(*args)
+            op = torch.ops.a0039_c1_experts if self.planned_experts else torch.ops.a0037_c1_experts
+            op.forward(*args, self.moe_shared)
+        elif self.pair_batch:
+            torch.ops.a0039_parallel_batch.forward(*args, self.moe_shared)
+            if self.pair_batch_checks is not None:
+                # The ordinary pre-capture warm pass supplies the real cyclic
+                # pack, actual BF16 activations and actual per-row top ten.
+                output = args[-1]
+                control = torch.empty_like(output)
+                torch.ops.a0039_batch_experts.forward(*args[:-1], control, self.moe_shared)
+                self.pair_batch_checks.append((output.view(torch.int16) == control.view(torch.int16)).all())
+        else:
+            op = torch.ops.a0039_batch_experts if self.planned_experts else torch.ops.astra_a0035
+            op.forward(*args, self.moe_shared)
+        if self.moe_shared is not None:
+            self.moe_quarters = args[-1]
+
+    def finish_pair_batch(self):
+        # This operator contains no communication. A rank can fall back
+        # locally without changing the subsequent native TP collective.
+        checks, self.pair_batch_checks = self.pair_batch_checks, None
+        self.pair_batch = len(checks) == 48 and bool(torch.stack(checks).all().item())
+        log.info("Flash Next paired batch experts warm admission rank=%d width=%d "
+                 "layers=%d BF16 words=%d exact=%s", get_parallel().tp_group.rank_in_group,
+                 self.requests, len(checks), len(checks) * self.requests * WIDTH * 2560,
+                 self.pair_batch)
+
+    def gather_experts_and_shared(self, experts, hidden, topk, shared):
+        with bind(self, "moe_shared", shared):
+            output = experts(hidden, topk)
+        if output is not self.moe_quarters:
+            raise RuntimeError("packed MoE unexpectedly changed the native quarter buffer")
+        return output
+
+    def defer_shared_add(self, routed, shared):
+        self.moe_partials = (routed, shared)
+        return routed
+
+    def project_quarters(self, module, original, x, *args, **kwargs):
+        if (args or kwargs or x.shape != (self.requests * WIDTH, 1536)
+                or x.dtype != torch.bfloat16 or not x.is_xpu or not x.is_contiguous()):
+            return original(x, *args, **kwargs)
+        # OneDNN emits the four 640-column output panels directly in the
+        # rank-quarter order required by the following TP sum.
+        if not getattr(self, "_reported_quarter_projection", False):
+            log.info("Flash Next direct attention quarter projection rows=%d", len(x))
+            self._reported_quarter_projection = True
+        weight = module.weight.view(4, 640, 1536).transpose(1, 2)
+        packed = torch.bmm(x.expand(4, -1, -1), weight).view(len(x), 2560)
+        self.attention_quarters = packed
+        return packed, None
+
+    def produce_hc_input(self, op, *args, **kwargs):
+        if self.hc_partial is not None:
+            raise RuntimeError("packed HC producer replaced an unconsumed partial")
+        partial_output = op(*args, **kwargs)
+        self.hc_partial = partial_output
+        return partial_output
+
+    def consume_hc_input(self, op, block, *args):
+        if self.moe_partials is not None or self.moe_quarters is not None:
+            raise RuntimeError("packed MoE consumer did not reduce the shared and routed outputs")
+        if self.gathered_hc is not None:
+            from sglang.srt.speculative.gather_hc import consume
+
+            if block is not self.hc_partial:
+                raise RuntimeError("C1 gathered HC lost its producer")
+            packed, self.gathered_hc = self.gathered_hc, None
+            self.hc_partial = self.hc_quarters = None
+            result = consume(packed, *args)
+            if self.gather_control is not None:
+                reference, self.gather_control = self.gather_control, None
+                expected = op(reference, *args, quarter_rows=8)
+                actual_items = result if isinstance(result, tuple) else (result,)
+                ref_items = expected if isinstance(expected, tuple) else (expected,)
+                checks = []
+                for actual, old in zip(actual_items, ref_items, strict=True):
+                    if old is None and actual is None:
+                        continue
+                    if (old is None or actual is None or actual.dtype != old.dtype
+                            or actual.shape != old.shape):
+                        checks.append(torch.zeros((), device=block.device, dtype=torch.bool))
+                    else:
+                        self.gather_check_words += actual.numel()
+                        checks.append((old.view(torch.int16) == actual.view(torch.int16)).all())
+                self.gather_checks.append(torch.stack(checks).all())
+            return result
+        quarter_rows = 0
+        if self.hc_quarters is not None:
+            if block is not self.hc_quarters:
+                raise RuntimeError("packed HC consumer did not receive its collective output")
+            quarter_rows = block.shape[0]
+        self.hc_partial = self.hc_quarters = None
+        return op(block, *args, quarter_rows=quarter_rows)
+
+    def finish_gather_admission(self):
+        import torch.distributed as dist
+
+        good = (self.gathered_count == len(self.gather_checks) == 96
+                and self.gather_control is None and self.gathered_hc is None
+                and bool(torch.stack(self.gather_checks).all().item()))
+        vote = torch.tensor(int(good), dtype=torch.int32, device="cpu")
+        dist.all_reduce(vote, op=dist.ReduceOp.MIN, group=get_parallel().tp_group.cpu_group)
+        self.gather_c1 = bool(vote.item())
+        self.gather_testing = False
+        log.info("Flash Next C1 gathered HC warm admission admitted=%s "
+                 "boundaries=%d BF16 words=%d", self.gather_c1,
+                 len(self.gather_checks), self.gather_check_words)
+        self.gather_checks.clear()
+
+    def positions(self, x):
+        view = x.reshape(self.requests, WIDTH, -1, *x.shape[1:])
+        return [row.reshape(-1, *x.shape[1:]).contiguous() for row in view.unbind(1)]
+
+    def pack(self, values):
+        return torch.stack([t.reshape(self.requests, -1, *t.shape[1:]) for t in values], dim=1).flatten(0, 2)
+
+    def apply(self, op, inputs, weights=()):
+        columns = [self.positions(x) for x in inputs]
+        return self.pack([op(*args, *weights) for args in zip(*columns, strict=True)])
+
+    def hc_norm(self, module, x):
+        data = x.float()
+        groups = data if module.group_size is None else data.unflatten(-1, (-1, module.group_size))
+        # Keep the leading dimensions used by each serial request's reduction.
+        means = self.apply(lambda t: t.mean(-1, keepdim=True), (groups.square(),))
+        normalized = groups * (means + module.variance_epsilon).rsqrt()
+        return (normalized.reshape_as(data) * (1.0 + module.weight.float())).to(x.dtype)
+
+    def mix(self, normalized, down, up, count, hidden):
+        # The one-row down projection uses a different reduction. Keep its
+        # GEMV shape. Multi-request decode already uses the batched GEMM.
+        low = (self.apply(F.linear, (normalized,), (down,)) if self.requests == 1
+               else F.linear(normalized, down))
+        return read_hc(F.linear(activate_hc(low), up), normalized)
+
+    def reduce(self, group, x, original):
+        if x.device.type != 'xpu' or x.dtype != torch.bfloat16 or x.ndim < 2 or x.size(0) != self.requests * WIDTH:
+            return original(group, x)
+        if V6_TARGET and x.ndim == 2 and x.shape[1] == 2560:
+            # v6 assigns each row's four BF16 quarters to the same ring
+            # partitions at every width. Reassemble in request row order.
+            rows = x.reshape(x.shape[0], 4, 640)
+            if x is self.attention_quarters:
+                if x is not self.hc_partial or group.world_size != 4:
+                    raise RuntimeError("Quarter projection escaped its packed TP4 boundary")
+                packed = x.view(4, x.shape[0], 640)
+                self.attention_quarters = None
+            elif x is self.moe_quarters:
+                packed = x.view(4, x.shape[0], 640)
+                self.moe_quarters = None
+            elif self.moe_partials is not None and x is self.moe_partials[0]:
+                from sglang.srt.speculative.v6_target import expert_sum_quarters
+
+                packed = expert_sum_quarters(*self.moe_partials)
+                self.moe_partials = None
+            else:
+                packed = rows.transpose(0, 1).contiguous()
+            if self.gather_c1 and x is self.hc_partial:
+                # Every rank contributes exactly four canonical quarters. The
+                # HC boundary immediately consumes this gathered allocation.
+                if self.gathered_hc is not None or packed.shape != (4, 8, 640):
+                    raise RuntimeError("C1 gathered HC has invalid collective ownership")
+                if self.gather_testing:
+                    # The reference sum consumes the same inputs but writes its
+                    # own storage using the normal captured-model all-reduce.
+                    self.gather_control = original(group, packed.clone()).view_as(x)
+                gathered = packed.new_empty((4, 4, 8, 640))
+                group.all_gather_into_tensor(gathered.view(-1), packed.view(-1))
+                self.gathered_hc = gathered
+                self.gathered_count += 1
+                return x
+            reduced = original(group, packed)
+            if x is self.hc_partial and group.world_size == 4:
+                # The gated injection owns this private reduction result. Keep
+                # each collective quarter contiguous until that kernel loads it.
+                self.hc_quarters = reduced.view_as(x)
+                return self.hc_quarters
+            rows.copy_(reduced.transpose(0, 1))
+            return x
+        # Preserve each decode batch's four rank-owned contiguous quarters.
+        flat = x.reshape(self.requests, WIDTH, -1).transpose(0, 1).contiguous()
+        quarters = flat.reshape(WIDTH, 4, -1).transpose(0, 1).contiguous()
+        reduced = original(group, quarters)
+        result = reduced.transpose(0, 1).reshape(WIDTH, self.requests, -1).transpose(0, 1)
+        return x.copy_(result.reshape_as(x))
+
+    def gdn(self, q,k,v,a,b,A_log,dt_bias,states,slots,offsets,seed,**options):
+        from sglang.srt.layers.attention.linear.kernels.gdn_xpu import _ordered_prefill_enabled
+        if not _ordered_prefill_enabled():
+            raise RuntimeError("Packed recurrence requires the ordered verification library")
+        # Torch's XPU reduction chooses its tree using the leading dimensions.
+        # Preserve the time-column reduction tree; batch the pointwise work.
+        query, key = q[0].float(), k[0].float()
+        def head_sum(x):
+            return x.sum(-1, keepdim=True)
+        qq = self.apply(head_sum, (query.square(),))
+        kk = self.apply(head_sum, (key.square(),))
+        query = query * (qq + 1e-6).rsqrt()
+        key = key * (kk + 1e-6).rsqrt()
+        queries = (query * (query.shape[-1] ** -0.5)).repeat_interleave(3, dim=1)
+        keys = key.repeat_interleave(3, dim=1)
+        gates = (-A_log.float().exp() * F.softplus(a.float() + dt_bias.float())).exp()
+        betas = b.float().sigmoid()
+        out = torch.empty_like(v[0], dtype=torch.float32, memory_format=torch.contiguous_format)
+        owners = slots[:self.requests].int().contiguous()
+        torch.ops.flashnext_ordered.verify(
+            queries.contiguous(),keys.contiguous(),v[0].float().contiguous(),gates.contiguous(),betas.contiguous(),
+            states,owners,offsets[:self.requests+1].int().contiguous(),torch.ones_like(owners,dtype=torch.bool),
+            options['verify_states'],options['verify_slots'][:self.requests].int().contiguous(),out)
+        return out.to(v.dtype).unsqueeze(0)
+
+    @contextmanager
+    def operators(self, model, dense, linear, columns, metadata, native_gdn):
+        from sglang.srt.distributed.parallel_state import GroupCoordinator
+        from sglang.srt.layers.attention.linear.kernels import gdn_xpu
+        original_reduce = GroupCoordinator.all_reduce
+        self.gathered_hc = None
+        self.gathered_count = 0
+        self.gather_c1 = False
+        if self.requests == 1:
+            group = get_parallel().tp_group
+            # All capture participants vote once on the CPU group before any
+            # graph/collective is recorded. Eager admission has fuse_tp_hc=False
+            # and independently retains the native in-place all-reduce.
+            local = (self.fuse_tp_hc and os.getenv("SGLANG_FLASHNEXT_GATHER_HC_C1") == "1"
+                     and group.world_size == 4 and self.compact_c1 and V6_TARGET
+                     and native_gdn is not None and len(model.layers) == 48
+                     and all(hasattr(layer.attn_hyper_connection, "_v6_down")
+                             and hasattr(layer.mlp_hyper_connection, "_v6_down")
+                             and not layer.mlp.reduce_results and not layer.mlp.experts.reduce_results
+                             for layer in model.layers))
+            import torch.distributed as dist
+
+            vote = torch.tensor(int(local), dtype=torch.int32, device="cpu")
+            dist.all_reduce(vote, op=dist.ReduceOp.MIN, group=group.cpu_group)
+            self.gather_c1 = bool(vote.item())
+        self.gather_testing = self.gather_c1
+        self.gather_control = None
+        self.gather_checks = []
+        self.gather_check_words = 0
+
+        def attention(q,k,v,layer,forward_batch,save_kv_cache=True,**opts):
+            previous = dense.forward_metadata
+            try:
+                dense.forward_metadata = metadata
+                # The Xe2 auto plan uses request count to pick its reduction
+                # partitions. Preserve the original C1..C4 partition counts
+                # even though the kernel now sees 8, 16, 24 or 32 query rows.
+                splits = dense.num_splits
+                if splits == 0:
+                    pages = dense.forward_metadata.page_table.shape[1]
+                    splits = 1 if pages <= 32 else (32, 16, 21, 8)[self.requests - 1]
+                with bind(dense, "num_splits", splits):
+                    return dense.forward_decode(q, k, v, layer, replace(forward_batch, spec_info=None), save_kv_cache, **opts)
+            finally:
+                dense.forward_metadata = previous
+
+        def choose(fn, hidden, router_logits, *args, **kw):
+            results = [fn(x,y,*args,**kw) for x,y in zip(self.positions(hidden),self.positions(router_logits),strict=True)]
+            return type(results[0])(*(self.pack(items) for items in zip(*results,strict=True)))
+
+        def decode_ple(ple, fn, hidden, fb, layout):
+            from sglang.srt.models.qwen4_exp import _prepare_ple_batch, SHORT_CONV_PART, get_token_to_kv_pool
+            part=get_token_to_kv_pool().layer_router.read(ple.layer_id,SHORT_CONV_PART)
+            live=part.view.layer_cache(part.view_layer_id)
+            saved=part.view.layer_intermediate_cache(part.view_layer_id)
+            slots=layout.state_indices.long()
+            seed=live.index_select(0,slots)
+            ids=self.positions(fb.input_ids[:,None])
+            embeddings=self.positions(fb.flashnext_ple_rows[ple.layer_id])
+            output=[]
+            try:
+                for j,(step,x,tokens,rows) in enumerate(zip(columns,self.positions(hidden),ids,embeddings,strict=True)):
+                    step=replace(step,input_ids=tokens.flatten(),mm_inputs=None,flashnext_ple_rows={ple.layer_id:rows})
+                    state=_prepare_ple_batch(input_ids=step.input_ids,forward_batch=step,
+                        ngram_size=model.ple_ngram_size,ngram_eos_token_id=model.ple_ngram_eos_token_id)
+                    output.append(fn(x,step,state))
+                    saved[:self.requests,j].copy_(live.index_select(0,slots))
+            finally:
+                live.index_copy_(0,slots,seed)
+            return self.pack(output)
+
+        if V6_TARGET:
+            from sglang.srt.speculative import v6_target
+
+            v6_target.load_native()
+        if self.planned_experts:
+            torch.ops.load_library("/opt/flashnext/a0039/liba0039_experts.so")
+        elif self.compact_c1:
+            torch.ops.load_library("/opt/flashnext/a0037/liba0037_c1_experts.so")
+        elif self.compact_experts:
+            load_compact_experts()
+
+        with ExitStack() as stack:
+            def set_op(instance, name, method):
+                stack.enter_context(bind(instance, name, method))
+            if self.pair_batch:
+                set_op(model, "_flashnext_admit_pair_batch", self.finish_pair_batch)
+            if self.gather_c1:
+                set_op(model, "_flashnext_admit_gather_hc", self.finish_gather_admission)
+            set_op(GroupCoordinator,'all_reduce',lambda group,x:self.reduce(group,x,original_reduce))
+            set_op(gdn_xpu,'_flash_next_eager_gdn',self.gdn)
+            set_op(dense,'forward_extend',attention)
+            if V6_TARGET:
+                set_op(model, "_flashnext_packed_cyclic_ep", True)
+            units = [model.hyper_connection_mixer]
+            for layer in model.layers:
+                if (self.fuse_tp_hc and os.getenv("SGLANG_FLASHNEXT_QUARTER_PROJECTION") == "1"
+                        and (native_gdn is not None or not hasattr(layer, "linear_attn"))):
+                    from sglang.srt.layers.linear import RowParallelLinear
+                    from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod
+                    from sglang.srt.runtime_context import get_forward
+
+                    proj = layer.linear_attn.out_proj if hasattr(layer, "linear_attn") else layer.o_proj
+                    if (type(proj) is RowParallelLinear and isinstance(proj.quant_method, UnquantizedLinearMethod)
+                            and proj.input_is_parallel and not proj.reduce_results and not proj.use_decode_attn_tp
+                            and not get_forward().sp_active and proj.bias is None
+                            and proj.weight.shape == (2560,1536) and proj.weight.is_contiguous()
+                            and proj.weight.dtype == torch.bfloat16 and proj.weight.is_xpu):
+                        set_op(proj, "forward", partial(self.project_quarters, proj, proj.forward))
+                if layer.ple is not None and not V6_PLE:
+                    ple=layer.ple
+                    set_op(ple,'forward',lambda x,fb,layout,p=ple,fn=ple.forward:decode_ple(p,fn,x,fb,layout))
+                if hasattr(layer, 'linear_attn'):
+                    norm = layer.linear_attn.norm
+                    if native_gdn is not None:
+                        module = layer.linear_attn
+                        project = partial(native_gdn.projected_forward, module, linear)
+                        if self.fuse_tp_hc:
+                            project = partial(self.produce_hc_input, project)
+                        set_op(module, "forward", project)
+                    else:
+                        set_op(norm,'forward',lambda x,z,fn=norm.forward:self.apply(fn,(x,z)))
+                    if V6_TARGET:
+                        ba = layer.linear_attn.in_proj_ba
+                        set_op(ba, "forward", partial(v6_target.ba_projection, ba, ba.forward))
+                elif self.fuse_tp_hc:
+                    set_op(layer, "self_attention",
+                           partial(self.produce_hc_input, layer.self_attention))
+                units.extend((layer.attn_hyper_connection,layer.mlp_hyper_connection))
+                dispatch_experts = (
+                    self.dispatch_experts if self.compact_experts else packed_experts(self.requests)
+                )
+                set_op(layer.mlp.experts.intel_cyclic_w4, "_flashnext_verify_experts", dispatch_experts)
+                top = layer.mlp.topk
+                if V6_TARGET:
+                    mlp = layer.mlp
+                    dispatch = partial(v6_target.packed_moe, mlp, fallback=mlp.forward)
+                    if self.fuse_tp_hc:
+                        if self.compact_experts:
+                            dispatch = partial(dispatch, native_shared_experts=self.gather_experts_and_shared)
+                        dispatch = partial(
+                            self.produce_hc_input, dispatch, defer_shared_add=self.defer_shared_add,
+                        )
+                    set_op(mlp, "forward", dispatch)
+                set_op(top,'forward',lambda *args,fn=top.forward,**kw:choose(fn,*args,**kw))
+            for hc in units:
+                if V6_TARGET:
+                    set_op(hc, "mix", partial(v6_target.hc_mix, hc))
+                    if hasattr(hc, "_v6_down"):
+                        combine = v6_target.hc_combine
+                        combine_norm = v6_target.hc_combine_and_normalize
+                        if self.fuse_tp_hc:
+                            combine = partial(self.consume_hc_input, combine)
+                            combine_norm = partial(self.consume_hc_input, combine_norm)
+                        set_op(hc, "combine", combine)
+                        set_op(hc, "combine_and_normalize", combine_norm)
+                    continue
+                norm = hc.hc_norm
+                set_op(norm,'forward',lambda x,module=norm:self.hc_norm(module,x))
+                set_op(hc,'_mix_compute',self.mix)
+                if self.requests == 1 and hasattr(hc,'block_inject_weight'):
+                    set_op(hc,'_combine_compute',lambda x,r,n,*weights,fn=hc._combine_compute:self.apply(fn,(x,r,n),weights))
+            yield
+            if self.gather_c1:
+                # The eager warm forward and captured target each include all
+                # 48 attention and 48 FFN boundaries.
+                if self.gathered_hc is not None or self.gathered_count != 192:
+                    raise RuntimeError(f"Incomplete captured C1 gathered HC boundaries: {self.gathered_count}")
+                log.info("Flash Next C1 gathered HC warm+capture boundaries=%d", self.gathered_count)
+            if any(value is not None for value in (
+                self.hc_partial, self.hc_quarters, self.moe_partials, self.moe_quarters, self.attention_quarters,
+            )):
+                raise RuntimeError("packed HC execution left an unconsumed collective output")
+
+
+class PLEGraphs:
+    """Two sequential target captures sharing the packed graph's original pool."""
+
+    def __init__(self, pool):
+        self.pool = pool
+        self.prefix = torch.xpu.XPUGraph()
+        self.rest = torch.xpu.XPUGraph()
+        self.active = self.prefix
+
+    def capture_begin(self, pool):
+        self.prefix.capture_begin(pool)
+
+    def capture_end(self):
+        self.active.capture_end()
+
+    @contextmanager
+    def capture(self, layer):
+        def at_consumer(module, args):
+            if self.active is not self.prefix:
+                raise RuntimeError("PLE graph boundary was entered twice")
+            self.prefix.capture_end()
+            self.active = self.rest
+            self.rest.capture_begin(self.pool)
+
+        with layer.register_forward_pre_hook(at_consumer), torch.xpu.graph(self, pool=self.pool):
+            yield
+        if self.active is not self.rest:
+            raise RuntimeError("Packed target did not visit the PLE consumer")
+
+    def replay(self):
+        self.prefix.replay()
+        self.rest.replay()
+
+
+@dataclass
+class Entry:
+    batch: object
+    dense: object
+    linear: object
+    columns: list
+    input_plan: GraphInputs
+    column_offsets: torch.Tensor
+    ple_host_ids: dict
+    gdn: object = None
+    graph: object = None
+    output: object = None
+    checks: int = 0
+    factor_output: bool = False
+
+
+class PackedTarget:
+    def __init__(self, runner):
+        self.runner = runner
+        self.entries = {}
+        self.output_buffers = None
+        self.pool = torch.xpu.graph_pool_handle()
+        self.backend = runner.attn_backend
+
+    def inputs(self, batch, lens):
+        n = batch.batch_size
+        return self.key(n, int(lens.max()))
+
+    def key(self, n, longest):
+        if longest+1 <= 4096 < longest+WIDTH:
+            return None
+        pages = 32 if longest+WIDTH <= 4096 else math.ceil(self.runner.req_to_token_pool.req_to_token.shape[1]/128)
+        return n,pages
+
+    def entry(self, batch, key):
+        n,pages=key
+        model = self.runner.model.model
+        ple = {}
+        for i, layer in enumerate(model.layers):
+            if layer.ple is not None:
+                embed = layer.ple.ple_embedding
+                ple[i]=embed.ngram_embedding.allocate_output((n*WIDTH,embed.ngram_heads,embed.ngram_embedding.embedding_dim),batch.input_ids.device)
+        fixed = replace(batch, **dict(zip(FIELDS, (x.clone() for x in INPUTS(batch)), strict=True)),
+                        flashnext_ple_rows=ple, mm_inputs=None, iteration_ids=None, iteration_cols=None,
+                        out_cache_loc_virtual=None, rids=None, mamba_track_indices=None)
+        # The graph owns its staging and metadata. Do not keep the scheduler's
+        # first per-request allocation plan or its transient draft buffers alive.
+        if batch.global_num_token_non_padded is not None:
+            fixed.global_num_token_non_padded = batch.global_num_token_non_padded.clone()
+        fixed.spec_info = replace(
+            batch.spec_info, draft_token=fixed.input_ids, positions=fixed.positions,
+            iteration_ids=None, iteration_cols=None, live_seq_lens_cpu=None,
+        )
+        linear=self.backend.linear_attn_backend.forward_metadata
+        linear=replace(linear,mamba_cache_indices=linear.mamba_cache_indices.clone(),query_start_loc=linear.query_start_loc.clone())
+        dense=self.backend.full_attn_backend.forward_metadata
+        table=dense.page_table.new_zeros((n,pages))
+        rows = n * WIDTH
+        query_lengths = table.new_zeros(rows)
+        columns = []
+        cache_locations = fixed.out_cache_loc.view(n, WIDTH)
+        for i in range(WIDTH):
+            # PLE consumes the column view. Dense attention uses the single
+            # batched query plan, with per-query lengths and shared page IDs.
+            step = replace(
+                fixed, forward_mode=ForwardMode.DECODE, spec_info=None,
+                global_num_token_non_padded_cpu=n, extend_seq_lens=None, extend_seq_lens_cpu=None,
+                seq_lens=query_lengths.view(n, WIDTH)[:, i], out_cache_loc=cache_locations[:, i],
+            )
+            columns.append(step)
+        batched = replace(
+            dense, page_table=table.new_zeros((rows, pages)), max_seq_len_q=1,
+            cache_seqlens_int32=query_lengths,
+            cu_seqlens_q=torch.arange(rows + 1, device=table.device, dtype=torch.int32),
+            cu_seqlens_k=table.new_zeros(rows + 1),
+        )
+        column_offsets = torch.arange(1, WIDTH + 1, device=table.device, dtype=torch.int32)
+        entry = Entry(fixed, batched, linear, columns,
+                      GraphInputs((*INPUTS(fixed), linear.mamba_cache_indices)), column_offsets, {})
+        if V6_GDN:
+            from sglang.srt.speculative.v6_gdn import SpeculativeGDN
+
+            entry.gdn = SpeculativeGDN(n, linear.query_start_loc, linear.mamba_cache_indices)
+        return entry
+
+    def start_ple(self, tokens, locations, req_indices, host_lengths, *, round_grant=None):
+        from sglang.srt.mem_cache.ple_state_pool import NGRAM_PART
+        from sglang.srt.speculative.flashnext_cycle import k7_ple_ids
+
+        entry = self.entries.get(self.key(len(host_lengths), max(host_lengths)))
+        if entry is None or entry.checks < 2 or not entry.ple_host_ids:
+            return None
+        router = self.runner.token_to_kv_pool.layer_router
+        router.wait_for_part(NGRAM_PART)
+        history = router.part_view(NGRAM_PART).context
+        if history is None:
+            return None
+        linear = self.backend.linear_attn_backend
+        slots = linear._translate_mamba_indices(self.runner.req_to_token_pool.get_mamba_indices(req_indices))
+        pending = []
+        for i, out in entry.batch.flashnext_ple_rows.items():
+            embedding = self.runner.model.model.layers[i].ple.ple_embedding
+            disk = embedding.ngram_embedding.intel_disk_ple
+            host = entry.ple_host_ids.get(i)
+            if disk is None or host is None:
+                return None
+            ids = k7_ple_ids(tokens, locations, None, slots, history, embedding)
+            if ids is None:
+                return None
+            host.copy_(ids, non_blocking=True)
+            pending.append((disk, ids, host, out))
+        ready = torch.xpu.current_stream(tokens.device).record_event()
+        if round_grant is not None and len(pending) == 1:
+            # The packed entry owns the ID rail. CPU gathering starts as
+            # soon as the committed history and draft proposal reach it.
+            disk, _, host, _ = pending[0]
+            return entry, pending, ready, disk.schedule_host_rows(host, ready)
+        return entry, pending, ready, None
+
+    def stage(self, entry, batch, lens, ple_transfer=None, *, direct_pages=False,
+              rank_vote=None, deferred_upload=None):
+        from sglang.srt.speculative.flashnext_cycle import stage_k7
+
+        fixed = entry.batch
+        stream = torch.xpu.current_stream(batch.input_ids.device)
+        gather = None
+        if ple_transfer is not None and ple_transfer[0] is entry and batch.extend_seq_lens is None:
+            _, pending, ready, gather = ple_transfer
+        else:
+            if ple_transfer is not None and ple_transfer[3] is not None:
+                ple_transfer[3].result()
+            pending, ready = self.prepare_ple(entry, batch, stream)
+
+        linear = self.backend.linear_attn_backend.forward_metadata
+        sources = (*INPUTS(batch), linear.mamba_cache_indices)
+        if fixed.global_num_token_non_padded is not None:
+            if batch.global_num_token_non_padded is None:
+                fixed.global_num_token_non_padded.fill_(batch.batch_size * WIDTH)
+            else:
+                fixed.global_num_token_non_padded.copy_(batch.global_num_token_non_padded)
+        # No query can reach beyond the last live causal position.
+        columns = (int(lens.max()) + WIDTH + 127) // 128
+        meta = entry.dense
+        full = self.backend.full_attn_backend
+        dense = full.forward_metadata if not direct_pages or entry.checks < 2 else None
+        page_table = full.req_to_token_pool.req_to_token if direct_pages else dense.page_table
+        page_size = 128 if direct_pages else 0
+        if (columns > meta.page_table.shape[1]
+                or (columns - 1) * (page_size or 1) >= page_table.shape[1]):
+            raise RuntimeError(f"K7 page coverage {columns} exceeds source or destination")
+        destinations = entry.input_plan.destinations
+        copied = stage_k7(destinations, sources, meta, page_table, columns, page_size=page_size)
+        if not copied and dense is None:
+            # Recreate the ordinary backend plan if a new tensor geometry
+            # cannot enter the direct copy, then keep the existing fallback.
+            full.init_forward_metadata(batch)
+            dense = full.forward_metadata
+        # Check the staging against the original ops on distinct live batches
+        # before the warmed graph can take the fixed plan on its own.
+        if not copied or entry.checks < 2:
+            page_view = meta.page_table.view(batch.batch_size, WIDTH, -1)[:, :, :columns]
+            lengths = meta.cache_seqlens_int32.view(batch.batch_size, WIDTH)
+            cu = meta.cu_seqlens_k[1:]
+            if copied:
+                staged = [t.clone() for t in (*destinations, page_view, lengths, cu)]
+            entry.input_plan.stage(sources)
+            page_view.copy_(dense.page_table[:, None, :columns])
+            torch.add(batch.seq_lens[:, None], entry.column_offsets, out=lengths)
+            torch.cumsum(meta.cache_seqlens_int32, 0, out=cu)
+            if copied and not all(torch.equal(x, y) for x, y in zip(
+                staged, (*destinations, page_view, lengths, cu), strict=True,
+            )):
+                raise RuntimeError("K7 graph staging differs from the live tensor oracle")
+        if rank_vote is not None and not _agree(rank_vote, gather=gather):
+            # The fallback also uses the disk stage. Retake host ownership
+            # before it can gather into that storage.
+            if gather is not None:
+                gather.result()
+            return None
+        if gather is not None:
+            disk, _, _, out = pending[0]
+            if deferred_upload is None:
+                self.join_ple(entry, batch, pending, gather)
+            else:
+                deferred_upload.append(partial(self.join_ple, entry, batch, pending, gather))
+        elif ready is not None:
+            ready.synchronize()
+            for disk, _, host, out in pending:
+                disk.gather_host_ids(host, out)
+        # The H2D upload is ordered before replay by this stream. The disk
+        # stage's DMA event guards pinned storage before its next CPU write.
+        return copied
+
+    def join_ple(self, entry, batch, pending, gather):
+        if gather is not None:
+            disk, _, _, out = pending[0]
+            disk.upload(gather.result(), out)
+
+    def prepare_ple(self, entry, batch, stream):
+        from sglang.srt.models.qwen4_exp import _prepare_ple_batch
+        from sglang.srt.mem_cache.ple_state_pool import NGRAM_PART
+        from sglang.srt.speculative.flashnext_cycle import k7_ple_ids
+
+        model = self.runner.model.model
+        fixed = entry.batch
+        pending = []
+        with forward_context(ForwardContext(attn_backend=self.backend), forward_batch=batch):
+            layout = None
+            router = self.runner.token_to_kv_pool.layer_router
+            router.wait_for_part(NGRAM_PART)
+            history = router.part_view(NGRAM_PART).context
+            slots = self.backend.forward_state_slots(batch.batch_size, None).working
+            try:
+                for i, out in fixed.flashnext_ple_rows.items():
+                    embed = model.layers[i].ple.ple_embedding
+                    ids = (
+                        k7_ple_ids(batch.input_ids, batch.out_cache_loc, batch.extend_seq_lens, slots, history, embed)
+                        if history is not None else None
+                    )
+                    if ids is None or entry.checks < 2:
+                        if layout is None:
+                            layout = _prepare_ple_batch(
+                                input_ids=batch.input_ids, forward_batch=batch,
+                                ngram_size=model.ple_ngram_size,
+                                ngram_eos_token_id=model.ple_ngram_eos_token_id,
+                            )
+                        expected = embed.compute_ngram_ids(layout)
+                        if ids is not None and not torch.equal(ids, expected):
+                            raise RuntimeError("K7 disk PLE hash differs from the live history oracle")
+                        ids = expected
+                    disk = embed.ngram_embedding.intel_disk_ple
+                    if disk is None:
+                        embed.ngram_embedding.gather(ids, out=out)
+                        continue
+                    host = entry.ple_host_ids.get(i)
+                    if host is None:
+                        host = entry.ple_host_ids[i] = torch.empty(
+                            ids.shape, dtype=torch.int64, device="cpu", pin_memory=True,
+                        )
+                    host.copy_(ids, non_blocking=True)
+                    pending.append((disk, ids, host, out))
+            finally:
+                self.runner.req_to_token_pool.ple_window_cache = None
+        return pending, stream.record_event() if pending else None
+
+    @contextmanager
+    def execution(self, entry, *, fuse_tp_hc=False, compact_experts=False):
+        fb = entry.batch
+        dense = self.backend.full_attn_backend
+        linear = self.backend.linear_attn_backend
+        rows = ChainRows(fb.batch_size, fuse_tp_hc=fuse_tp_hc, compact_experts=compact_experts)
+        with bind(dense, "forward_metadata", entry.dense), bind(linear, "forward_metadata", entry.linear), \
+             forward_context(ForwardContext(attn_backend=self.backend), forward_batch=fb), \
+             rows.operators(self.runner.model.model, dense, linear, entry.columns, entry.dense, entry.gdn):
+            yield fb
+
+    def _with_direct_seed(capture):
+        from functools import wraps
+
+        @wraps(capture)
+        def run(self, entry):
+            from sglang.srt.speculative.v6_gdn import direct_seed_enabled
+
+            if entry.gdn is not None and direct_seed_enabled():
+                # Compare direct seeds with the legacy eager seed path.
+                entry.factor_output = os.getenv("SGLANG_FLASHNEXT_GDN_FACTORS") == "1"
+                if entry.factor_output:
+                    torch.ops.load_library("/opt/flashnext/a0037/libflashnext_gdn_factors.so")
+                with (bind(entry.gdn, "direct_seed", True),
+                      bind(entry.gdn, "factor_output", entry.factor_output)):
+                    return capture(self, entry)
+            return capture(self, entry)
+        return run
+
+    @_with_direct_seed
+    @torch.inference_mode()
+    def capture(self, entry):
+        with self.execution(entry, fuse_tp_hc=FUSED_TP_HC, compact_experts=COMPACT_EXPERTS) as fb:
+            # Warm the shape-specific oneDNN, Inductor and native paths before capture.
+            from sglang.srt.speculative.head_admission import HeadAdmission
+            admission = HeadAdmission(self.runner.model.logits_processor, fb.batch_size * WIDTH, bind)
+            with admission.warm():
+                warm = self.runner.model.forward(fb.input_ids, fb.positions, fb)
+            admit_pair = getattr(self.runner.model.model, "_flashnext_admit_pair_batch", None)
+            if admit_pair is not None:
+                admit_pair()
+            admit_hc = getattr(self.runner.model.model, "_flashnext_admit_gather_hc", None)
+            if admit_hc is not None:
+                admit_hc()
+            # All eight keys execute serially on one worker stream. Bind one
+            # output pair sized for four K7 chains, shared by short and split
+            # graphs. The caller receives its own logits and trained features.
+            if self.output_buffers is None:
+                self.output_buffers = tuple(
+                    value.new_empty((4 * WIDTH, *value.shape[1:]))
+                    for value in (warm.next_token_logits, warm.hidden_states)
+                )
+            count = fb.batch_size * WIDTH
+            logits, features = (value[:count] for value in self.output_buffers)
+            entry.output = LogitsProcessorOutput(next_token_logits=logits, hidden_states=features)
+            del warm
+            torch.xpu.synchronize()
+            ple_layers = list(fb.flashnext_ple_rows)
+            if (os.getenv("SGLANG_FLASHNEXT_SPLIT_PLE") == "1" and V6_PLE
+                    and len(ple_layers) == 1 and ple_layers[0] > 0):
+                entry.graph = PLEGraphs(self.pool)
+                capture = entry.graph.capture(self.runner.model.model.layers[ple_layers[0]])
+            else:
+                entry.graph = torch.xpu.XPUGraph()
+                capture = torch.xpu.graph(entry.graph, pool=self.pool)
+            from sglang.srt.speculative.greedy_head import PackedHead
+            processor = self.runner.model.logits_processor
+            entry.head = PackedHead(processor, logits, fb.input_ids)
+            with (
+                admission.capture(entry.head),
+                bind(fb, "next_token_logits_buffer", logits),
+                bind(self.runner.model.logits_processor, "_flashnext_packed_logits", True),
+                bind(self.runner.model.model, "_flashnext_feature_output", features),
+                capture,
+            ):
+                model_out = self.runner.model.forward(fb.input_ids, fb.positions, fb)
+                if model_out.next_token_logits is not logits:
+                    logits.copy_(model_out.next_token_logits)
+                if model_out.hidden_states is not features:
+                    features.copy_(model_out.hidden_states)
+            entry.head.capture(self.pool)
+
+    def _can_stage_pages(self, batch):
+        from sglang.srt.layers.attention.xpu_backend import XPUAttentionBackend
+
+        dense = self.backend.full_attn_backend
+        return (os.getenv("SGLANG_FLASHNEXT_DIRECT_VERIFY_PAGES") == "1"
+                and type(dense) is XPUAttentionBackend and dense.topk <= 1
+                and dense.page_size == 128 and dense.dcp_size == 1
+                and not dense.has_swa and not dense.use_sliding_window_kv_pool
+                and not dense.use_mla and not dense.is_encoder_decoder
+                and dense.attention_chunk_size is None and batch.encoder_lens is None)
+
+    def run(self, worker,batch,lens,serial,borrow_output=False,metadata_ready=False,ple_transfer=None,
+            rank_vote=None):
+        key=self.inputs(batch,lens)
+        if key is None or (key in self.entries and self.entries[key] is None):
+            return None
+        entry=self.entries.get(key)
+        direct_pages = self._can_stage_pages(batch)
+        if not metadata_ready:
+            if direct_pages and entry is not None and entry.checks >= 2:
+                self.backend.linear_attn_backend.init_forward_metadata(batch)
+            else:
+                self.backend.init_forward_metadata(batch)
+        if entry is None:
+            # Discard free eager/sampler segments before admitting a new
+            # capture. Live graph pools and tensor storage remain allocated.
+            torch.xpu.empty_cache()
+            from sglang.srt.speculative.budget import can_admit
+            if not can_admit(batch.input_ids.device, ("packed", key)):
+                self.entries[key] = None
+                return None
+            entry=self.entries[key]=self.entry(batch,key)
+        check=entry.checks<2
+        if check:
+            table=self.runner.req_to_token_pool
+            m=table.mamba_pool.mamba_cache
+            n=batch.batch_size
+            slots=self.backend.forward_state_slots(n,None).working.long()
+            live=[m.temporal,m.conv[0],table.short_conv_pool.conv_state,table.ngram_pool.context.unsqueeze(0)]
+            bulk = os.getenv("SGLANG_FLASHNEXT_BULK_ADMISSION") == "1"
+            if bulk:
+                from sglang.srt.speculative.admission_copy import copy_layers
+            pinned = os.getenv("SGLANG_FLASHNEXT_PINNED_ADMISSION") == "1" and n >= 2
+            host_slots = slots.tolist() if not bulk or n > 1 else None
+            def host_working(part):
+                if pinned and part is m.temporal:
+                    from sglang.srt.speculative.admission_pinned import copy_working
+                    saved = copy_working(part, host_slots)
+                    if saved is not None:
+                        return saved
+                if bulk and n == 1:
+                    return copy_layers(part, slots)
+                host = torch.empty((part.size(0), n, *part.shape[2:]), dtype=part.dtype, device="cpu")
+                for layer_out, layer in zip(host.unbind(), part.unbind(), strict=True):
+                    for row, owner in enumerate(host_slots):
+                        layer_out[row].copy_(layer[owner])
+                return host
+            initial=[host_working(part) for part in live]
+            kv=self.runner.token_to_kv_pool
+            pairs=[x for layer in sorted(kv.full_attention_layer_id_mapping) for x in kv.get_kv_buffer(layer)]
+            indices=torch.stack((torch.zeros_like(batch.seq_lens),batch.seq_lens//2,batch.seq_lens-1),dim=1).clamp_min(0).long()
+            prefix_ids=table.req_to_token[batch.req_pool_indices.long()[:,None],indices].flatten().long()
+            old_prefix=[x.index_select(0,prefix_ids).cpu() for x in pairs]
+        deferred_upload = [] if isinstance(entry.graph, PLEGraphs) else None
+        if rank_vote is not None:
+            fused_copy = self.stage(
+                entry, batch, lens, ple_transfer, direct_pages=direct_pages, rank_vote=rank_vote,
+                deferred_upload=deferred_upload,
+            )
+            if fused_copy is None:
+                return None
+        elif direct_pages:
+            fused_copy = self.stage(entry, batch, lens, ple_transfer, direct_pages=True)
+        else:
+            fused_copy = self.stage(entry, batch, lens, ple_transfer) if ple_transfer is not None else self.stage(entry,batch,lens)
+        if entry.graph is None:
+            self.capture(entry)
+            # Eager capture warm-up has already consumed the rank-local PLE
+            # staging buffers in an in-place TP sum. Restore the raw shards.
+            self.stage(entry,batch,lens)
+        with torch.inference_mode():
+            if deferred_upload:
+                # All ranks agreed on the complete target route before its
+                # first collective. Upload on this same stream orders the
+                # read-only disk rows before the first PLE consumer.
+                upload, = deferred_upload
+                entry.graph.prefix.replay()
+                upload()
+                entry.graph.rest.replay()
+            else:
+                entry.graph.replay()
+            selection = getattr(batch, "flashnext_greedy", (None, None))
+            owned = winner = None
+            if getattr(batch, "flashnext_owner", False) and entry.head.owner_graph is not None:
+                owned = entry.head.replay_owner(check)
+            else:
+                winner = entry.head.replay(selection[0], check, selection[1])
+        if borrow_output and not check:
+            # The synchronous K7 caller consumes both tensors on this stream
+            # before the next target graph can overwrite the shared output.
+            result = replace(entry.output)
+            result.flashnext_gdn_factors = entry.factor_output
+            if winner is not None:
+                result.next_token_logits = None
+                result.flashnext_greedy_ids = winner
+            elif owned is not None:
+                result.next_token_logits = owned
+                result.flashnext_owner = True
+                result.flashnext_owner_reference = entry.head.owner_reference
+            return result
+        result=LogitsProcessorOutput(next_token_logits=entry.output.next_token_logits.clone(),
+                                     hidden_states=entry.output.hidden_states.clone())
+        if check:
+            unchanged=all(torch.equal(host_working(part),seed) for part,seed in zip(live,initial,strict=True))
+            prefix_equal=all(torch.equal(x.index_select(0,prefix_ids).cpu(),old) for x,old in zip(pairs,old_prefix,strict=True))
+            if not prefix_equal:
+                for x,old in zip(pairs,old_prefix,strict=True):
+                    x.index_copy_(0,prefix_ids,old.to(x.device))
+            if not unchanged:
+                for part,seed in zip(live,initial,strict=True):
+                    part.index_copy_(1,slots,seed.to(part.device))
+            states = [m.intermediate_conv_window[0], table.short_conv_pool.intermediate_conv_state,
+                      table.ngram_pool.intermediate_context.unsqueeze(0)]
+            compact_reference = None
+            if entry.factor_output:
+                from sglang.srt.speculative.gdn_admission import save_records, compare_all
+
+                compact_reference = save_records(m.intermediate_ssm, n)
+            else:
+                states.insert(0, m.intermediate_ssm)
+            writes=batch.out_cache_loc.long()
+            def shadow():
+                copies = []
+                for state in states:
+                    span = state[:, :n, :WIDTH]
+                    if bulk:
+                        copies.append(copy_layers(span))
+                        continue
+                    host = torch.empty(span.shape, dtype=span.dtype, device="cpu")
+                    for dest, src in zip(host.unbind(), span.unbind(), strict=True):
+                        dest.copy_(src)
+                    copies.append(host)
+                copies.extend(x.index_select(0, writes).cpu() for x in pairs)
+                return copies
+            packed=shadow()
+            self.backend.init_forward_metadata(batch)
+            if V6_TARGET:
+                self.stage(entry, batch, lens)
+                with self.execution(entry) as fb:
+                    expected = self.runner.model.forward(fb.input_ids, fb.positions, fb)
+            else:
+                with bind(TargetGraphs, "run", lambda g, f, kw: g._eager(f, kw)):
+                    expected = serial(worker, batch, lens)
+            exact_ssm = (compact_reference is None or
+                         compare_all(m.temporal, compact_reference, slots, m.intermediate_ssm))
+            del compact_reference
+            checks=(torch.equal(result.next_token_logits,expected.next_token_logits),
+                    torch.equal(result.hidden_states,expected.hidden_states),
+                    exact_ssm and all(torch.equal(a,b) for a,b in zip(packed,shadow(),strict=True)))
+            finite = True

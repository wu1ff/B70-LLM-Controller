+@triton.jit
+def _recovery_k7(terminal, support, q_rows, accepted, VOCAB: tl.constexpr):
+    row = tl.program_id(0)
+    count = tl.load(accepted + row)
+    if count < 0:
+        tl.store(terminal + row * VOCAB, float("nan"))
+    elif count < 7:
+        cols = (row * 7 + count) * 16 + tl.arange(0, 16)
+        ids = tl.load(support + cols)
+        q = tl.load(q_rows + cols)
+        dest = terminal + row * VOCAB + ids
+        tl.store(dest, tl.maximum(tl.load(dest) - q, 0.))

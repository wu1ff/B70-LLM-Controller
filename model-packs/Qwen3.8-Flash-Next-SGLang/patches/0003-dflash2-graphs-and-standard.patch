+from sglang.srt.speculative.v6_gdn import SpeculativeGDN
+from sglang.srt.utils.device import async_h2d
+
+
+WIDTH = 8
+
+
+@dataclass(frozen=True)
+class MixedLayout:
+    verify_rows: tuple[int, ...]
+    verify_requests: torch.Tensor
+    normal_requests: torch.Tensor
+    verify_tokens: torch.Tensor
+    score_tokens: torch.Tensor
+    gdn: SpeculativeGDN
+
+
+def select_rows(batch):
+    if (not flashnext_verify._can_prune(batch) or batch.return_hidden_states
+            or batch.sampling_info.has_watermark_candidates or batch.is_prefill_only
+            or any(x is not None for x in (batch.multimodal_inputs or ()))
+            or batch.extend_num_tokens <= 128 or batch.seq_lens_cpu is None
+            or get_parallel().pp_size != 1 or get_parallel().attn_dp_enabled):
+        return ()
+    tails = batch.decoding_reqs
+    if len(tails) * (WIDTH - 1) > batch.flashnext_mixed_budget:
+        return ()
+    first = len(batch.reqs) - len(tails)
+    grid = mamba_track_grid(batch.tree_cache.page_size)
+    for i, req in enumerate(tails, start=first):
+        prefix = batch.prefix_lens[i]
+        params = req.sampling_params
+        if (prefix // grid != (prefix + WIDTH) // grid
+                or prefix + WIDTH > batch.model_config.context_len
+                or prefix + WIDTH > req.kv.kv_allocated_len
+                or params.stop_strs or params.stop_regex_strs):
+            return ()
+    return tuple(range(first, len(batch.reqs)))
+
+
+def try_mixed_k7(worker, batch):
+    runner = worker.target_worker.model_runner
+    if (worker._v6_calibration is None or worker.block_size != WIDTH
+            or worker.draft_kv_ring is not None or runner.runner_ids.is_translating
+            or worker._verify_planner is not None or not worker._need_mamba_verify_commit
+            or runner.forward_observer is not None or runner.sampling_observer is not None):
+        return None
+    rows = select_rows(batch)
+    if not rows:
+        return None
+
+    device = batch.input_ids.device
+    host_prefix = [batch.prefix_lens[i] for i in rows]
+    index = async_h2d(rows, dtype=torch.int64, device=device)
+    normal_rows = [i for i in range(len(batch.reqs)) if i not in rows]
+    normal = async_h2d(normal_rows, dtype=torch.int64, device=device)
+
+    tails = replace(
+        batch, reqs=[batch.reqs[i] for i in rows], req_pool_indices=batch.req_pool_indices[index],
+        seq_lens=batch.seq_lens[index] - 1, seq_lens_cpu=torch.tensor(host_prefix),
+    )
+    tails.sampling_info = SamplingBatchInfo.from_schedule_batch(
+        tails, batch.model_config.vocab_size,
+    ).copy_for_forward()
+    old_offsets = list(accumulate(batch.extend_lens, initial=0))
+    anchors = batch.input_ids[async_h2d([old_offsets[i] for i in rows], dtype=torch.int64, device=device)]
+    draft_input = worker._make_next_draft_input_decode(
+        bonus_tokens=anchors, new_seq_lens=tails.seq_lens,
+    )
+    (_, _, proposals, prefix_lens, _, positions, _, draft_locs, draft_locs_2d,
+     draft_iteration, draft_plan, pages, query_writes, _) = worker._prepare_draft_block(
+        tails, draft_input, synchronous=True,
+    )
+    extended = [WIDTH if i in rows else n for i, n in enumerate(batch.extend_lens)]
+    offsets = list(accumulate(extended, initial=0))
+    verify_tokens = async_h2d(
+        [j for i in rows for j in range(offsets[i], offsets[i + 1])],
+        dtype=torch.int64, device=device,
+    ).view(len(rows), WIDTH)
+    score_tokens = async_h2d(
+        [offsets[i + 1] - 1 for i in normal_rows], dtype=torch.int64, device=device,
+    )
+    score_tokens = torch.cat((score_tokens, verify_tokens.flatten()))
+    linear = runner.attn_backend.linear_attn_backend
+    owners = linear._translate_mamba_indices(runner.req_to_token_pool.get_mamba_indices(tails.req_pool_indices))
+    spec_offsets = async_h2d(
+        list(range(0, (len(rows) + 1) * WIDTH, WIDTH)), dtype=torch.int32, device=device,
+    )
+    mixed = MixedLayout(rows, index, normal, verify_tokens, score_tokens,
+                        SpeculativeGDN(len(rows), spec_offsets, owners))
+    locs = []
+    tokens = []
+    row_to_verify = dict(zip(rows, range(len(rows)), strict=True))
+    for i, (start, end) in enumerate(zip(old_offsets[:-1], old_offsets[1:], strict=True)):
+        lane = row_to_verify.get(i)
+        if lane is None:
+            locs.append(batch.out_cache_loc[start:end])
+            tokens.append(batch.input_ids[start:end])
+        else:
+            locs.append(draft_locs_2d[lane])
+            tokens.append(proposals[lane])
+    seq_lens = batch.seq_lens.index_add(0, index, torch.full_like(prefix_lens, WIDTH - 1))
+    host_seq_lens = batch.seq_lens_cpu.clone()
+    host_seq_lens[list(rows)] += WIDTH - 1
+    extended_batch = replace(
+        batch, input_ids=torch.cat(tokens), out_cache_loc=torch.cat(locs),
+        extend_lens=extended, extend_num_tokens=offsets[-1],
+        seq_lens=seq_lens, seq_lens_cpu=host_seq_lens, seq_lens_sum=int(host_seq_lens.sum()),
+    )
+    worker.target_worker.set_hicache_consumer(batch.hicache_consumer_index)
+    forward = ForwardBatch.init_new(
+        extended_batch, runner, capture_hidden_mode=CaptureHiddenMode.FULL,
+        return_hidden_states_before_norm=False,
+    )
+    forward.flashnext_mixed = mixed
+    with b70_checkpoints.collect(batch) as checkpoints:
+        result = worker.target_worker.forward_batch_generation(
+            batch=None, forward_batch=forward, is_verify=True, return_iteration_ids=True,
+        )
+
+    target = result.logits_output
+    normal_count = len(normal_rows)
+    normal_batch = replace(batch, reqs=[batch.reqs[i] for i in normal_rows])
+    normal_info = SamplingBatchInfo.from_schedule_batch(
+        normal_batch, batch.model_config.vocab_size,
+    ).copy_for_forward()
+    ordinary = LogitsProcessorOutput(next_token_logits=target.next_token_logits[:normal_count])
+    flashnext_dflash2.mask_reasoning_eos(ordinary.next_token_logits, normal_batch.reqs)
+    ordinary_tokens = runner.sample(
+        ordinary,
+        replace(forward, sampling_info=normal_info, seq_lens=batch.seq_lens[normal],
+                req_pool_indices=batch.req_pool_indices[normal]),
+    )
+    worker._tp_sync.sync(SpecTpSyncSite.DFLASH_TARGET, ordinary_tokens)
+    ordinary_tokens = ordinary_tokens.long()
+
+    verify_logits = target.next_token_logits[normal_count:]
+    flashnext_dflash2.mask_reasoning_eos(verify_logits, tails.reqs, proposals)
+    evaluation = flashnext_verify.StandardWindow(
+        tails, worker._selector_sample, prefix_lens, WIDTH, host_positions=host_prefix,
+    )
+    evaluation.complete = False
+    _, commits, bonus, outputs, _, _ = worker._accept_block(
+        candidates=proposals, next_token_logits=verify_logits, sampling_info=tails.sampling_info,
+        draft_input=draft_input, prefix_lens=prefix_lens, bs=len(rows), evaluation=evaluation,
+    )
+    limited = finish_commit(tails.reqs, outputs, commits, prefix_lens, flashnext_dflash2._stop_token_ids)
+    if limited is None:
+        commits = flashnext_dflash2.limit_commits(tails.reqs, outputs, commits)
+        bonus = outputs.gather(1, (commits.long() - 1)[:, None]).flatten().long()
+        next_prefix = prefix_lens + commits.to(prefix_lens.dtype)
+    else:
+        commits, bonus, next_prefix = limited
+
+    runner.attn_backend.update_mamba_state_after_mtp_verify(
+        last_correct_step_indices=commits.long() - 1, mamba_track_indices=None,
+        mamba_steps_to_track=None, model=runner.model, req_pool_indices=tails.req_pool_indices,
+        state_slots=ForwardStateSlots(owners),
+    )
+
+    hidden = target.hidden_states
+    all_locs = worker._draft_write_ids(result.iteration_ids)
+    ordinary_rows = async_h2d(
+        [j for i in normal_rows for j in range(offsets[i], offsets[i + 1])],
+        dtype=torch.int64, device=device,
+    )
+    worker._append_target_hidden_to_draft_kv_by_loc(
+        target_hidden=hidden[ordinary_rows], cache_loc=all_locs[ordinary_rows],
+        positions=forward.positions[ordinary_rows],
+        extend_lens=async_h2d([extended[i] for i in normal_rows], dtype=torch.int32, device=device),
+    )
+    write_locs = worker._draft_write_ids(draft_iteration)
+    physical = pages.reuse_query_writes(query_writes[0], draft_plan, write_locs) if query_writes else None
+    worker._append_target_hidden_decode(
+        physical_cache_loc=physical, target_hidden=hidden[verify_tokens.flatten()],
+        cache_loc=write_locs, cache_loc_2d=write_locs.view_as(draft_locs_2d),
+        positions=positions, commit_lens=commits,
+    )
+    b70_checkpoints.publish(batch, checkpoints)
+
+    committed_lens = batch.seq_lens.index_copy(0, index, next_prefix.to(batch.seq_lens.dtype))
+    committed_bonus = ordinary_tokens.new_empty(len(batch.reqs))
+    committed_bonus[normal] = ordinary_tokens
+    committed_bonus[index] = bonus
+    emitted = ordinary_tokens.new_zeros((len(batch.reqs), WIDTH))
+    emitted[normal, 0] = ordinary_tokens
+    emitted[index] = outputs
+    commit_counts = commits.new_ones(len(batch.reqs))
+    commit_counts[index] = commits
+    target.hidden_states = target.next_token_logits = None
+    result.iteration_ids = None
+    result.next_token_ids = emitted.flatten()
+    result.accept_lens = commit_counts
+    result.mixed_verify_rows = rows
+    result.new_seq_lens = committed_lens
+    result.next_draft_input = worker._make_next_draft_input_prefill(
+        bonus_tokens=committed_bonus, seq_lens=committed_lens,
+    )
+    return result
